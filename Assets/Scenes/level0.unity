    - MsgT:
      - "\u5629\uFF0C\u9019\u88E1\u7684\u666F\u8C61\n\u53C8\u8207\u4E4B\u524D\u7684\u5927\u5927\u4E0D\u540C\uFF01"
      - "\u4E0D\u6127\u662F\u5730\u754C\u5E7D\u90FD\uFF0C\u4E0D\u8AD6\n\u98A8\u571F\u666F\u8272\u90FD\u8207\u5730\u4E0A\u5927\u7570\u5176\u8DA3\uFF0C\n\u4FFA\u62DC\u8840\u9396\u934A\u4E4B\u8CDC\u6D3B\u4E86\u9019\u9EBC\u591A\u5E74\uFF0C\n\u9084\u662F\u7B2C\u4E00\u6B21\u898B\u5230\n\u5982\u6B64\u4E0D\u53EF\u601D\u8B70\u7684\u5149\u666F\u3002"
      - "\u8CA7\u50E7\u4E5F\u6709\u540C\u611F\u3002\n\u4FEE\u7F85\u9B3C\u754C\u679C\u7136\u662F\u771F\u6709\u5176\u4E8B\uFF0C\n\u7136\u800C\u5982\u4ECA\u89AA\u773C\u76EE\u7779\uFF0C\n\u537B\u53C8\u89BA\u5F97\u5982\u771F\u4F3C\u5E7B\uFF0C\u5F77\u5F7F\u662F\n\u81EA\u5DF1\u662F\u5728\u4F5C\u4E00\u5834\u5927\u5922\u4E00\u822C\u3002"
      - "\u51A5\u5E7D\u7384\u5E7B\uFF0C\u5730\u754C\u56DB\u6D77\u3002\n\u9019\u539F\u975E\u751F\u4EBA\u6240\u61C9\u898B\u7684\u666F\u8C61\uFF0C\n\u54B1\u5011\u9760\u8457\u6DF7\u5143\u5BF6\u5854\u5F37\u95D6\uFF0C\n\u6B64\u8209\u96D6\u662F\u5927\u9055\u5929\u9053\u8AF8\u7406\uFF0C\n\u4F46\u4E5F\u662F\u51FA\u65BC\u4E0D\u5F97\u5DF2\u3002"
      - "\u96D6\u662F\u5982\u6B64\uFF0C\n\u54B1\u5011\u4E5F\u662F\u70BA\u4E86\u963B\u6B62\u528D\u90AA\uFF0C\n\u70BA\u5929\u4E0B\u84BC\u751F\u6027\u547D\u624D\u8D74\u5730\u754C\uFF0C\n\u54B1\u5011\u5E2B\u51FA\u6709\u540D\uFF0C\n\u5C31\u7B97\u8AF8\u795E\u773E\u4ED9\u8AAA\u54B1\u5011\u4E0D\u662F\uFF0C\n\u4E5F\u7BA1\u4E0D\u4E86\u90A3\u8A31\u591A\u4E86\u3002\n\u4E0D\u904E\u6211\u8AAA\u7D2B\u6953\u5927\u59D0\uFF0C\n\u9019\u88E1\u5168\u662F\u5CED\u58C1\u65B7\u5D16\uFF0C\n\u96D6\u7136\u770B\u4F86\u58EF\u89C0\u96C4\u5049\uFF0C\n\u4F46\u54B1\u5011\u4E00\u8DEF\u4F86\u6B64\uFF0C\n\u7E3D\u4E0D\u662F\u4F86\u8CDE\u666F\u7A31\u5947\u7684\u5427\uFF1F"
      - "\u81EA\u7136\u4E0D\u662F\u3002\u5404\u4F4D\u53EF\u6709\u770B\u5230\n\u9060\u65B9\u90A3\u77F3\u9663\u8207\u767C\u5149\u7684\u6676\u76E4\uFF1F"
      - "\u898B\u5230\u4E86\u3002\u90A3\u77F3\u9663\u7684\u6392\u5217\u4F3C\u8207\n\u5C01\u6709\u86A9\u5C24\u53F3\u89D2\u7684\u8352\u77F3\u585A\u985E\u4F3C\uFF0C\n\u4F46\u4E0D\u77E5\u90A3\u6C34\u6676\u660E\u93E1\u662F\uFF1F"
      - "\u90A3\u662F\u524D\u5F80\u5730\u754C\u6838\u5FC3\u300E\u7384\u6D77\u300F\n\u7684\u5929\u93E1\u6CD5\u9663\uFF0C\n\u5728\u90A3\u88E1\u65BD\u7528\u79FB\u9041\u4E4B\u6CD5\uFF0C\n\u4FBF\u53EF\u628A\u7AD9\u5728\u5929\u93E1\u4E0A\u7684\u5927\u5925\n\u90FD\u9001\u5230\u5E7B\u6D77\u7684\u4E09\u8352\u51A5\u539F\uFF0C\n\u6839\u64DA\u53E4\u7C4D\u7684\u8A18\u8F09\uFF0C\u8D64\u7149\u6DF5\n\u5C31\u4F4D\u5728\u4E09\u8352\u51A5\u539F\u7684\u67D0\u8655\u3002"
      - "\u554A\uFF01\u6211\u4E5F\u807D\u904E\u4E09\u8352\u4E4B\u539F\uFF0C\n\u807D\u8AAA\u90A3\u88E1\u51B0\u706B\u5171\u6FDF\uFF0C\n\u4E16\u4E0A\u81F3\u71B1\u8207\u81F3\u5BD2\u7684\u7570\u6240\u5947\u666F\u3002\n\u83AB\u975E\u795E\u528D\u5C31\u85CF\u5728\u90A3\u88E1\uFF1F"
      - "\u6B63\u662F\u3002\u4E0D\u904E\u9019\u5929\u93E1\u6CD5\u9663\n\u4EA6\u80FD\u805A\u6582\u9748\u6C23\uFF0C\n\u5411\u4F86\u662F\u7FA4\u5996\u6240\u597D\u4E4B\u8655\uFF0C\n\u54B1\u5011\u8981\u4F7F\u7528\u6CD5\u9663\uFF0C\n\u5F97\u5148\u6253\u767C\u4E86\n\u76E4\u64DA\u65BC\u6B64\u7684\u773E\u591A\u5996\u9B54\u624D\u884C\u3002"
      - "\u7E3D\u800C\u8A00\u4E4B\uFF0C\n\u53C8\u5F97\u6D3B\u52D5\u6D3B\u52D5\u7B4B\u9AA8\u4E86\u3002\n\u5225\u7684\u5012\u9084\u4E0D\u6613\uFF0C\u6253\u67B6\u6700\u662F\u7C21\u55AE\uFF0C\n\u54B1\u5011\u9019\u5C31\u4E0A\u5427\uFF01"
      - "\u55EF\uFF01"
      MsgS:
      - "\u54D7\uFF0C\u8FD9\u91CC\u7684\u666F\u8C61\n\u53C8\u4E0E\u4E4B\u524D\u7684\u5927\u5927\u4E0D\u540C\uFF01"
      - "\u4E0D\u6127\u662F\u5730\u754C\u5E7D\u90FD\uFF0C\u4E0D\u8BBA\n\u98CE\u571F\u666F\u8272\u90FD\u4E0E\u5730\u4E0A\u5927\u5F02\u5176\u8DA3\uFF0C\n\u4FFA\u62DC\u8840\u9501\u94FE\u4E4B\u8D50\u6D3B\u4E86\u8FD9\u9EBD\u591A\u5E74\uFF0C\n\u8FD8\u662F\u7B2C\u4E00\u6B21\u89C1\u5230\n\u5982\u6B64\u4E0D\u53EF\u601D\u8BAE\u7684\u5149\u666F\u3002"
      - "\u8D2B\u50E7\u4E5F\u6709\u540C\u611F\u3002\n\u4FEE\u7F57\u9B3C\u754C\u679C\u7136\u662F\u771F\u6709\u5176\u4E8B\uFF0C\n\u7136\u800C\u5982\u4ECA\u4EB2\u773C\u76EE\u7779\uFF0C\n\u5374\u53C8\u89C9\u5F97\u5982\u771F\u4F3C\u5E7B\uFF0C\u5F77\u4F5B\u662F\n\u81EA\u5DF1\u662F\u5728\u4F5C\u4E00\u573A\u5927\u68A6\u4E00\u822C\u3002"
      - "\u51A5\u5E7D\u7384\u5E7B\uFF0C\u5730\u754C\u56DB\u6D77\u3002\n\u8FD9\u539F\u975E\u751F\u4EBA\u6240\u5E94\u89C1\u7684\u666F\u8C61\uFF0C\n\u54B1\u4EEC\u9760\u7740\u6DF7\u5143\u5B9D\u5854\u5F3A\u95EF\uFF0C\n\u6B64\u4E3E\u867D\u662F\u5927\u8FDD\u5929\u9053\u8BF8\u7406\uFF0C\n\u4F46\u4E5F\u662F\u51FA\u65BC\u4E0D\u5F97\u5DF2\u3002"
      - "\u867D\u662F\u5982\u6B64\uFF0C\n\u54B1\u4EEC\u4E5F\u662F\u4E3A\u4E86\u963B\u6B62\u5251\u90AA\uFF0C\n\u4E3A\u5929\u4E0B\u82CD\u751F\u6027\u547D\u624D\u8D74\u5730\u754C\uFF0C\n\u54B1\u4EEC\u5E08\u51FA\u6709\u540D\uFF0C\n\u5C31\u7B97\u8BF8\u795E\u4F17\u4ED9\u8BF4\u54B1\u4EEC\u4E0D\u662F\uFF0C\n\u4E5F\u7BA1\u4E0D\u4E86\u90A3\u8BB8\u591A\u4E86\u3002\n\u4E0D\u8FC7\u6211\u8BF4\u7D2B\u67AB\u5927\u59D0\uFF0C\n\u8FD9\u91CC\u5168\u662F\u5CED\u58C1\u65AD\u5D16\uFF0C\n\u867D\u7136\u770B\u6765\u58EE\u89C2\u96C4\u4F1F\uFF0C\n\u4F46\u54B1\u4EEC\u4E00\u8DEF\u6765\u6B64\uFF0C\n\u603B\u4E0D\u662F\u6765\u8D4F\u666F\u79F0\u5947\u7684\u5427\uFF1F"
      - "\u81EA\u7136\u4E0D\u662F\u3002\u5404\u4F4D\u53EF\u6709\u770B\u5230\n\u8FDC\u65B9\u90A3\u77F3\u9635\u4E0E\u53D1\u5149\u7684\u6676\u76D8\uFF1F"
      - "\u89C1\u5230\u4E86\u3002\u90A3\u77F3\u9635\u7684\u6392\u5217\u4F3C\u4E0E\n\u5C01\u6709\u86A9\u5C24\u53F3\u89D2\u7684\u8352\u77F3\u585A\u7C7B\u4F3C\uFF0C\n\u4F46\u4E0D\u77E5\u90A3\u6C34\u6676\u660E\u955C\u662F\uFF1F"
      - "\u90A3\u662F\u524D\u5F80\u5730\u754C\u6838\u5FC3\u300E\u7384\u6D77\u300F\n\u7684\u5929\u955C\u6CD5\u9635\uFF0C\n\u5728\u90A3\u91CC\u65BD\u7528\u79FB\u9041\u4E4B\u6CD5\uFF0C\n\u4FBF\u53EF\u628A\u7AD9\u5728\u5929\u955C\u4E0A\u7684\u5927\u5925\n\u90FD\u9001\u5230\u5E7B\u6D77\u7684\u4E09\u8352\u51A5\u539F\uFF0C\n\u6839\u636E\u53E4\u7C4D\u7684\u8BB0\u8F7D\uFF0C\u8D64\u70BC\u6E0A\n\u5C31\u4F4D\u5728\u4E09\u8352\u51A5\u539F\u7684\u67D0\u5904\u3002"
      - "\u554A\uFF01\u6211\u4E5F\u542C\u8FC7\u4E09\u8352\u4E4B\u539F\uFF0C\n\u542C\u8BF4\u90A3\u91CC\u51B0\u706B\u5171\u6D4E\uFF0C\n\u4E16\u4E0A\u81F3\u70ED\u4E0E\u81F3\u5BD2\u7684\u5F02\u6240\u5947\u666F\u3002\n\u83AB\u975E\u795E\u5251\u5C31\u85CF\u5728\u90A3\u91CC\uFF1F"
      - "\u6B63\u662F\u3002\u4E0D\u8FC7\u8FD9\u5929\u955C\u6CD5\u9635\n\u4EA6\u80FD\u805A\u655B\u7075\u6C14\uFF0C\n\u5411\u6765\u662F\u7FA4\u5996\u6240\u597D\u4E4B\u5904\uFF0C\n\u54B1\u4EEC\u8981\u4F7F\u7528\u6CD5\u9635\uFF0C\n\u5F97\u5148\u6253\u53D1\u4E86\n\u76D8\u636E\u65BC\u6B64\u7684\u4F17\u591A\u5996\u9B54\u624D\u884C\u3002"
      - "\u603B\u800C\u8A00\u4E4B\uFF0C\n\u53C8\u5F97\u6D3B\u52A8\u6D3B\u52A8\u7B4B\u9AA8\u4E86\u3002\n\u522B\u7684\u5012\u8FD8\u4E0D\u6613\uFF0C\u6253\u67B6\u6700\u662F\u7B80\u5355\uFF0C\n\u54B1\u4EEC\u8FD9\u5C31\u4E0A\u5427\uFF01"
      - "\u55EF\uFF01"
    - MsgT:
      - "\u5927\u5925\u90FD\u7AD9\u5B9A\u4E86\u9EBC\uFF1F\n\u6211\u9019\u5C31\u958B\u59CB\u65BD\u300C\u79FB\u9041\u4E4B\u6CD5\u300D\u3002\n\u4ED9\u9053\u5FA1\u6CD5\u795E\u79FB\u5929\u76F8\u516B\u65B9\n\u6D41\u8F49\u9B42\u8EC0\u540C\u6607\u5149\u821E\u9A30\u632A...."
      MsgS:
      - "\u5927\u5925\u90FD\u7AD9\u5B9A\u4E86\u9EBD\uFF1F\n\u6211\u8FD9\u5C31\u5F00\u59CB\u65BD\u300C\u79FB\u9041\u4E4B\u6CD5\u300D\u3002\n\u4ED9\u9053\u5FA1\u6CD5\u795E\u79FB\u5929\u76F8\u516B\u65B9\n\u6D41\u8F6C\u9B42\u8EAF\u540C\u6607\u5149\u821E\u817E\u632A...."

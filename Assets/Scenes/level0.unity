    EMSG:
    - MsgT:
      - "\u56DB\u8C61\u9580\u679C\u7136\u540D\u4E0D\u865B\u50B3\uFF0C\n\u4ECA\u5929\u5728\u4E0B\u9818\u6559\u4E86........."
      MsgS:
      - "\u56DB\u8C61\u95E8\u679C\u7136\u540D\u4E0D\u865A\u4F20\uFF0C\n\u4ECA\u5929\u5728\u4E0B\u9886\u6559\u4E86........."
    - MsgT:
      - "\u547C\uFF0C\u5C01\u59D1\u5A18\uFF0C\u80FD\u4E0D\u80FD....\n\u4E0D\u8981\u8D70\u9019\u9EBC\u6025\uFF1F"
      - "\u54FC\uFF0C\u6211\u53C8\u6C92\u8AAA\u4E00\u5B9A\u8981\u4F60\u8DDF\u4F86\u3002\n\u5982\u679C\u4F60\u4E0D\u559C\u6B61\u9019\u6A23\u8D95\u8DEF\u7684\u8A71\uFF0C\n\u9019\u5C31\u6389\u982D\u56DE\u53BB\u597D\u5566\uFF0C\n\u53CD\u6B63\u6211\u7684\u6B7B\u6D3B\u53C8\u8207\u4F60\u7121\u95DC\u3002"
      - "\u5509\uFF0C\u5728\u4E0B\u53EF\u6C92\u9019\u500B\u610F\u601D\u554A\u3002\n\u518D\u8AAA\u59D1\u5A18\u59B3\u4E00\u500B\u4EBA\u5728\u9019\u8352\u5C71\u91CE\u5730\uFF0C\n\u8981\u662F\u53C8\u9047\u4E0A\u4E86\u59B3\u5E2B\u5144\u6D3E\u4F86\u7684\u4EBA\u624B\uFF0C\n\u90A3\u4FBF\u5371\u96AA\u5DF2\u6975\u3002\n\u53CD\u6B63\u5728\u4E0B\u9592\u4F86\u7121\u4E8B\uFF0C\n\u59D1\u5A18\u8981\u4E0A\u54EA\u53BB\uFF0C\n\u5C31\u7531\u5728\u4E0B\u8B77\u9001\u59B3\u53BB\u597D\u4E86\u3002"
      - "\u563B\u563B\uFF0C\u4F60\u9019\u4EBA\u500B\u6027\u597D\u5F97\u5F88\u554A\uFF0C\n\u4E00\u9EDE\u90FD\u4E0D\u50CF\u662F\u6703\u88AB\u9010\u51FA\u5E2B\u9580\u4E4B\u4EBA\u3002\n\u4F60\u771F\u662F\u5929\u7384\u9580\u5F1F\u5B50\u9EBC\uFF1F"
      - "\u5728\u4E0B\u5DF2\u88AB\u9010\u51FA\u9580\u7246\uFF0C\n\u518D\u4E0D\u80FD\u4EE5\u5929\u7384\u9580\u5F1F\u5B50\u81EA\u5C45\u3002\n\u5C0D\u4E86\uFF0C\n\u59D1\u5A18\u59B3\u53EF\u662F..\u300E\u56DB\u8C61\u9580\u300F\u4E2D\u4EBA\uFF1F"
      - "\u6B63\u662F\u3002\n\u807D\u8AAA\u4F60\u5011\u81EA\u5C45\u540D\u9580\u6B63\u6D3E\u7684\n\u90FD\u4EE5\u70BA\u6211\u5011\u56DB\u8C61\u9580\u662F\u90AA\u9B54\u5916\u9053\uFF0C\n\u4F60\u4E5F\u807D\u904E\u6211\u5011\u7684\u540D\u982D\u9EBC\uFF1F"
      - "\u4E0D\uFF0C\n\u53EA\u662F\u8CB4\u6D3E\u9580\u898F\u5100\u6CD5\u8207\u4ED6\u6D3E\u5927\u7570\uFF0C\n\u4E14\u4E0D\u5FCC\u53EC\u9B3C\u9B54\u9053\uFF0C\n\u9019\u7A2E\u4E8B\u5728\u4E0B\u591A\u5C11\u4E5F\u807D\u904E\u4E00\u4E9B...."
      - "\u4EE5\u51E1\u4EBA\u4E4B\u8EAB\u7DF4\u5492\u4FEE\u6CD5\uFF0C\n\u672C\u5C31\u662F\u9055\u80CC\u5929\u7406\u4E4B\u4E8B\uFF0C\n\u90A3\u9867\u5F97\u4EC0\u9EBC\u6B63\u4E0D\u6B63\u6D3E\u4E86\uFF1F\n\u60F3\u4F86\u5404\u6D3E\u56E0\u70BA\u81EA\u5DF1\u5B88\u820A\u4E0D\u5316\uFF0C\n\u81F4\u8853\u6CD5\u9020\u8A63\u8207\u6211\u56DB\u8C61\u9580\u5929\u5DEE\u5730\u9060\uFF0C\n\u6240\u4EE5\u624D\u5982\u6B64\u60E1\u8A00\u4E2D\u50B7\u3002"
      - "\u59D1\u5A18\u6B64\u8A00\u5DEE\u77E3...."
      - "\u7F77\u5566\uFF0C\u4E0D\u8DDF\u4F60\u8FAF\u9019\u500B\u3002\n\u8A71\u8AAA\u56DE\u4F86\uFF0C\n\u6211\u8AAA\u904E\u8981\u4F60\u5E6B\u7684\u5FD9\uFF0C\n\u5176\u5BE6\u662F\u5E6B\u6211\u4FDD\u7BA1\u9019\u500B\u3002"
      - "\u9019\u500B\u7D2B\u8272\u5E03\u5305\uFF1F\n....\u597D\u91CD\uFF0C\n\u88E1\u9762\u662F\u4EC0\u9EBC\u6771\u897F\uFF1F"
      - "\u4F60\u6253\u958B\u4F86\u770B\u770B\u3002"
      - "....\u662F\u500B\u7D2B\u9285\u8272\u7684\u5C0F\u9F0E\u3002\n\u6055\u5728\u4E0B\u898B\u8B58\u6DFA\u8584\uFF0C\n\u770B\u4E0D\u51FA\u9019\u5C0F\u9F0E\u6709\u4F55\u795E\u7570\u4E4B\u8655\u3002"
      - "\u563B\u563B\uFF0C\u9019\u4E00\u6642\u662F\u770B\u4E0D\u51FA\u4F86\u7684\uFF0C\n\u8B93\u6211\u544A\u8A34\u4F60\u7F77\u3002\n\u9019\u7D2B\u91D1\u738B\u9F0E\u50B3\u8AAA\u4E43\u662F\u5973\u5AA7\u795E\n\u88DC\u5929\u4E4B\u6642\u5269\u4E0B\u7684\u4E03\u8272\u77F3\u5B50\uFF0C\n\u548C\u4E0D\u5468\u5C71\u706B\u7430\u6D1E\n\u6240\u7522\u7684\u7D2B\u91D1\u6DF7\u7149\u800C\u6210\uFF0C\n\u914D\u4E0A\u6211\u6D3E\u7368\u9580\u300E\u516B\u860A\u5316\u5929\u9663\u300F\uFF0C\n\u4FBF\u53EF\u7149\u5316\u5929\u4E0B\u842C\u7269...."
      - "....\u4F4F\u53E3\uFF01"
      - "\u5E2B\u59B9\uFF0C\n\u59B3\u7ADF\u6562\u6D29\u6F0F\u672C\u9580\u6A5F\u5BC6\uFF0C\n\u8A72\u7576\u4F55\u7F6A\uFF1F"
      - "\u5927\u5E2B\u5144\uFF0C\n\u9B3C\u9B3C\u795F\u795F\u7684\u8EB2\u8D77\u4F86\u807D\u5225\u4EBA\u8AAA\u8A71\n\u53EF\u4E0D\u662F\u6211\u56DB\u8C61\u9580\u7684\u7D55\u5B78\uFF0C\n\u5225\u5728\u90A3\u88E1\u6559\u5916\u4EBA\u7B11\u8A71\u4E86\u3002"
      - "\u5C11\u548C\u6211\u800D\u5634\u76AE\u5B50\u3002\n\u6C92\u60F3\u5230\u59B3\u4E0D\u6B62\u5C07\u672C\u9580\u6A5F\u5BC6\n\u6D29\u6F0F\u8207\u5916\u4EBA\uFF0C\n\u9084\u60F3\u5C07\u672C\u9580\u81F3\u5BF6\u300E\u7D2B\u91D1\u738B\u9F0E\u300F\n\u4EA4\u7D66\u9019\u500B\u5929\u7384\u9580\u7684\u5C0F\u5B50\uFF0C\n\u8981\u662F\u738B\u9F0E\u843D\u5165\u4E2D\u539F\u4E09\u6D3E\u624B\u4E2D\uFF0C\n\u672C\u9580\u5C07\u6703\u5982\u4F55\u59B3\u53EF\u77E5\u9053\uFF1F"
      - "\u5C31\u7B97\u738B\u9F0E\u70BA\u4E09\u6D3E\u6240\u5F97\uFF0C\n\u4E5F\u52DD\u65BC\u843D\u5165\u4F60\u7684\u624B\u88E1\u3002\n\u5982\u679C\u5E2B\u7236\u4EBA\u9084\u6E05\u9192\u7684\u8A71\uFF0C\n\u60F3\u5FC5\u4E5F\u6703\u540C\u610F\u6211\u7684\u898B\u89E3\u3002"
      - "\u59B3\u9019\u53DB\u9580\u7684\u8CE4\u4EBA\uFF0C\n\u5225\u4EE5\u70BA\u5F97\u5E2B\u7236\u5BF5\u611B\n\u5C31\u80FD\u70BA\u6240\u6B32\u70BA\uFF01\n\u6211\u6700\u5F8C\u4E00\u6B21\u554F\u59B3\uFF0C\n\u5230\u5E95\u4EA4\u4E0D\u4EA4\u51FA\u7D2B\u91D1\u738B\u9F0E\uFF1F"
      - "\u7B49\u6211\u6B7B\u4E86\u4E4B\u5F8C\uFF0C\n\u4F60\u81EA\u53EF\u5F9E\u6211\u7684\u5C4D\u8EAB\u4E0A\u627E\u5230\u3002"
      - "\u54FC\uFF0C\u662F\u59B3\u903C\u6211\u52D5\u624B\uFF0C\n\u5225\u602A\u6211\u4E0D\u9867\u5FF5\u540C\u9580\u4E4B\u60C5\uFF01\n\u9023\u90A3\u500B\u5929\u7384\u9580\u7684\u5C0F\u5B50\n\u4E00\u4F75\u7D66\u6211\u62FF\u4E0B\uFF0C\n\u51E1\u662F\u77E5\u9053\u672C\u9580\u79D8\u5BC6\u7684\uFF0C\n\u8AB0\u90FD\u5225\u60F3\u6D3B\u547D\u3002"
      - "\u6BB7\u5C11\u4FE0\uFF0C\n\u628A\u4F60\u4E5F\u6372\u9032\u9019\u5834\u662F\u975E\u4E4B\u4E2D\uFF0C\n\u771F\u662F\u5C0D\u4E0D\u4F4F...."
      - "\u6C92\u9019\u56DE\u4E8B\u3002\n\u6211\u9019\u5929\u7384\u9580\u5F1F\u5B50\u96D6\u4E0D\u6210\u5668\uFF0C\n\u4F46\u4E5F\u4E0D\u662F\u8AAA\u62FF\u5C31\u7D66\u4EBA\u62FF\u4E0B\u7684\uFF0C\n\u53EA\u662F\u9019\u9EBC\u4E00\u4F86\uFF0C\n\u5C31\u4E0D\u514D\u5F97\u7F6A\n\u5C01\u59D1\u5A18\u59B3\u7684\u540C\u9580\u5E2B\u5144\u5F1F...."
      - "\u4ED6\u5011\u70BA\u4E86\u9019\u7D2B\u91D1\u738B\u9F0E\uFF0C\n\u65E9\u4E0D\u628A\u6211\u7576\u540C\u9580\u770B\u5F85\u5566\uFF0C\n\u4F60\u53EF\u4E0D\u8981\u5C0D\u4ED6\u5011\u624B\u4E0B\u7559\u60C5\u3002"
      - "\u90A3\u5728\u4E0B\u5C31\u4E0D\u5BA2\u6C23\u4E86\uFF01"

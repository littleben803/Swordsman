      MsgS:
      - "\u300C\u6211\u66FE\u76EE\u7779\u6709\u4EBA\u4ECE\u6C88\u5BB6\u5E9F\u5C4B\u91CC\u51FA\u6765\uFF0C\u867D\u7136\u90A3\u65F6\u6CA1\u770B\u6E05\u695A\u4ED6\u4EEC\u7684\u957F\u50CF\uFF0C\u4F46\u6211\u60F3\u90A3\u4E9B\u5BB6\u4F19\u5FC5\u5B9A\u548C\u6700\u8FD1\u7684\u602A\u4E8B\u6709\u5173\u3002\u300D"
    - MsgT:
      - "\u300C\u9019\u4E9B\u6C34\u679C\u770B\u4F86\u6EFF\u4E0D\u932F\u7684\uFF0C\u5C31\u591A\u8CB7\u4E00\u4E9B\u597D\u4E86\u3002\u300D"

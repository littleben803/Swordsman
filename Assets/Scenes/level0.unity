      - "\u4E09\u9B44\u9B3C\u773C\uFF01\n\u6211\u7684\u4E09\u9B44\u9B3C\u773C\u7ADF\u7136...."
      - "\u592A\u597D\u4E86\uFF01\u5C01\u59D0\u59D0\uFF01"
      - "\u9019\u67C4\u77ED\u528D\u679C\u7136\u662F\u4EF6\n\u4E0D\u51FA\u4E16\u7684\u795E\u5175\uFF0C\n\u4E0D\u904E\u6BC0\u4E86\u4E09\u9B44\u9B3C\u773C\u4E4B\u5F8C\uFF0C\n\u5B83\u7684\u9748\u6C23\u4E5F\u76E1\u6578\u6D88\u6563\u4E86\u3002\n\u6211\u5011\u5F97\u5230\u9019\u67C4\u795E\u5175\uFF0C\n\u5176\u6642\u4E4B\u5DE7\uFF0C\n\u60F3\u5FC5\u4E5F\u662F\u4E0A\u5929\u7684\u65E8\u610F\u5427\u3002"
      - "\u4EC0\u9EBC\u4E0A\u5929\u7684\u65E8\u610F\uFF01\n\u5C11\u7B11\u6B7B\u4EBA\u4E86\uFF01\n\u5C31\u7B97\u6C92\u6709\u4E09\u9B44\u9B3C\u773C\uFF0C\n\u6211\u4E00\u6A23\u80FD\u6BBA\u76E1\u4F60\u5011\u9019\u4E9B\u4E0B\u773E\uFF01\n\u90FD\u7D66\u6211\u6B7B\u5427\uFF01"
      - "\u597D\u500B\u5996\u5B7D\uFF0C\n\u5982\u4ECA\u59B3\u7684\u8B77\u8EAB\u7981\u5236\u5DF2\u5931\uFF0C\n\u5C45\u7136\u9084\u60F3\u72C2\u8A00\u901E\u5147\uFF01"
      - "\u9019\u5A46\u5A18\u5DF2\u7D93\u7AAE\u9014\u672B\u8DEF\uFF0C\n\u54B1\u5011\u4F55\u5FC5\u548C\u5979\u56C9\u5506\uFF0C\n\u75DB\u75DB\u5FEB\u5FEB\u7684\u9001\u5979\u6B78\u897F\u4FBF\u662F\u3002"
      - "\u8A71\u96D6\u5982\u6B64\uFF0C\u53EA\u6015\u5979\u88AB\n\u903C\u5230\u7AAE\u5730\u4E4B\u6642\u6703\u62FC\u6B7B\u53CD\u566C\uFF0C\n\u5927\u5BB6\u9084\u662F\u5C0F\u5FC3\u70BA\u4E0A\uFF01"
      - "\u77E5\u9053\u4E86\uFF01"
      MsgS:
      - "....\u5C31\u662F\u73B0\u5728\uFF01"
      - "\u5929\u771F\u7684\u50BB\u59D1\u5A18\uFF0C\n\u4F60\u4EE5\u4E3A\u51ED\u90A3\u67C4\u77ED\u5251\u5C31\u80FD...."
      - "\u4E09\u9B44\u9B3C\u773C\uFF01\n\u6211\u7684\u4E09\u9B44\u9B3C\u773C\u7ADF\u7136...."
      - "\u592A\u597D\u4E86\uFF01\u5C01\u59D0\u59D0\uFF01"
      - "\u8FD9\u67C4\u77ED\u5251\u679C\u7136\u662F\u4EF6\n\u4E0D\u51FA\u4E16\u7684\u795E\u5175\uFF0C\n\u4E0D\u8FC7\u6BC1\u4E86\u4E09\u9B44\u9B3C\u773C\u4E4B\u5F8C\uFF0C\n\u5B83\u7684\u7075\u6C14\u4E5F\u5C3D\u6570\u6D88\u6563\u4E86\u3002\n\u6211\u4EEC\u5F97\u5230\u8FD9\u67C4\u795E\u5175\uFF0C\n\u5176\u65F6\u4E4B\u5DE7\uFF0C\n\u60F3\u5FC5\u4E5F\u662F\u4E0A\u5929\u7684\u65E8\u610F\u5427\u3002"
      - "\u4EC0\u9EBD\u4E0A\u5929\u7684\u65E8\u610F\uFF01\n\u5C11\u7B11\u6B7B\u4EBA\u4E86\uFF01\n\u5C31\u7B97\u6CA1\u6709\u4E09\u9B44\u9B3C\u773C\uFF0C\n\u6211\u4E00\u6837\u80FD\u6740\u5C3D\u4F60\u4EEC\u8FD9\u4E9B\u4E0B\u4F17\uFF01\n\u90FD\u7ED9\u6211\u6B7B\u5427\uFF01"
      - "\u597D\u4E2A\u5996\u5B7D\uFF0C\n\u5982\u4ECA\u4F60\u7684\u62A4\u8EAB\u7981\u5236\u5DF2\u5931\uFF0C\n\u5C45\u7136\u8FD8\u60F3\u72C2\u8A00\u901E\u51F6\uFF01"
      - "\u8FD9\u5A46\u5A18\u5DF2\u7ECF\u7A77\u9014\u672B\u8DEF\uFF0C\n\u54B1\u4EEC\u4F55\u5FC5\u548C\u5979\u7F57\u5506\uFF0C\n\u75DB\u75DB\u5FEB\u5FEB\u7684\u9001\u5979\u5F52\u897F\u4FBF\u662F\u3002"
      - "\u8BDD\u867D\u5982\u6B64\uFF0C\u53EA\u6015\u5979\u88AB\n\u903C\u5230\u7A77\u5730\u4E4B\u65F6\u4F1A\u62FC\u6B7B\u53CD\u566C\uFF0C\n\u5927\u5BB6\u8FD8\u662F\u5C0F\u5FC3\u4E3A\u4E0A\uFF01"
      - "\u77E5\u9053\u4E86\uFF01"

    - MsgT:
      - "\u300C\u7B97\u5566\uFF0C\u53CD\u6B63\u6C88\u5BB6\u5EE2\u5C4B\u4E4B\u4E8B\u5DF2\u7D93\u6709\u5B98\u5E9C\u5728\u67E5\uFF0C\u771F\u76F8\u7E3D\u6709\u4E00\u5929\u6703\u5927\u767D\u7684\u3002\u300D"

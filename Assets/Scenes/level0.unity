    - MsgT:
      - "\u78BA\u5B9A\u8981\u5C31\u6B64\u96E2\u57CE\u51FA\u767C\u55CE\uFF1F"
      - "\u662F\u7684\uFF0C\u5C31\u6B64\u96E2\u57CE\u51FA\u767C\u3002"
      - "\u4E0D\uFF0C\u518D\u505C\u7559\u4E00\u6703\u5152\u597D\u4E86\u3002"
      - "\u4E0A\u5B98\u5927\u54E5\uFF0C\u54B1\u5011\u9019\u5C31\u524D\u5F80\u796D\u5929\u5854\u55CE\uFF1F"
      - "\u65E2\u662F\u5982\u6B64\uFF0C\u5C31\u591A\u5F85\u4E00\u6703\u5152\u597D\u4E86\u3002"
      - "\u4E0D\uFF0C\u97CB\u5927\u4EBA\u70BA\u6C42\u614E\u91CD\u8D77\u898B\uFF0C\u6B63\u7387\u7981\u8ECD\u5728\u796D\u5929\u5854\u56DB\u9031\u570D\u6B04\u5E03\u67F5\uFF0C\u5927\u6982\u8981\u5230\u5929\u9ED1\u624D\u80FD\u5B8C\u5DE5\u3002\u54B1\u5011\u5C31\u5148\u5230\u5DE5\u5730\u90A3\u5152\u5F85\u547D\uFF0C\u7B49\u9632\u52D9\u5E03\u7F72\u5468\u8A73\u4E4B\u5F8C\uFF0C\u518D\u884C\u5165\u5854\u4E00\u63A2\u3002"
      - "\u539F\u4F86\u5982\u6B64\u3002\u90A3\u9EBC\u5728\u5165\u5854\u4E4B\u524D\uFF0C\u54B1\u5011\u9084\u53EF\u4EE5\u518D\u4F11\u606F\u7247\u523B\u3002"
      - "\u55EF\u3002\u661F\u76E3\u738B\u5927\u4EBA\u5728\u6628\u591C\u4E4B\u8B8A\u4E2D\u88AB\u56F0\u796D\u5929\u5854\uFF0C\u81F3\u4ECA\u751F\u6B7B\u4E0D\u660E\u3002\u6211\u53EA\u5E0C\u671B\u4ED6\u80FD\u5E73\u5B89\u7121\u4E8B...."
      MsgS:
      - "\u786E\u5B9A\u8981\u5C31\u6B64\u79BB\u57CE\u51FA\u53D1\u5417\uFF1F"
      - "\u662F\u7684\uFF0C\u5C31\u6B64\u79BB\u57CE\u51FA\u53D1\u3002"
      - "\u4E0D\uFF0C\u518D\u505C\u7559\u4E00\u4F1A\u513F\u597D\u4E86\u3002"
      - "\u4E0A\u5B98\u5927\u54E5\uFF0C\u54B1\u4EEC\u8FD9\u5C31\u524D\u5F80\u796D\u5929\u5854\u5417\uFF1F"
      - "\u65E2\u662F\u5982\u6B64\uFF0C\u5C31\u591A\u5F85\u4E00\u4F1A\u513F\u597D\u4E86\u3002"
      - "\u4E0D\uFF0C\u97E6\u5927\u4EBA\u4E3A\u6C42\u614E\u91CD\u8D77\u89C1\uFF0C\u6B63\u7387\u7981\u519B\u5728\u796D\u5929\u5854\u56DB\u5468\u56F4\u680F\u5E03\u6805\uFF0C\u5927\u6982\u8981\u5230\u5929\u9ED1\u624D\u80FD\u5B8C\u5DE5\u3002\u54B1\u4EEC\u5C31\u5148\u5230\u5DE5\u5730\u90A3\u513F\u5F85\u547D\uFF0C\u7B49\u9632\u52A1\u5E03\u7F72\u5468\u8BE6\u4E4B\u5F8C\uFF0C\u518D\u884C\u5165\u5854\u4E00\u63A2\u3002"
      - "\u539F\u6765\u5982\u6B64\u3002\u90A3\u9EBD\u5728\u5165\u5854\u4E4B\u524D\uFF0C\u54B1\u4EEC\u8FD8\u53EF\u4EE5\u518D\u4F11\u606F\u7247\u523B\u3002"
      - "\u55EF\u3002\u661F\u76D1\u738B\u5927\u4EBA\u5728\u6628\u591C\u4E4B\u53D8\u4E2D\u88AB\u56F0\u796D\u5929\u5854\uFF0C\u81F3\u4ECA\u751F\u6B7B\u4E0D\u660E\u3002\u6211\u53EA\u5E0C\u671B\u4ED6\u80FD\u5E73\u5B89\u65E0\u4E8B...."

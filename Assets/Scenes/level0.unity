    - MsgT:
      - "\u300C....\u6709\u95DC\u6628\u591C\u5996\u90AA\u591C\u8972\u5BAE\u4E2D\u4E00\u4E8B\uFF0C\u4F9D\u8001\u592B\u4E4B\u898B\uFF0C\u82E5\u975E\u6709\u9AD8\u4EBA\u51FA\u624B\u76F8\u52A9\uFF0C\u5149\u6191\u90A3\u4E9B\u7981\u8ECD\u662F\u7D55\u5C0D\u64CB\u4E0D\u4E0B\u4F86\u7684\u3002\u4E0D\u77E5\u9019\u4F4D\u9AD8\u4EBA\u5230\u5E95\u662F\u8AB0\uFF0C\u8001\u592B\u5F88\u60F3\u898B\u4E0A\u4E00\u898B\u3002\u300D"
      MsgS:
      - "\u300C....\u6709\u5173\u6628\u591C\u5996\u90AA\u591C\u88AD\u5BAB\u4E2D\u4E00\u4E8B\uFF0C\u4F9D\u8001\u592B\u4E4B\u89C1\uFF0C\u82E5\u975E\u6709\u9AD8\u4EBA\u51FA\u624B\u76F8\u52A9\uFF0C\u5149\u51ED\u90A3\u4E9B\u7981\u519B\u662F\u7EDD\u5BF9\u6321\u4E0D\u4E0B\u6765\u7684\u3002\u4E0D\u77E5\u8FD9\u4F4D\u9AD8\u4EBA\u5230\u5E95\u662F\u8C01\uFF0C\u8001\u592B\u5F88\u60F3\u89C1\u4E0A\u4E00\u89C1\u3002\u300D"
    - MsgT:
      - "\u300C....\u6C92\u60F3\u5230\u5996\u4EBA\u5927\u81BD\u81F3\u65AF\uFF0C\u7ADF\u7136\u591C\u8972\u7687\u5BAE\u8981\u5730\uFF0C\u54B1\u5011\u53EF\u4E0D\u80FD\u518D\u5750\u8996\u4E0D\u7BA1\u4E86\u3002\u300D"

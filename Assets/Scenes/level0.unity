      - "\u7B49\u7B49\uFF01\n\u82E5\u81F3\u6B63\u4E0E\u81F3\u90AA\u4E4B\u6C14\u76F8\u4E92\u51B2\u8361\uFF0C\n\u90A3\u4F1A...."
    - MsgT:
      - "\u55EF\uFF0C\n\u6731\u8001\u9B3C\u7684\u8FF7\u9B42\u8853\u679C\u7136\u6709\u7528\u3002\n\u7167\u9019\u9032\u5EA6\u4F86\u770B\uFF0C\n\u4E0D\u7528\u5230\u5B50\u6642\u5C31\u53EF\u4EE5\u5B8C\u4E8B\u4E86\u3002"
      - "....\u54A6\uFF0C\u6709\u4EBA\u4F86\u4E86\uFF1F\n\u9019\u6642\u5019\u4E0D\u8A72\u6709\u4EBA\u6703\u4F86\u9019\u88E1\u7684....\n\u96E3\u9053\u662F\uFF1F\uFF01"
      - "....\u55EF\uFF0C\u679C\u7136\u662F\u5728\u9019\u88E1\u3002"
      - "\u54C7\uFF0C\u90A3\u662F....\u86A9\u5C24\u7684\u982D\u9AA8\uFF1F"
      - "\u55EF\uFF0C\u6731\u614E\u4F48\u4E0B\u90A3\u4E09\u9670\u51A5\u5E7B\u9663\uFF0C\n\u539F\u4F86\u662F\u70BA\u4E86\u8981\u5FB5\u4E9B\u6C11\u4F15\u4F86\u6B64\u6316\u6398\u3002\n\u6211\u53EA\u9053\u5E7B\u5E7D\u8C37\u7684\u5996\u6C23\u662F\u81EA\u7136\u5929\u6210\uFF0C\n\u539F\u4F86\u86A9\u5C24\u7684\u9AA8\u9AB8\u5C31\u57CB\u5728\u9019\u88E1\uFF0C\n\u9019\u5012\u4EE4\u4EBA\u610F\u60F3\u4E0D\u5230\u4E86\u3002"
      - "\u672C\u5EA7\u9084\u9053\u662F\u8AB0\uFF0C\n\u539F\u4F86\u53C8\u662F\u4F60\u5011\u9019\u6279\u5C0F\u5B50\u3002\n\u54FC\uFF0C\u9023\u9019\u7B49\u5927\u4E8B\u4F60\u5011\u90FD\u6562\u4F86\u6417\u4E82\uFF0C\n\u4ECA\u65E5\u8981\u53EB\u4F60\u5011\u4F86\u5F97\u53BB\u4E0D\u5F97\u3002"
      - "\u5148\u6253\u767C\u4E86\u9019\u4E9B\u9592\u96DC\u4EBA\u7B49\uFF0C\n\u518D\u75DB\u75DB\u5FEB\u5FEB\u7684\u9001\u4F60\u5011\u4E0A\u897F\u5929\uFF01\n"
      - "\u53EF\u60E1\uFF0C\u8981\u6253\u5C31\u6253\uFF0C\n\u4F55\u5FC5\u5C0D\u9019\u8A31\u591A\u7121\u8F9C\u767E\u59D3\u4E0B\u6BD2\u624B\uFF1F"
      - "\u4ED6\u5011\u6C92\u4E8B\uFF0C\n\u53EA\u662F\u88AB\u5996\u8853\u5F04\u6688\u4E86\u800C\u5DF2\u3002\n\u4E0D\u904E\u82E5\u6211\u5011\u807D\u4EFB\u9132\u9670\u70BA\u6240\u6B32\u70BA\uFF0C\n\u90A3\u53EF\u5C31\u5F88\u96E3\u8AAA\u4E86\u3002"
      - "\u54FC\uFF0C\u8C48\u80FD\u8B93\u4ED6\u5F97\u901E\uFF0C\n\u4E14\u8B93\u4FFA\u5148\u5288\u9019\u8001\u602A\u7269\u5E7E\u5200\u518D\u8AAA\u3002"
      - "\u90A3\u662F\u7576\u7136\uFF01\n\u4E0A\u5B98\u5144\uFF0C\u9BAE\u4E8E\u524D\u8F29\uFF0C\u6211\u5011\u4E0A\uFF01"
      - "\u90FD\u7D66\u6211\u51FA\u4F86\u7F77\uFF01"
      MsgS:
      - "\u55EF\uFF0C\n\u6731\u8001\u9B3C\u7684\u8FF7\u9B42\u672F\u679C\u7136\u6709\u7528\u3002\n\u7167\u8FD9\u8FDB\u5EA6\u6765\u770B\uFF0C\n\u4E0D\u7528\u5230\u5B50\u65F6\u5C31\u53EF\u4EE5\u5B8C\u4E8B\u4E86\u3002"
      - "....\u54A6\uFF0C\u6709\u4EBA\u6765\u4E86\uFF1F\n\u8FD9\u65F6\u5019\u4E0D\u8BE5\u6709\u4EBA\u4F1A\u6765\u8FD9\u91CC\u7684....\n\u96BE\u9053\u662F\uFF1F\uFF01"
      - "....\u55EF\uFF0C\u679C\u7136\u662F\u5728\u8FD9\u91CC\u3002"
      - "\u54C7\uFF0C\u90A3\u662F....\u86A9\u5C24\u7684\u5934\u9AA8\uFF1F"
      - "\u55EF\uFF0C\u6731\u614E\u5E03\u4E0B\u90A3\u4E09\u9634\u51A5\u5E7B\u9635\uFF0C\n\u539F\u6765\u662F\u4E3A\u4E86\u8981\u5FB5\u4E9B\u6C11\u592B\u6765\u6B64\u6316\u6398\u3002\n\u6211\u53EA\u9053\u5E7B\u5E7D\u8C37\u7684\u5996\u6C14\u662F\u81EA\u7136\u5929\u6210\uFF0C\n\u539F\u6765\u86A9\u5C24\u7684\u9AA8\u9AB8\u5C31\u57CB\u5728\u8FD9\u91CC\uFF0C\n\u8FD9\u5012\u4EE4\u4EBA\u610F\u60F3\u4E0D\u5230\u4E86\u3002"
      - "\u672C\u5EA7\u8FD8\u9053\u662F\u8C01\uFF0C\n\u539F\u6765\u53C8\u662F\u4F60\u4EEC\u8FD9\u6279\u5C0F\u5B50\u3002\n\u54FC\uFF0C\u8FDE\u8FD9\u7B49\u5927\u4E8B\u4F60\u4EEC\u90FD\u6562\u6765\u6363\u4E71\uFF0C\n\u4ECA\u65E5\u8981\u53EB\u4F60\u4EEC\u6765\u5F97\u53BB\u4E0D\u5F97\u3002"
      - "\u5148\u6253\u53D1\u4E86\u8FD9\u4E9B\u95F2\u6742\u4EBA\u7B49\uFF0C\n\u518D\u75DB\u75DB\u5FEB\u5FEB\u7684\u9001\u4F60\u4EEC\u4E0A\u897F\u5929\uFF01\n"
      - "\u53EF\u6076\uFF0C\u8981\u6253\u5C31\u6253\uFF0C\n\u4F55\u5FC5\u5BF9\u8FD9\u8BB8\u591A\u65E0\u8F9C\u767E\u59D3\u4E0B\u6BD2\u624B\uFF1F"
      - "\u4ED6\u4EEC\u6CA1\u4E8B\uFF0C\n\u53EA\u662F\u88AB\u5996\u672F\u5F04\u6655\u4E86\u800C\u5DF2\u3002\n\u4E0D\u8FC7\u82E5\u6211\u4EEC\u542C\u4EFB\u90F8\u9634\u4E3A\u6240\u6B32\u4E3A\uFF0C\n\u90A3\u53EF\u5C31\u5F88\u96BE\u8BF4\u4E86\u3002"
      - "\u54FC\uFF0C\u5C82\u80FD\u8BA9\u4ED6\u5F97\u901E\uFF0C\n\u4E14\u8BA9\u4FFA\u5148\u5288\u8FD9\u8001\u602A\u7269\u51E0\u5200\u518D\u8BF4\u3002"
      - "\u90A3\u662F\u5F53\u7136\uFF01\n\u4E0A\u5B98\u5144\uFF0C\u9C9C\u4E8E\u524D\u8F88\uFF0C\u6211\u4EEC\u4E0A\uFF01"
      - "\u90FD\u7ED9\u6211\u51FA\u6765\u7F62\uFF01"
    - MsgT:
      - "\u55EF\uFF01\u5929\u6642\u5DF2\u81F3\u3002\n\u56DB\u8352\u4E4B\u9B42\uFF0C\u76E1\u96C6\u65BC\u6B64\uFF0C\n\u660E\u795E\u5929\u9B44\uFF0C\u8FD4\u51A5\u964D\u4E16\u3002\n\u8FF7\u6D85\u6C99\u52A0\u8B28\u63D0\u591A.."
      - "\u963F\u5F4C\u9640\u4F5B\uFF0C\u597D\u91CD\u7684\u5996\u6C23\uFF01\n\u8AF8\u4F4D\u65BD\u4E3B\uFF0C\n\u9019\u5996\u4EBA\u5230\u5E95\u662F\u4F55\u65B9\u795E\u8056\uFF1F"
      - "\u9019\u8A71\u8AAA\u4F86\u53EF\u9577\u4E86....\u7CDF\u5566\uFF0C\n\u9132\u9670\u5728\u65BD\u5996\u6CD5\n\u5F15\u653E\u86A9\u5C24\u9AA8\u9AB8\u7684\u90AA\u529B\uFF01\n\u53EA\u6015\u6B64\u529B\u4E4B\u5A01\u92B3\u4E0D\u53EF\u7576\uFF0C\n\u5927\u5925\u5FEB\u5230\u5DE6\u9996\u5927\u77F3\u4E4B\u5F8C\u8EB2\u907F\uFF01"
      - "\u77E5\u9053\u4E86\uFF01"
      - "\u563F\u563F\uFF0C\n\u4F60\u5011\u4E5F\u77E5\u9053\u53B2\u5BB3\u9EBC\uFF1F\n\u6BD7\u558F\u9054\u63D0\u8036\u6469\u7C2A....\u8D77\uFF01"
      - "\u90A3\u3001\u90A3\u9053\u5149\u83EF\u662F\uFF1F\uFF01"
      - "\u65B9\u624D\u8CA7\u50E7\u898B\u90A3\u6731\u7D05\u6676\u77F3\n\u5167\u860A\u7121\u65B9\u90AA\u6C23\uFF0C\n\u5BE6\u662F\u53EF\u754F\u53EF\u6016\u7684\u5996\u90AA\u6CD5\u5BF6\uFF0C\n\u65BC\u662F\u81EA\u4F5C\u4E3B\u5F35\u4EE5\u6211\u5BC6\u5B97\n\u300C\u7834\u9B54\u91D1\u525B\u6775\u300D\u5C07\u4E4B\u7834\u53BB\uFF0C\n\u6C92\u60F3\u5230\u5C45\u7136\u4E00\u64CA\u6210\u529F\u3002"
      - "\u5927\u548C\u5C1A\u53B2\u5BB3\u7684\u7DCA\uFF0C\n\u4F69\u670D\uFF0C\u4F69\u670D\uFF01"
      - "\u807D\u8AAA\u7834\u9B54\u91D1\u525B\u6775\u5C08\u7834\u9B3C\u9053\u5996\u7269\uFF0C\n\u679C\u7136\u540D\u4E0D\u865B\u50B3\u3002\n\u9019\u7D05\u8272\u6676\u77F3\u90AA\u529B\u96D6\u5F37\uFF0C\n\u537B\u4E5F\u96E3\u7576\u5176\u92D2\u3002"
      - "\u771F\u5DE7\uFF0C\u771F\u5DE7\u3002\n\u672C\u5EA7\u767C\u6398\u9019\u9B42\u6676\uFF0C\n\u539F\u672C\u5C31\u662F\u70BA\u4E86\u91CB\u653E\n\u56F0\u7E1B\u5176\u4E2D\u7684\u86A9\u5C24\u9B42\u9B44\uFF0C\n\u6E4A\u5DE7\u88AB\u4F60\u5011\u4E0D\u77E5\u7A76\u88E1\u7684\u6253\u7834\uFF0C\n\u5982\u4ECA\u9B42\u9B44\u5DF2\u7136\u6563\u5165\u5929\u5730\uFF0C\n\u6B63\u597D\u7701\u4E86\u4E4B\u5F8C\u7684\u4E00\u756A\u529F\u592B\uFF0C\n\u770B\u4F86\u5F97\u597D\u597D\u8B1D\u8B1D\u9019\u4F4D\u9AD8\u50E7\u624D\u884C\u3002"
      - "....\u96E3\u9053\u8AAA\uFF0C\u8CA7\u50E7\u662F\u5E6B\u4E86\u5012\u5FD9\uFF1F"
      - "\u5927\u5E2B\u4E0D\u7528\u4ECB\u610F\uFF0C\n\u5978\u4EBA\u4E00\u5411\u5DE5\u65BC\u5FC3\u8A08\uFF0C\n\u4E0A\u4ED6\u5011\u7684\u7576\u539F\u662F\u5E38\u6709\u4E4B\u4E8B\u3002"
      - "\u563F\u563F\uFF0C\u9019\u548C\u5C1A\u81EA\u5DF1\u591A\u6B64\u4E00\u8209\uFF0C\n\u4F60\u5011\u5012\u602A\u5230\u6211\u982D\u4E0A\u4F86\u4E86\u3002\n\u4E5F\u7F77\uFF0C\u9B42\u6676\u65E2\u7834\uFF0C\n\u6B64\u884C\u53EF\u8AAA\u662F\u5DF2\u5927\u529F\u544A\u6210\u3002\n\u4ECA\u65E5\u5C31\u66AB\u4E14\u5148\u653E\u904E\u4F60\u5011\u4E00\u99AC\uFF0C\n\u54B1\u5011\u5F8C\u6703\u6709\u671F\u5566\uFF01\n\u5475\u5475\u5475\u5475...."
      - "\u7AD9\u4F4F\uFF01\u5225\u9003......."
      - "....\u5443\uFF01"
      - "\u5C01\u59D1\u5A18\uFF1F\u59B3\u600E\u9EBC\u4E86\uFF1F"
      - "\u6211\u6C92\u4E8B\uFF0C\n\u53EA\u662F\u5FFD\u7136\u89BA\u5F97\u6709\u9EDE\u767C\u51B7...."
      - "\u8EAB\u5B50\u4E0D\u9069\u7684\u8A71\u5C31\u5225\u52C9\u5F37\u554A\u3002"
      - "\u5C0D\u4E0D\u8D77....\n\u6211\u60F3\u6211\u662F\u771F\u7684\u6709\u9EDE\u7D2F\u4E86\u3002"
      - "\u8AF8\u4F4D\uFF0C\u53CD\u6B63\u6575\u65B9\u5DF2\u7136\u5F97\u624B\uFF0C\n\u7559\u5728\u9019\u88E1\u4E5F\u6C92\u7528\uFF0C\n\u6211\u5011\u4E0D\u59A8\u5148\u56DE\u57CE\u4F11\u606F\u597D\u4E86\u3002"
      - "\u55EF\u3002\u81EA\u90A3\u6731\u7D05\u6676\u77F3\u7834\u6563\u4E4B\u5F8C\uFF0C\n\u6B64\u5730\u7684\u5996\u6C23\u4E5F\u6DE1\u4E86\u8A31\u591A\u3002\n\u6211\u60F3\u8FF7\u795E\u5996\u6CD5\u5728\u5929\u4EAE\u5F8C\u5C31\u6703\u81EA\u89E3\uFF0C\n\u66AB\u4E14\u8B93\u9019\u4E9B\u5C45\u6C11\u5728\u6B64\u7761\u4E00\u4E0B\u597D\u4E86\u3002"
      - "\u9019\u4F4D\u5927\u5E2B\uFF0C\n\u591A\u8B1D\u60A8\u525B\u624D\u7684\u76F8\u52A9\u4E4B\u6069\u3002\n\u82E5\u5C07\u4F86\u9084\u6709\u6A5F\u6703\u806F\u624B\u5171\u6230\uFF0C\n\u5C46\u6642\u9084\u8ACB\u5927\u5E2B\u591A\u52A0\u95DC\u7167\uFF0C\n\u54B1\u5011\u5C31\u6B64\u5225\u904E\u3002"
      - "\u65BD\u4E3B\uFF0C\n\u8CA7\u50E7\u73FE\u4E0B\u6709\u4E00\u4E0D\u60C5\u4E4B\u8ACB\uFF0C\n\u9084\u671B\u4F60\u80FD\u7B54\u61C9\u3002"
      - "\u4E0D\u77E5\u5927\u5E2B\u6709\u4F55\u6307\u6559\uFF1F"
      - "\u525B\u624D\u8CA7\u50E7\u81EA\u4F5C\u4E3B\u5F35\uFF0C\n\u4EE5\u964D\u9B54\u91D1\u525B\u6775\u64CA\u7834\u6731\u7D05\u6676\u77F3\uFF0C\n\u6B63\u597D\u9042\u4E86\u5996\u4EBA\u4E4B\u610F\uFF0C\n\u96D6\u8AAA\u6B64\u4E8B\u5BE6\u662F\u51FA\u4EBA\u610F\u6599\uFF0C\n\u4F46\u8CA7\u50E7\u4EA6\u8CAC\u7121\u65C1\u8CB8\u3002\n\u9019\u6A23\u5427\uFF01\n\u4E4B\u5F8C\u8CA7\u50E7\u5C31\u548C\u8AF8\u4F4D\u540C\u51FA\u5171\u9032\uFF0C\n\u76F4\u5230\u5996\u4EBA\u4F0F\u8A85\uFF0C\n\u4E8B\u60C5\u5713\u6EFF\u89E3\u6C7A\u70BA\u6B62\u3002\n\u4E0D\u77E5\u65BD\u4E3B\u4EE5\u70BA\u5982\u4F55\uFF1F"
      - "\u5927\u5E2B\uFF0C\u9019\u592A\u59D4\u5C48\u60A8...."
      - "\u8CA7\u50E7\u8EAB\u70BA\u51FA\u5BB6\u4EBA\uFF0C\n\u8DDF\u8457\u5404\u4F4D\u5FC5\u6709\u8AF8\u591A\u4E0D\u4FBF\uFF0C\n\u4F46\u8CA7\u50E7\u5FC3\u610F\u5DF2\u6C7A\uFF0C\n\u5E0C\u671B\u65BD\u4E3B\u4E00\u884C\u80FD\u5920\u6210\u5168\u8CA7\u50E7\u6B64\u9858\u3002"
      - "\u5927\u5E2B\u81EA\u502D\u570B\u9060\u4F86\u4E2D\u571F\uFF0C\n\u60F3\u5FC5\u662F\u8EAB\u8CA0\u5BFA\u4E2D\u8981\u52D9\uFF0C\n\u5982\u6B64\u8DDF\u8457\u6211\u5011\u6771\u5954\u897F\u8DD1\n\u53EF\u662F\u59A5\u7576\uFF1F"
      - "\u9019\u5012\u597D\u8AAA\u3002\n\u5E2B\u5C0A\u8A00\u9053\u8CA7\u50E7\u6BBA\u6027\u592A\u65FA\u3001\n\u60E1\u6839\u672A\u9664\uFF0C\u82E5\u4F86\u4E2D\u571F\u4F5B\u5BFA\u6E05\u4FEE\n\u6216\u53EF\u4FEE\u6210\u6B63\u679C\uFF0C\n\u56E0\u6B64\u7531\u5E2B\u5C0A\u7559\u66F8\u63A8\u85A6\uFF0C\n\u4F86\u6295\u9644\u8FD1\u7684\u9748\u89BA\u5BFA\u3002\n\u8CA7\u50E7\u96D6\u60F3\u8D81\u6B64\u6A5F\u6703\u7CBE\u7814\u4E2D\u571F\u4F5B\u7D93\uFF0C\n\u4F46\u65E2\u6709\u5996\u4EBA\u798D\u4E82\u4E2D\u571F\uFF0C\n\u9664\u6EC5\u5F7C\u7B49\u624D\u662F\u7576\u52D9\u4E4B\u6025\uFF0C\n\u95B1\u7D93\u4FEE\u6CD5\u5012\u4E0D\u6025\u5728\u4E00\u6642\u4E86\u3002"
      - "\u5927\u5E2B\u4E00\u756A\u7F8E\u610F\uFF0C\n\u5728\u4E0B\u662F\u606D\u656C\u4E0D\u5982\u5F9E\u547D\u4E86\u3002\n\u6562\u554F\u5927\u5E2B\u5C0A\u540D\u6CD5\u865F\uFF1F"
      - "\u591A\u8B1D\u65BD\u4E3B\u6210\u5168\u3002\n\u8CA7\u50E7\u6CD5\u865F\u771F\u80E4\uFF0C\n\u4ECA\u5F8C\u5C31\u8ACB\u8AF8\u4F4D\u591A\u591A\u6307\u6559\u4E86\u3002"
      - "\u5927\u5E2B\u5BA2\u6C23\u4E86\u3002\n\u73FE\u4E0B\u5C01\u59D1\u5A18\u8EAB\u9AD4\u4E0D\u9069\uFF0C\n\u54B1\u5011\u5148\u56DE\u57CE\u5167\u6B47\u606F\u5982\u4F55\uFF1F"
      - "\u672C\u662F\u8A72\u7576\u5982\u6B64\uFF0C\n\u7136\u800C\u525B\u624D\u90A3\u5996\u4EBA\n\u96D6\u7528\u9041\u5F71\u4E4B\u8853\u9003\u8D70\uFF0C\n\u60F3\u662F\u9003\u5F97\u4E0D\u9060\u4E4B\u6545\uFF0C\n\u6B64\u523B\u9084\u80FD\u5BDF\u89BA\u4ED6\u5996\u6C23\u7684\u53BB\u5411\uFF0C\n\u5982\u679C\u8981\u8FFD\u7684\u8A71\uFF0C\n\u8D81\u73FE\u5728\u8FFD\u61C9\u8A72\u9084\u4F86\u5F97\u53CA\u3002"
      - "\u96D6\u662F\u5982\u6B64\uFF0C\u4F46......"
      - "\u6BB7\u5927\u54E5\uFF0C\u9019\u56DE\u82E5\u518D\u8B93\u4ED6\u9003\u8D70\uFF0C\n\u4EE5\u5F8C\u5C31\u4E0D\u77E5\u4F55\u6642\u624D\u80FD\u518D\u9047\u4E0A\u4ED6\u5011\uFF0C\n\u6A5F\u4E0D\u53EF\u5931\uFF0C\n\u54B1\u5011\u5FEB\u8FFD\u4FBF\u662F\u3002"
      - "\u53EF\u662F\uFF0C\u59B3\u7684\u8EAB\u5B50......"
      - "\u6BB7\u5927\u54E5\uFF0C\u6211\u77E5\u9053\u4F60\u64D4\u5FC3\u6211\uFF0C\n\u6211.....\u6211\u5FC3\u9818\u4E86\u3002\n\u4F46\u773C\u4E0B\u9084\u662F\u5148\u8FFD\u6575\u4EBA\u8981\u7DCA\uFF0C\n\u771F\u80E4\u5927\u5E2B\uFF0C\u9019\u5C31\u8ACB\u60A8\u5E36\u8DEF\u3002"
      - "\u55EF\u3002\u8DDF\u6211\u4F86\uFF01"
      - ".....\u597D\u90AA\u7684\u5996\u7269\uFF01\uFF1F\n\u770B\u6211\u7684--------"
      - 
      - 
      - 
      MsgS:
      - "\u55EF\uFF01\u5929\u65F6\u5DF2\u81F3\u3002\n\u56DB\u8352\u4E4B\u9B42\uFF0C\u5C3D\u96C6\u65BC\u6B64\uFF0C\n\u660E\u795E\u5929\u9B44\uFF0C\u8FD4\u51A5\u964D\u4E16\u3002\n\u8FF7\u6D85\u6C99\u52A0\u8C1F\u63D0\u591A.."
      - "\u963F\u5F25\u9640\u4F5B\uFF0C\u597D\u91CD\u7684\u5996\u6C14\uFF01\n\u8BF8\u4F4D\u65BD\u4E3B\uFF0C\n\u8FD9\u5996\u4EBA\u5230\u5E95\u662F\u4F55\u65B9\u795E\u5723\uFF1F"
      - "\u8FD9\u8BDD\u8BF4\u6765\u53EF\u957F\u4E86....\u7CDF\u5566\uFF0C\n\u90F8\u9634\u5728\u65BD\u5996\u6CD5\n\u5F15\u653E\u86A9\u5C24\u9AA8\u9AB8\u7684\u90AA\u529B\uFF01\n\u53EA\u6015\u6B64\u529B\u4E4B\u5A01\u9510\u4E0D\u53EF\u5F53\uFF0C\n\u5927\u5925\u5FEB\u5230\u5DE6\u9996\u5927\u77F3\u4E4B\u5F8C\u8EB2\u907F\uFF01"
      - "\u77E5\u9053\u4E86\uFF01"
      - "\u563F\u563F\uFF0C\n\u4F60\u4EEC\u4E5F\u77E5\u9053\u5389\u5BB3\u9EBD\uFF1F\n\u6BD7\u558F\u8FBE\u63D0\u8036\u6469\u7C2A....\u8D77\uFF01"
      - "\u90A3\u3001\u90A3\u9053\u5149\u534E\u662F\uFF1F\uFF01"
      - "\u65B9\u624D\u8D2B\u50E7\u89C1\u90A3\u6731\u7EA2\u6676\u77F3\n\u5185\u8574\u65E0\u65B9\u90AA\u6C14\uFF0C\n\u5B9E\u662F\u53EF\u754F\u53EF\u6016\u7684\u5996\u90AA\u6CD5\u5B9D\uFF0C\n\u65BC\u662F\u81EA\u4F5C\u4E3B\u5F20\u4EE5\u6211\u5BC6\u5B97\n\u300C\u7834\u9B54\u91D1\u521A\u6775\u300D\u5C06\u4E4B\u7834\u53BB\uFF0C\n\u6CA1\u60F3\u5230\u5C45\u7136\u4E00\u51FB\u6210\u529F\u3002"
      - "\u5927\u548C\u5C1A\u5389\u5BB3\u7684\u7D27\uFF0C\n\u4F69\u670D\uFF0C\u4F69\u670D\uFF01"
      - "\u542C\u8BF4\u7834\u9B54\u91D1\u521A\u6775\u4E13\u7834\u9B3C\u9053\u5996\u7269\uFF0C\n\u679C\u7136\u540D\u4E0D\u865A\u4F20\u3002\n\u8FD9\u7EA2\u8272\u6676\u77F3\u90AA\u529B\u867D\u5F3A\uFF0C\n\u5374\u4E5F\u96BE\u5F53\u5176\u950B\u3002"
      - "\u771F\u5DE7\uFF0C\u771F\u5DE7\u3002\n\u672C\u5EA7\u53D1\u6398\u8FD9\u9B42\u6676\uFF0C\n\u539F\u672C\u5C31\u662F\u4E3A\u4E86\u91CA\u653E\n\u56F0\u7F1A\u5176\u4E2D\u7684\u86A9\u5C24\u9B42\u9B44\uFF0C\n\u51D1\u5DE7\u88AB\u4F60\u4EEC\u4E0D\u77E5\u7A76\u91CC\u7684\u6253\u7834\uFF0C\n\u5982\u4ECA\u9B42\u9B44\u5DF2\u7136\u6563\u5165\u5929\u5730\uFF0C\n\u6B63\u597D\u7701\u4E86\u4E4B\u5F8C\u7684\u4E00\u756A\u529F\u592B\uFF0C\n\u770B\u6765\u5F97\u597D\u597D\u8C22\u8C22\u8FD9\u4F4D\u9AD8\u50E7\u624D\u884C\u3002"
      - "....\u96BE\u9053\u8BF4\uFF0C\u8D2B\u50E7\u662F\u5E2E\u4E86\u5012\u5FD9\uFF1F"
      - "\u5927\u5E08\u4E0D\u7528\u4ECB\u610F\uFF0C\n\u5978\u4EBA\u4E00\u5411\u5DE5\u65BC\u5FC3\u8BA1\uFF0C\n\u4E0A\u4ED6\u4EEC\u7684\u5F53\u539F\u662F\u5E38\u6709\u4E4B\u4E8B\u3002"
      - "\u563F\u563F\uFF0C\u8FD9\u548C\u5C1A\u81EA\u5DF1\u591A\u6B64\u4E00\u4E3E\uFF0C\n\u4F60\u4EEC\u5012\u602A\u5230\u6211\u5934\u4E0A\u6765\u4E86\u3002\n\u4E5F\u7F62\uFF0C\u9B42\u6676\u65E2\u7834\uFF0C\n\u6B64\u884C\u53EF\u8BF4\u662F\u5DF2\u5927\u529F\u544A\u6210\u3002\n\u4ECA\u65E5\u5C31\u6682\u4E14\u5148\u653E\u8FC7\u4F60\u4EEC\u4E00\u9A6C\uFF0C\n\u54B1\u4EEC\u5F8C\u4F1A\u6709\u671F\u5566\uFF01\n\u5475\u5475\u5475\u5475...."
      - "\u7AD9\u4F4F\uFF01\u522B\u9003......."
      - "....\u5443\uFF01"
      - "\u5C01\u59D1\u5A18\uFF1F\u4F60\u600E\u9EBD\u4E86\uFF1F"
      - "\u6211\u6CA1\u4E8B\uFF0C\n\u53EA\u662F\u5FFD\u7136\u89C9\u5F97\u6709\u70B9\u53D1\u51B7...."
      - "\u8EAB\u5B50\u4E0D\u9002\u7684\u8BDD\u5C31\u522B\u52C9\u5F3A\u554A\u3002"
      - "\u5BF9\u4E0D\u8D77....\n\u6211\u60F3\u6211\u662F\u771F\u7684\u6709\u70B9\u7D2F\u4E86\u3002"
      - "\u8BF8\u4F4D\uFF0C\u53CD\u6B63\u654C\u65B9\u5DF2\u7136\u5F97\u624B\uFF0C\n\u7559\u5728\u8FD9\u91CC\u4E5F\u6CA1\u7528\uFF0C\n\u6211\u4EEC\u4E0D\u59A8\u5148\u56DE\u57CE\u4F11\u606F\u597D\u4E86\u3002"
      - "\u55EF\u3002\u81EA\u90A3\u6731\u7EA2\u6676\u77F3\u7834\u6563\u4E4B\u5F8C\uFF0C\n\u6B64\u5730\u7684\u5996\u6C14\u4E5F\u6DE1\u4E86\u8BB8\u591A\u3002\n\u6211\u60F3\u8FF7\u795E\u5996\u6CD5\u5728\u5929\u4EAE\u5F8C\u5C31\u4F1A\u81EA\u89E3\uFF0C\n\u6682\u4E14\u8BA9\u8FD9\u4E9B\u5C45\u6C11\u5728\u6B64\u7761\u4E00\u4E0B\u597D\u4E86\u3002"
      - "\u8FD9\u4F4D\u5927\u5E08\uFF0C\n\u591A\u8C22\u60A8\u521A\u624D\u7684\u76F8\u52A9\u4E4B\u6069\u3002\n\u82E5\u5C06\u6765\u8FD8\u6709\u673A\u4F1A\u8054\u624B\u5171\u6218\uFF0C\n\u5C4A\u65F6\u8FD8\u8BF7\u5927\u5E08\u591A\u52A0\u5173\u7167\uFF0C\n\u54B1\u4EEC\u5C31\u6B64\u522B\u8FC7\u3002"
      - "\u65BD\u4E3B\uFF0C\n\u8D2B\u50E7\u73B0\u4E0B\u6709\u4E00\u4E0D\u60C5\u4E4B\u8BF7\uFF0C\n\u8FD8\u671B\u4F60\u80FD\u7B54\u5E94\u3002"
      - "\u4E0D\u77E5\u5927\u5E08\u6709\u4F55\u6307\u6559\uFF1F"
      - "\u521A\u624D\u8D2B\u50E7\u81EA\u4F5C\u4E3B\u5F20\uFF0C\n\u4EE5\u964D\u9B54\u91D1\u521A\u6775\u51FB\u7834\u6731\u7EA2\u6676\u77F3\uFF0C\n\u6B63\u597D\u9042\u4E86\u5996\u4EBA\u4E4B\u610F\uFF0C\n\u867D\u8BF4\u6B64\u4E8B\u5B9E\u662F\u51FA\u4EBA\u610F\u6599\uFF0C\n\u4F46\u8D2B\u50E7\u4EA6\u8D23\u65E0\u65C1\u8D37\u3002\n\u8FD9\u6837\u5427\uFF01\n\u4E4B\u5F8C\u8D2B\u50E7\u5C31\u548C\u8BF8\u4F4D\u540C\u51FA\u5171\u8FDB\uFF0C\n\u76F4\u5230\u5996\u4EBA\u4F0F\u8BDB\uFF0C\n\u4E8B\u60C5\u5706\u6EE1\u89E3\u51B3\u4E3A\u6B62\u3002\n\u4E0D\u77E5\u65BD\u4E3B\u4EE5\u4E3A\u5982\u4F55\uFF1F"
      - "\u5927\u5E08\uFF0C\u8FD9\u592A\u59D4\u5C48\u60A8...."
      - "\u8D2B\u50E7\u8EAB\u4E3A\u51FA\u5BB6\u4EBA\uFF0C\n\u8DDF\u7740\u5404\u4F4D\u5FC5\u6709\u8BF8\u591A\u4E0D\u4FBF\uFF0C\n\u4F46\u8D2B\u50E7\u5FC3\u610F\u5DF2\u51B3\uFF0C\n\u5E0C\u671B\u65BD\u4E3B\u4E00\u884C\u80FD\u591F\u6210\u5168\u8D2B\u50E7\u6B64\u613F\u3002"
      - "\u5927\u5E08\u81EA\u502D\u56FD\u8FDC\u6765\u4E2D\u571F\uFF0C\n\u60F3\u5FC5\u662F\u8EAB\u8D1F\u5BFA\u4E2D\u8981\u52A1\uFF0C\n\u5982\u6B64\u8DDF\u7740\u6211\u4EEC\u4E1C\u5954\u897F\u8DD1\n\u53EF\u662F\u59A5\u5F53\uFF1F"
      - "\u8FD9\u5012\u597D\u8BF4\u3002\n\u5E08\u5C0A\u8A00\u9053\u8D2B\u50E7\u6740\u6027\u592A\u65FA\u3001\n\u6076\u6839\u672A\u9664\uFF0C\u82E5\u6765\u4E2D\u571F\u4F5B\u5BFA\u6E05\u4FEE\n\u6216\u53EF\u4FEE\u6210\u6B63\u679C\uFF0C\n\u56E0\u6B64\u7531\u5E08\u5C0A\u7559\u4E66\u63A8\u8350\uFF0C\n\u6765\u6295\u9644\u8FD1\u7684\u7075\u89C9\u5BFA\u3002\n\u8D2B\u50E7\u867D\u60F3\u8D81\u6B64\u673A\u4F1A\u7CBE\u7814\u4E2D\u571F\u4F5B\u7ECF\uFF0C\n\u4F46\u65E2\u6709\u5996\u4EBA\u7978\u4E71\u4E2D\u571F\uFF0C\n\u9664\u706D\u5F7C\u7B49\u624D\u662F\u5F53\u52A1\u4E4B\u6025\uFF0C\n\u9605\u7ECF\u4FEE\u6CD5\u5012\u4E0D\u6025\u5728\u4E00\u65F6\u4E86\u3002"
      - "\u5927\u5E08\u4E00\u756A\u7F8E\u610F\uFF0C\n\u5728\u4E0B\u662F\u606D\u656C\u4E0D\u5982\u4ECE\u547D\u4E86\u3002\n\u6562\u95EE\u5927\u5E08\u5C0A\u540D\u6CD5\u53F7\uFF1F"
      - "\u591A\u8C22\u65BD\u4E3B\u6210\u5168\u3002\n\u8D2B\u50E7\u6CD5\u53F7\u771F\u80E4\uFF0C\n\u4ECA\u5F8C\u5C31\u8BF7\u8BF8\u4F4D\u591A\u591A\u6307\u6559\u4E86\u3002"
      - "\u5927\u5E08\u5BA2\u6C14\u4E86\u3002\n\u73B0\u4E0B\u5C01\u59D1\u5A18\u8EAB\u4F53\u4E0D\u9002\uFF0C\n\u54B1\u4EEC\u5148\u56DE\u57CE\u5185\u6B47\u606F\u5982\u4F55\uFF1F"
      - "\u672C\u662F\u8BE5\u5F53\u5982\u6B64\uFF0C\n\u7136\u800C\u521A\u624D\u90A3\u5996\u4EBA\n\u867D\u7528\u9041\u5F71\u4E4B\u672F\u9003\u8D70\uFF0C\n\u60F3\u662F\u9003\u5F97\u4E0D\u8FDC\u4E4B\u6545\uFF0C\n\u6B64\u523B\u8FD8\u80FD\u5BDF\u89C9\u4ED6\u5996\u6C14\u7684\u53BB\u5411\uFF0C\n\u5982\u679C\u8981\u8FFD\u7684\u8BDD\uFF0C\n\u8D81\u73B0\u5728\u8FFD\u5E94\u8BE5\u8FD8\u6765\u5F97\u53CA\u3002"
      - "\u867D\u662F\u5982\u6B64\uFF0C\u4F46......"
      - "\u6BB7\u5927\u54E5\uFF0C\u8FD9\u56DE\u82E5\u518D\u8BA9\u4ED6\u9003\u8D70\uFF0C\n\u4EE5\u5F8C\u5C31\u4E0D\u77E5\u4F55\u65F6\u624D\u80FD\u518D\u9047\u4E0A\u4ED6\u4EEC\uFF0C\n\u673A\u4E0D\u53EF\u5931\uFF0C\n\u54B1\u4EEC\u5FEB\u8FFD\u4FBF\u662F\u3002"
      - "\u53EF\u662F\uFF0C\u4F60\u7684\u8EAB\u5B50......"
      - "\u6BB7\u5927\u54E5\uFF0C\u6211\u77E5\u9053\u4F60\u62C5\u5FC3\u6211\uFF0C\n\u6211.....\u6211\u5FC3\u9886\u4E86\u3002\n\u4F46\u773C\u4E0B\u8FD8\u662F\u5148\u8FFD\u654C\u4EBA\u8981\u7D27\uFF0C\n\u771F\u80E4\u5927\u5E08\uFF0C\u8FD9\u5C31\u8BF7\u60A8\u5E26\u8DEF\u3002"
      - "\u55EF\u3002\u8DDF\u6211\u6765\uFF01"
      - ".....\u597D\u90AA\u7684\u5996\u7269\uFF01\uFF1F\n\u770B\u6211\u7684--------"
      - 
      - 

    - MsgT:
      - "\u5431\u5431\uFF01\u5431\uFF1F"
      - "....\u5C01\u59D1\u5A18\uFF0C\u5C0F\u5FC3\uFF01\n\u5728\u59B3\u8EAB\u65C1\u7684\u662F\uFF1F\uFF01"
      - "\u554A\uFF0C\u9AD4\u5927\u5982\u5154\uFF0C\u8EAB\u4F5C\u6A59\u7D05\u4E4B\u8272\uFF0C\n\u982D\u6709\u4E00\u89D2\uFF0C\u9019\u662F....\n\u9019\u662F\u50B3\u8AAA\u4E2D\u7684\u5E7B\u7378\u300C\u9748\u9F29\u300D\uFF01"
      - "\u9748\u9F29\uFF1F\u9019\u73A9\u610F\u6703\u4E0D\u6703\u54AC\u4EBA\uFF1F\n\u5982\u679C\u662F\u4F86\u627E\u9EBB\u7169\u7684\uFF0C\n\u5C31\u4E00\u4F75\u628A\u7260\u7D66\u5288\u4E86\u3002"
      - "\u4E0D\u6703\u7684\uFF0C\u9748\u9F29\u662F\u500B\u6027\u6EAB\u99B4\u7684\u9748\u7378\uFF0C\n\u4E0D\u904E\u4E0D\u592A\u548C\u4EBA\u6253\u4EA4\u9053\uFF0C\n\u6240\u4EE5....\u566F\uFF0C\n\u600E\u9EBC\u4E00\u76F4\u5728\u5F80\u6211\u7684\u61F7\u88E1\u55C5\u8457\uFF0C\n\u50CF\u662F\u8981\u627E\u4EC0\u9EBC\u7684\u6A23\u5B50...."
      - "\u554A\uFF0C\u83AB\u975E\u662F\u6211\u5011\n\u90A3\u5929\u8CB7\u7684\u7D2B\u971C\u96F2\u829D\uFF1F"
      - "\u554A\uFF0C\u6211\u5012\u6C92\u60F3\u5230\uFF01"
      - "...\u5431\u5431\uFF01\u5431\u5431\u5431\uFF01"
      - "\u54CE\u5440\uFF01\u9019\u8CAA\u5FC3\u7684\u5C0F\u6771\u897F\uFF0C\n\u6211\u53EA\u662F\u8B93\u4F60\u770B\u770B\u800C\u5DF2\uFF0C\n\u4F60\u7ADF\u7136\u628A\u96F2\u829D\u7D66\u5403\u6389\u4E86\uFF01"
      - "\u6C92\u95DC\u4FC2\uFF0C\u53CD\u6B63\u90A3\u96F2\u829D\u99AC\u4E0A\u5C31\u6C92\u85E5\u6548\u4E86\uFF0C\n\u5C31\u7B97\u662F\u7528\u4F86\u548C\u7260\u4EA4\u500B\u670B\u53CB\u5427\u3002"
      - "\u54AF\uFF01....\u5495\u5431\uFF1F...."
      - "\u54A6\uFF0C\u90A3\u5C0F\u6771\u897F\u770B\u4F86\u6709\u9EDE\u5947\u602A\uFF0C\n\u83AB\u975E\u662F\u9189\u4E86\uFF1F"
      - "\u559D\u9189\uFF1F....\u96E3\u9053\u662F\u5403\u4E86\u9019\u96F2\u829D\u7684\u7D50\u679C\uFF1F"
      - "\u7CDF\u7CD5\uFF0C\u54B1\u5011\u53EF\u9867\u4E0D\u4E86\u7260\uFF0C\n\u65E2\u662F\u5982\u6B64\uFF0C\n\u5148\u6253\u904E\u4E86\u773C\u524D\u9019\u5834\u4ED7\u518D\u8AAA\u3002"
      - "\u55EF\uFF01"
      - "....\u4F86\uFF0C\u4F60\u8981\u7684\u662F\u9019\u500B\u9EBC\uFF1F"
      MsgS:
      - "\u5431\u5431\uFF01\u5431\uFF1F"
      - "....\u5C01\u59D1\u5A18\uFF0C\u5C0F\u5FC3\uFF01\n\u5728\u4F60\u8EAB\u65C1\u7684\u662F\uFF1F\uFF01"
      - "\u554A\uFF0C\u4F53\u5927\u5982\u5154\uFF0C\u8EAB\u4F5C\u6A59\u7EA2\u4E4B\u8272\uFF0C\n\u5934\u6709\u4E00\u89D2\uFF0C\u8FD9\u662F....\n\u8FD9\u662F\u4F20\u8BF4\u4E2D\u7684\u5E7B\u517D\u300C\u7075\u9F29\u300D\uFF01"
      - "\u7075\u9F29\uFF1F\u8FD9\u73A9\u610F\u4F1A\u4E0D\u4F1A\u54AC\u4EBA\uFF1F\n\u5982\u679C\u662F\u6765\u627E\u9EBB\u70E6\u7684\uFF0C\n\u5C31\u4E00\u5E76\u628A\u7260\u7ED9\u5288\u4E86\u3002"
      - "\u4E0D\u4F1A\u7684\uFF0C\u7075\u9F29\u662F\u4E2A\u6027\u6E29\u9A6F\u7684\u7075\u517D\uFF0C\n\u4E0D\u8FC7\u4E0D\u592A\u548C\u4EBA\u6253\u4EA4\u9053\uFF0C\n\u6240\u4EE5....\u55F3\uFF0C\n\u600E\u9EBD\u4E00\u76F4\u5728\u5F80\u6211\u7684\u6000\u91CC\u55C5\u7740\uFF0C\n\u50CF\u662F\u8981\u627E\u4EC0\u9EBD\u7684\u6837\u5B50...."
      - "\u554A\uFF0C\u83AB\u975E\u662F\u6211\u4EEC\n\u90A3\u5929\u4E70\u7684\u7D2B\u971C\u4E91\u829D\uFF1F"
      - "\u554A\uFF0C\u6211\u5012\u6CA1\u60F3\u5230\uFF01"
      - "...\u5431\u5431\uFF01\u5431\u5431\u5431\uFF01"
      - "\u54CE\u5440\uFF01\u8FD9\u8D2A\u5FC3\u7684\u5C0F\u4E1C\u897F\uFF0C\n\u6211\u53EA\u662F\u8BA9\u4F60\u770B\u770B\u800C\u5DF2\uFF0C\n\u4F60\u7ADF\u7136\u628A\u4E91\u829D\u7ED9\u5403\u6389\u4E86\uFF01"
      - "\u6CA1\u5173\u7CFB\uFF0C\u53CD\u6B63\u90A3\u4E91\u829D\u9A6C\u4E0A\u5C31\u6CA1\u836F\u6548\u4E86\uFF0C\n\u5C31\u7B97\u662F\u7528\u6765\u548C\u7260\u4EA4\u4E2A\u670B\u53CB\u5427\u3002"
      - "\u54AF\uFF01....\u5495\u5431\uFF1F...."
      - "\u54A6\uFF0C\u90A3\u5C0F\u4E1C\u897F\u770B\u6765\u6709\u70B9\u5947\u602A\uFF0C\n\u83AB\u975E\u662F\u9189\u4E86\uFF1F"
      - "\u559D\u9189\uFF1F....\u96BE\u9053\u662F\u5403\u4E86\u8FD9\u4E91\u829D\u7684\u7ED3\u679C\uFF1F"
      - "\u7CDF\u7CD5\uFF0C\u54B1\u4EEC\u53EF\u987E\u4E0D\u4E86\u7260\uFF0C\n\u65E2\u662F\u5982\u6B64\uFF0C\n\u5148\u6253\u8FC7\u4E86\u773C\u524D\u8FD9\u573A\u4ED7\u518D\u8BF4\u3002"
      - "\u55EF\uFF01"
      - "....\u6765\uFF0C\u4F60\u8981\u7684\u662F\u8FD9\u4E2A\u9EBD\uFF1F"
    - MsgT:

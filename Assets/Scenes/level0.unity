      - "\u300C\u6709\u4EC0\u9EBD\u597D\u6025\u7684\uFF0C\u4E86\u4E0D\u8D77\u518D\u591A\u4F11\u606F\u51E0\u5929\u4FBF\u662F\u4E86\u3002\u300D"
    - MsgT:
      - "\u300C\u54C8\u54C8\uFF0C\u6240\u8B02\u82F1\u96C4\u51FA\u5C11\u5E74\u561B\u3002\u53EA\u5E0C\u671B\u4ED6\u5011\u4E0D\u8981\u88AB\u5C3E\u96A8\u7684\u56DB\u8C61\u9580\u4EBA\u8FFD\u4E0A\uFF0C\u4E0D\u7136\u5C31\u7B97\u4ED6\u5011\u8EAB\u624B\u518D\u597D\uFF0C\u53EA\u6015\u4E5F\u662F\u731B\u864E\u96E3\u6575\u7334\u7FA4\u3002\u300D"
      MsgS:
      - "\u300C\u54C8\u54C8\uFF0C\u6240\u8C13\u82F1\u96C4\u51FA\u5C11\u5E74\u561B\u3002\u53EA\u5E0C\u671B\u4ED6\u4EEC\u4E0D\u8981\u88AB\u5C3E\u968F\u7684\u56DB\u8C61\u95E8\u4EBA\u8FFD\u4E0A\uFF0C\u4E0D\u7136\u5C31\u7B97\u4ED6\u4EEC\u8EAB\u624B\u518D\u597D\uFF0C\u53EA\u6015\u4E5F\u662F\u731B\u864E\u96BE\u654C\u7334\u7FA4\u3002\u300D"
    - MsgT:
      - "\u300C\u807D\u5BA2\u68E7\u88CF\u7684\u5E97\u4F34\u63D0\u8D77\uFF0C\u4E0A\u56DE\u6253\u9000\u56DB\u8C61\u9580\u773E\u7684\u662F\u4E00\u5C0D\u7D04\u83AB\u5341\u4E03\u516B\u6B72\u7684\u7537\u5973\uFF0C\u4ED6\u5011\u5E74\u7D00\u8F15\u8F15\uFF0C\u6C92\u60F3\u5230\u7ADF\u7136\u5982\u6B64\u53B2\u5BB3\u3002\u300D"

  - stringT: "\u662F\u5426\u91CD\u65B0\u958B\u59CB\u672C\u95DC\u5361\u6E38\u6232\uFF1F"
    stringS: "\u662F\u5426\u91CD\u65B0\u5F00\u59CB\u672C\u5173\u5361\u6E38\u620F\uFF1F"
  - stringT: "\u662F\uFF0C\u7E7C\u627F\u7B49\u7D1A\u91D1\u9322\uFF0C\u4F46\u7121\u6CD5\u7372\u5F97\u7576\u524D\u95DC\u5361\u719F\u7DF4\u5EA6\u3002"
    stringS: "\u662F\uFF0C\u7EE7\u627F\u7B49\u7EA7\u91D1\u94B1\uFF0C\u4F46\u65E0\u6CD5\u83B7\u5F97\u5F53\u524D\u5173\u5361\u719F\u7EC3\u5EA6\u3002"
  - stringT: "\u5426\uFF0C\u8FD4\u56DE\u6A19\u984C\u754C\u9762\u3002"
    stringS: "\u5426\uFF0C\u8FD4\u56DE\u6807\u9898\u754C\u9762\u3002"
  - stringT: "\u611F\u8B1D\u60A8\u8CFC\u8CB7\u672C\u6E38\u6232\u3002\u5716\u7247\u7B49\u7D20\u6750\u6B78\u5C6C\u539F\u6F22\u5802\u570B\u969B\uFF0C\u4EE3\u78BC\u7248\u6B0A\u6B78\u5C6C\u72D0\u5154\u7DB2\u7D61\uFF0C\u5176\u4ED6\u6E38\u6232\u6B63\u5728\u91CD\u7F6E\u4E2D\u656C\u8ACB\u671F\u5F85\u3002\u524D\u5E7E\u540D\u73A9\u5BB6\u622A\u5716\u4EE5\u4E0B\u96A8\u6A5F\u78BC\u767C\u9001\u81F3\u6E38\u6232\u7FA4\u7BA1\u7406\u54E1\u53EF\u514C\u63DB\u734E\u52F5\uFF01"
    stringS: "\u611F\u8C22\u60A8\u8D2D\u4E70\u672C\u6E38\u620F\u3002\u56FE\u7247\u7B49\u7D20\u6750\u5F52\u5C5E\u539F\u6C49\u5802\u56FD\u9645\uFF0C\u4EE3\u7801\u7248\u6743\u5F52\u5C5E\u72D0\u5154\u7F51\u7EDC\uFF0C\u5176\u4ED6\u6E38\u620F\u6B63\u5728\u91CD\u7F6E\u4E2D\u656C\u8BF7\u671F\u5F85\u3002\u524D\u51E0\u540D\u73A9\u5BB6\u622A\u56FE\u4EE5\u4E0B\u968F\u673A\u7801\u53D1\u9001\u81F3\u6E38\u620F\u7FA4\u7BA1\u7406\u5458\u53EF\u5151\u6362\u5956\u52B1\uFF01"
  - stringT: "\u719F\u7DF4\u5EA6\uFF1A"
    stringS: "\u719F\u7EC3\u5EA6\uFF1A"
  - stringT: "\u7C21\u55AE"
    stringS: "\u7B80\u5355"
  - stringT: "\u666E\u901A"
    stringS: "\u666E\u901A"
  - stringT: "\u56F0\u96E3"
    stringS: "\u56F0\u96BE"
  - stringT: "\u56DE\u5408\u6578\uFF1A"
    stringS: "\u56DE\u5408\u6570\uFF1A"
  - stringT: "\u6578\u64DA\u4E0A\u50B3\u4E2D......"
    stringS: "\u6570\u636E\u4E0A\u4F20\u4E2D......"
  - stringT: "\u6578\u64DA\u4E0A\u50B3\u5B8C\u6210\u3002"
    stringS: "\u6570\u636E\u4E0A\u4F20\u5B8C\u6210\u3002"
  - stringT: "\u6E38\u6232\u6642\u9593\uFF1A"
    stringS: "\u6E38\u620F\u65F6\u95F4\uFF1A"
  - stringT: "\u7528\u6236\u5354\u8B70\n\u7528\u6236\u4F7F\u7528\u672C\u6E38\u6232\u8EDF\u4EF6\u9ED8\u8A8D\u540C\u610F\u4EE5\u4E0B\u5354\u8B70\uFF1A\n\n1.\u7528\u6236\u4E0D\u5F97\u4EE5\u4EFB\u4F55\u5F62\u5F0F\u5C07\u672C\u6E38\u6232\u8EDF\u4EF6\u516C\u958B\u4E0B\u8F09\u3002\n2.\u6E38\u6232\u8EDF\u4EF6\u6E2C\u8A66\u671F\u9593\u4F7F\u7528\u4E91\u5B58\u6A94\u7CFB\u7D71\u7121\u672C\u5730\u6578\u64DA\uFF0C\u6E38\u6232\u8EDF\u4EF6\u958B\u767C\u5546\u5C07\u59A5\u5584\u4FDD\u5B58\u7528\u6236\u4EFB\u4F55\u6578\u64DA\u4FE1\u606F\u5E76\u53EF\u4EE5\u4EFB\u610F\u4F7F\u7528\u7528\u6236\u4E91\u5B58\u6A94\u7B49\u6578\u64DA\u3002\u8ACB\u7B49\u5F85\u5B58\u6A94\u4E0A\u50B3\u5B8C\u7562\uFF0C\u4EE5\u514D\u6578\u64DA\u4E1F\u5931\uFF0C\u6E2C\u8A66\u7D50\u675F\u540E\u5B58\u6A94\u5C07\u88AB\u6E05\u7A7A\uFF0C\u672C\u6E38\u6232\u8EDF\u4EF6\u5C07\u7121\u6CD5\u7E7C\u7E8C\u4F7F\u7528\u3002\n3.\u672C\u6E38\u6232\u8EDF\u4EF6\u5C07\u9ED8\u8A8D\u4E0A\u50B3\u6E38\u6232\u5167\u932F\u8AA4\u4FE1\u606F\uFF0C\u5982\u6709\u5FC5\u8981\u8ACB\u5C07\u5E95\u90E8\u672C\u6A5FID\u622A\u5716\u767C\u9001\u6E38\u6232\u6E2C\u8A66\u7FA4\u3002\n4.\u6E2C\u8A66\u671F\u9593\u53EF\u80FD\u66F4\u65B0\u6BD4\u8F03\u983B\u7E41\uFF0C\u76EE\u524D\u9700\u8981\u6574\u9AD4\u5168\u90E8\u4E0B\u8F09\uFF0C\u66AB\u7121\u5DEE\u91CF\u4E0B\u8F09\u66F4\u65B0\u3002\u611F\u8B1D\u60A8\u7684\u7406\u89E3\u8207\u652F\u6301\uFF01\n5.\u6E2C\u8A66\u7D50\u675F\u540E\u6211\u5011\u5C07\u7D66\u4E88\u6E2C\u8A66\u512A\u7570\u8005\u8C50\u539A\u734E\u52F5\u3002\n"
    stringS: "\u7528\u6237\u534F\u8BAE\n\u7528\u6237\u4F7F\u7528\u672C\u6E38\u620F\u8F6F\u4EF6\u9ED8\u8BA4\u540C\u610F\u4EE5\u4E0B\u534F\u8BAE\uFF1A\n\n1.\u7528\u6237\u4E0D\u5F97\u4EE5\u4EFB\u4F55\u5F62\u5F0F\u5C06\u672C\u6E38\u620F\u8F6F\u4EF6\u516C\u5F00\u4E0B\u8F7D\u3002\n2.\u6E38\u620F\u8F6F\u4EF6\u6D4B\u8BD5\u671F\u95F4\u4F7F\u7528\u4E91\u5B58\u6863\u7CFB\u7EDF\u65E0\u672C\u5730\u6570\u636E\uFF0C\u6E38\u620F\u8F6F\u4EF6\u5F00\u53D1\u5546\u5C06\u59A5\u5584\u4FDD\u5B58\u7528\u6237\u4EFB\u4F55\u6570\u636E\u4FE1\u606F\u5E76\u53EF\u4EE5\u4EFB\u610F\u4F7F\u7528\u7528\u6237\u4E91\u5B58\u6863\u7B49\u6570\u636E\u3002\u8BF7\u7B49\u5F85\u5B58\u6863\u4E0A\u4F20\u5B8C\u6BD5\uFF0C\u4EE5\u514D\u6570\u636E\u4E22\u5931\uFF0C\u6D4B\u8BD5\u7ED3\u675F\u540E\u5B58\u6863\u5C06\u88AB\u6E05\u7A7A\uFF0C\u672C\u6E38\u620F\u8F6F\u4EF6\u5C06\u65E0\u6CD5\u7EE7\u7EED\u4F7F\u7528\u3002\n3.\u672C\u6E38\u620F\u8F6F\u4EF6\u5C06\u9ED8\u8BA4\u4E0A\u4F20\u6E38\u620F\u5185\u9519\u8BEF\u4FE1\u606F\uFF0C\u5982\u6709\u5FC5\u8981\u8BF7\u5C06\u5E95\u90E8\u672C\u673AID\u622A\u56FE\u53D1\u9001\u6E38\u620F\u6D4B\u8BD5\u7FA4\u3002\n4.\u6D4B\u8BD5\u671F\u95F4\u53EF\u80FD\u66F4\u65B0\u6BD4\u8F83\u9891\u7E41\uFF0C\u76EE\u524D\u9700\u8981\u6574\u4F53\u5168\u90E8\u4E0B\u8F7D\uFF0C\u6682\u65E0\u5DEE\u91CF\u4E0B\u8F7D\u66F4\u65B0\u3002\u611F\u8C22\u60A8\u7684\u7406\u89E3\u4E0E\u652F\u6301\uFF01\n5.\u6D4B\u8BD5\u7ED3\u675F\u540E\u6211\u4EEC\u5C06\u7ED9\u4E88\u6D4B\u8BD5\u4F18\u5F02\u8005\u4E30\u539A\u5956\u52B1\u3002\n"

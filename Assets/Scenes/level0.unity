    - MsgT:
      - "\u300C\u566F\uFF0C\u4F60\u5C31\u5225\u4E82\u60F3\u592A\u591A\u4E86\u3002\u60F3\u60F3\u4E0A\u56DE\u90A3\u584A\u602A\u9435\u76F4\u5230\u73FE\u5728\u90FD\u9084\u7121\u6CD5\u71D2\u9394\uFF0C\u54B1\u5011\u9023\u9019\u500B\u90FD\u5F04\u4E0D\u597D\uFF0C\u6240\u4EE5\u53EA\u6709\u6253\u5C0B\u5E38\u5175\u5668\u7684\u4EFD\u3002\u300D"
      MsgS:
      - "\u300C\u55F3\uFF0C\u4F60\u5C31\u522B\u4E71\u60F3\u592A\u591A\u4E86\u3002\u60F3\u60F3\u4E0A\u56DE\u90A3\u5757\u602A\u94C1\u76F4\u5230\u73B0\u5728\u90FD\u8FD8\u65E0\u6CD5\u70E7\u7194\uFF0C\u54B1\u4EEC\u8FDE\u8FD9\u4E2A\u90FD\u5F04\u4E0D\u597D\uFF0C\u6240\u4EE5\u53EA\u6709\u6253\u5BFB\u5E38\u5175\u5668\u7684\u4EFD\u3002\u300D"
    - MsgT:
      - "\u300C\u6253\u4E86\u9019\u9EBC\u591A\u5E74\u7684\u5175\u5668\uFF0C\u4EC0\u9EBC\u5947\u91D1\u7570\u9435\u591A\u591A\u5C11\u5C11\u4E5F\u90FD\u6253\u904E\u4E00\u4E9B\u3002\u4E0D\u904E\u807D\u8AAA\u6709\u4E9B\u5175\u5668\u7684\u795E\u5A01\u8D85\u7FA4\uFF0C\u4E26\u975E\u4EBA\u624B\u6240\u80FD\u9020\u51FA\uFF0C\u82E5\u6709\u6A5F\u6703\u7684\u8A71\uFF0C\u771F\u60F3\u5F04\u4E00\u628A\u4F86\u770B\u770B\u5230\u5E95\u795E\u7570\u4F55\u5728\u3002\u300D"
      MsgS:
      - "\u300C\u6253\u4E86\u8FD9\u9EBD\u591A\u5E74\u7684\u5175\u5668\uFF0C\u4EC0\u9EBD\u5947\u91D1\u5F02\u94C1\u591A\u591A\u5C11\u5C11\u4E5F\u90FD\u6253\u8FC7\u4E00\u4E9B\u3002\u4E0D\u8FC7\u542C\u8BF4\u6709\u4E9B\u5175\u5668\u7684\u795E\u5A01\u8D85\u7FA4\uFF0C\u5E76\u975E\u4EBA\u624B\u6240\u80FD\u9020\u51FA\uFF0C\u82E5\u6709\u673A\u4F1A\u7684\u8BDD\uFF0C\u771F\u60F3\u5F04\u4E00\u628A\u6765\u770B\u770B\u5230\u5E95\u795E\u5F02\u4F55\u5728\u3002\u300D"
    - MsgT:
      - "\u300C....\u6211\u770B\u554F\u984C\u591A\u534A\u662F\u51FA\u5728\u7687\u57CE\u4E4B\u4E2D\uFF0C\u54B1\u5011\u4E0D\u59A8\u591C\u63A2\u7687\u5BAE\uFF0C\u6216\u8A31\u80FD\u5C0B\u5F97\u4E00\u9EDE\u86DB\u7D72\u99AC\u8DE1\u3002\u300D"
      MsgS:
      - "\u300C....\u6211\u770B\u95EE\u9898\u591A\u534A\u662F\u51FA\u5728\u7687\u57CE\u4E4B\u4E2D\uFF0C\u54B1\u4EEC\u4E0D\u59A8\u591C\u63A2\u7687\u5BAB\uFF0C\u6216\u8BB8\u80FD\u5BFB\u5F97\u4E00\u70B9\u86DB\u4E1D\u9A6C\u8FF9\u3002\u300D"
    - MsgT:
      - "\u300C....\u4F60\u9019\u4EBA\u7576\u771F\u4E82\u4F86\uFF0C\u5927\u5167\u7687\u5BAE\u8C48\u662F\u53EF\u4EE5\u96A8\u4FBF\u95D6\u7684\uFF1F\u54B1\u5011\u5C31\u518D\u7B49\u4E0A\u5E7E\u65E5\uFF0C\u770B\u4E4B\u5F8C\u9084\u6709\u4EC0\u9EBC\u52D5\u975C\u518D\u8AAA\u3002\u300D"
      MsgS:
      - "\u300C....\u4F60\u8FD9\u4EBA\u5F53\u771F\u4E71\u6765\uFF0C\u5927\u5185\u7687\u5BAB\u5C82\u662F\u53EF\u4EE5\u968F\u4FBF\u95EF\u7684\uFF1F\u54B1\u4EEC\u5C31\u518D\u7B49\u4E0A\u51E0\u65E5\uFF0C\u770B\u4E4B\u5F8C\u8FD8\u6709\u4EC0\u9EBD\u52A8\u9759\u518D\u8BF4\u3002\u300D"
    - MsgT:
      - "\u300C\u4E0D\u77E5\u6211\u662F\u4E0D\u662F\u72AF\u4E86\u8033\u9CF4\u75C7\uFF0C\u9019\u5E7E\u5929\u6BCF\u665A\u807D\u5230\u54EA\u88E1\u50B3\u4F86\u5C16\u7D30\u7684\u602A\u7B11\u8072\uFF0C\u5BB3\u6211\u4E00\u76F4\u90FD\u7761\u4E0D\u597D\u89BA\u3002\u5475\uFF5E\u597D\u774F....\u300D"
      MsgS:
      - "\u300C\u4E0D\u77E5\u6211\u662F\u4E0D\u662F\u72AF\u4E86\u8033\u9E23\u75C7\uFF0C\u8FD9\u51E0\u5929\u6BCF\u665A\u542C\u5230\u54EA\u91CC\u4F20\u6765\u5C16\u7EC6\u7684\u602A\u7B11\u58F0\uFF0C\u5BB3\u6211\u4E00\u76F4\u90FD\u7761\u4E0D\u597D\u89C9\u3002\u5475\uFF5E\u597D\u56F0....\u300D"
    - MsgT:
      - "\u300C\u5C31\u7B97\u6709\u4E86\u5408\u624B\u7684\u5175\u5668\uFF0C\u4E5F\u5F97\u8981\u6709\u4E00\u8EAB\u597D\u6B66\u85DD\u624D\u80FD\u76F8\u5F97\u76CA\u5F70\u3002\u300D"
      MsgS:
      - "\u300C\u5C31\u7B97\u6709\u4E86\u5408\u624B\u7684\u5175\u5668\uFF0C\u4E5F\u5F97\u8981\u6709\u4E00\u8EAB\u597D\u6B66\u827A\u624D\u80FD\u76F8\u5F97\u76CA\u5F70\u3002\u300D"
    - MsgT:
      - "\u300C\u5077\u5F97\u6D6E\u751F\u534A\u65E5\u9592\uFF0C\u679C\u7136\u662F\u4EBA\u751F\u4E00\u5927\u6A02\u4E8B\u3002\u300D"
      MsgS:
      - "\u300C\u5077\u5F97\u6D6E\u751F\u534A\u65E5\u95F2\uFF0C\u679C\u7136\u662F\u4EBA\u751F\u4E00\u5927\u4E50\u4E8B\u3002\u300D"
    - MsgT:
      - "\u300C\u6211\u77A7\u7576\u4ECA\u7687\u4E0A\u6975\u662F\u8FF7\u4FE1\u98A8\u6C34\u904B\u52E2\u4E4B\u8AAA\uFF0C\u81EA\u5F9E\u90A3\u9F4A\u7940\u5165\u5BAE\u4EE5\u4F86\uFF0C\u5BAE\u88E1\u8208\u5DE5\u52D5\u571F\u5DF2\u4E0D\u53EA\u4E00\u6B21\uFF0C\u7136\u800C\u57CE\u4E2D\u7570\u8C61\u6709\u589E\u7121\u6E1B\uFF0C\u9019\u5BE6\u662F\u8AF7\u523A\u5DF2\u6975\u3002\u300D"
      MsgS:
      - "\u300C\u6211\u77A7\u5F53\u4ECA\u7687\u4E0A\u6781\u662F\u8FF7\u4FE1\u98CE\u6C34\u8FD0\u52BF\u4E4B\u8BF4\uFF0C\u81EA\u4ECE\u90A3\u9F50\u7940\u5165\u5BAB\u4EE5\u6765\uFF0C\u5BAB\u91CC\u5174\u5DE5\u52A8\u571F\u5DF2\u4E0D\u53EA\u4E00\u6B21\uFF0C\u7136\u800C\u57CE\u4E2D\u5F02\u8C61\u6709\u589E\u65E0\u51CF\uFF0C\u8FD9\u5B9E\u662F\u8BBD\u523A\u5DF2\u6781\u3002\u300D"
    - MsgT:
      - "\u300C\u566F\uFF0C\u5225\u5FD8\u4E86\u6B64\u5730\u4E43\u662F\u5929\u5B50\u8173\u4E0B\uFF0C\u52F8\u4F60\u9019\u7A2E\u8A71\u4F60\u9084\u662F\u5C11\u8AAA\u4E00\u9EDE\uFF0C\u514D\u5F97\u7121\u7AEF\u60F9\u798D\u4E0A\u8EAB\u3002\u300D"
      MsgS:
      - "\u300C\u55F3\uFF0C\u522B\u5FD8\u4E86\u6B64\u5730\u4E43\u662F\u5929\u5B50\u811A\u4E0B\uFF0C\u529D\u4F60\u8FD9\u79CD\u8BDD\u4F60\u8FD8\u662F\u5C11\u8BF4\u4E00\u70B9\uFF0C\u514D\u5F97\u65E0\u7AEF\u60F9\u7978\u4E0A\u8EAB\u3002\u300D"
    - MsgT:
      - "\u300C\u6C92\u95DC\u4FC2\uFF0C\u7B49\u6211\u9577\u5927\u4E4B\u5F8C\uFF0C\u5C31\u53EF\u4EE5\u770B\u61C2\u9019\u4E9B\u544A\u793A\u4E0A\u662F\u5BEB\u4E9B\u4EC0\u9EBC\u4E86\u3002\u300D"
      MsgS:
      - "\u300C\u6CA1\u5173\u7CFB\uFF0C\u7B49\u6211\u957F\u5927\u4E4B\u5F8C\uFF0C\u5C31\u53EF\u4EE5\u770B\u61C2\u8FD9\u4E9B\u544A\u793A\u4E0A\u662F\u5199\u4E9B\u4EC0\u9EBD\u4E86\u3002\u300D"
    - MsgT:
      - "\u300C....\u6C6A!\u6C6A!\u300D"
      MsgS:
      - "\u300C....\u6C6A!\u6C6A!\u300D"
    - MsgT:
      - "\u300C\u4E5F\u4E0D\u77E5\u600E\u7684\uFF0C\u6211\u4E00\u770B\u5230\u90A3\u796D\u5929\u5854\u5C31\u89BA\u5F97\u6E3E\u8EAB\u4E0D\u8212\u670D\u3002\u300D"
      MsgS:
      - "\u300C\u4E5F\u4E0D\u77E5\u600E\u7684\uFF0C\u6211\u4E00\u770B\u5230\u90A3\u796D\u5929\u5854\u5C31\u89C9\u5F97\u6D51\u8EAB\u4E0D\u8212\u670D\u3002\u300D"
    - MsgT:
      - "\u54A6\uFF0C\u9019\u5927\u6A39\u7684\u6A39\u6839\u8655\u597D\u50CF\u57CB\u6709\u6771\u897F\uFF0C\u83AB\u975E\u662F\u8944\u967D\u57CE\u90A3\u5C0D\u592B\u5A66\u6240\u8AAA\u7684\u57CB\u85CF\u4E4B\u7269\uFF1F\u55EF\uFF0C\u5148\u6316\u51FA\u4F86\u770B\u770B\u518D\u8AAA\u597D\u4E86\u3002"
      - "\u767C\u73FE\u4E94\u9762\u6C34\u93E1\uFF0C\u4E94\u4EFD\u6642\u5E7B\u6C99\uFF01"
      - "\u5475\u5475\uFF0C\u6C92\u60F3\u5230\u90A3\u5C0D\u592B\u5A66\u5C0F\u6642\u5019\u9019\u9EBC\u9811\u76AE\uFF0C\u9019\u53EF\u90FD\u662F\u5341\u5206\u73CD\u7F55\u7684\u5BF6\u7269\u5462\u3002\u53CD\u6B63\u4ED6\u5011\u90FD\u8AAA\u7528\u4E0D\u8457\u4E86\uFF0C\u54B1\u5011\u5C31\u501F\u4F86\u4E00\u7528\u5427\u3002"
      - "\u55EF\uFF0C\u4E5F\u597D...."
      - "\u57CB\u5728\u6A39\u4E0B\u7684\u7F48\u5B50\u88E1\u53EA\u5269\u4E00\u4E9B\u5C0F\u5B69\u5B50\u7684\u96DC\u7269\uFF0C\u5C31\u5225\u53BB\u52D5\u5B83\u5011\u597D\u4E86\u3002"
      MsgS:
      - "\u54A6\uFF0C\u8FD9\u5927\u6811\u7684\u6811\u6839\u5904\u597D\u50CF\u57CB\u6709\u4E1C\u897F\uFF0C\u83AB\u975E\u662F\u8944\u9633\u57CE\u90A3\u5BF9\u592B\u5987\u6240\u8BF4\u7684\u57CB\u85CF\u4E4B\u7269\uFF1F\u55EF\uFF0C\u5148\u6316\u51FA\u6765\u770B\u770B\u518D\u8BF4\u597D\u4E86\u3002"
      - "\u53D1\u73B0\u4E94\u9762\u6C34\u955C\uFF0C\u4E94\u4EFD\u65F6\u5E7B\u6C99\uFF01"
      - "\u5475\u5475\uFF0C\u6CA1\u60F3\u5230\u90A3\u5BF9\u592B\u5987\u5C0F\u65F6\u5019\u8FD9\u9EBD\u987D\u76AE\uFF0C\u8FD9\u53EF\u90FD\u662F\u5341\u5206\u73CD\u7F55\u7684\u5B9D\u7269\u5462\u3002\u53CD\u6B63\u4ED6\u4EEC\u90FD\u8BF4\u7528\u4E0D\u7740\u4E86\uFF0C\u54B1\u4EEC\u5C31\u501F\u6765\u4E00\u7528\u5427\u3002"

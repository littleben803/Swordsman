      - "....\u97E9\u59D1\u5A18\uFF0C\u4F60\u56DE\u53BB\u5427\u3002\n\u8BA9\u6211\u4E00\u4E2A\u4EBA\u5728\u8FD9\u91CC\u597D\u9EBD\uFF1F"
      - "\u8FD9\u600E\u9EBD\u884C\uFF01\n\u6211\u7B54\u5E94\u8FC7\u5927\u5BB6\u8981\u7167\u987E\u4F60\u7684...."
      - "\u4ED6\u8FD9\u4EBA\u987D\u56FA\u5F97\u5F88\uFF0C\n\u5149\u662F\u8FD9\u6837\u529D\u662F\u6CA1\u7528\u7684\u3002\n\u8FD9\u5C0F\u5B50\u7684\u4E8B\u5C31\u4EA4\u7ED9\u6211\u5427\uFF01"
      - "\u554A\uFF0C\u524D\u8F88\u548C\u7D2B\u67AB\u5927\u59D0\uFF01\n\u60A8\u4EEC\u6765\u5566\uFF01"
      - "\u665A\u8F88....\u62DC\u89C1\u4E24\u4F4D\u524D\u8F88\u3002"
      - "\u4F60\u4F5C\u5F97\u5F88\u597D\uFF0C\n\u4E0D\u6127\u662F\u795E\u5251\u547D\u5B9A\u7684\u7EE7\u627F\u8005\u3002\n\u5728\u5251\u90AA\u4F0F\u8BDB\u4E4B\u5F8C\uFF0C\n\u4E0A\u9762\u90A3\u8FB9\u7ECF\u6211\u62A5\u8BAF\u65A1\u65CB\uFF0C\n\u5DF2\u7ECF\u628A\u5341\u4E07\u5929\u5175\u64A4\u56DE\u8FCE\u5929\u95E8\uFF0C\n\u4ECA\u5F8C\u4EBA\u95F4\u5F53\u53EF\u518D\u4FDD\u957F\u5E74\u592A\u5E73\uFF0C\n\u8FD9\u5168\u591A\u4E8F\u4F60\u4E86\u3002"
      - "....\u524D\u8F88\u8FC7\u5956\u4E86\uFF0C\n\u8FD9\u7EDD\u975E\u665A\u8F88\u4E00\u4EBA\u4E4B\u529F\u3002\n\u665A\u8F88..\u665A\u8F88\u4EC0\u9EBD\u4E5F\u6CA1\u4F5C\uFF0C\n\u4EC0\u9EBD\u4E5F\u4F5C\u4E0D\u4E86\u3002\n\u665A\u8F88\u6CE8\u5B9A\u4E0E\u795E\u5251\u65E0\u7F18\uFF0C\n\u6240\u8C13\u795E\u5251\u7EE7\u627F\u8005\u4E91\u4E91\uFF0C\n\u8BF7\u524D\u8F88\u4ECA\u5F8C\u518D\u4E5F\u4F11\u63D0...."
      - "\u53EA\u8981\u5FC3\u4E2D\u6709\u5FF5\uFF0C\u4F55\u60E7\u624B\u4E2D\u65E0\u5251\uFF1F\n\u4ECA\u5F8C\u6211\u5C06\u7834\u9B54\u4E0E\u5FA1\u5251\u5FC3\u6CD5\u4F20\u4F60\uFF0C\n\u518D\u7531\u4F60\u6D41\u4F20\u65BC\u4EBA\u95F4\u8BF8\u6CD5\u5251\u6D3E\uFF0C\n\u5982\u6B64\u8FDC\u80DC\u5355\u72EC\u4E00\u67C4\u795E\u5251\u4E4B\u5A01\u3002\n\u6253\u8D77\u7CBE\u795E\u6765\uFF0C\n\u4ECA\u5F8C\u8FD8\u6709\u8BB8\u591A\u4E8B\u8981\u9760\u4F60\u6765\u505A\uFF0C\n\u5149\u662F\u5728\u6B64\u4F0F\u5893\u795E\u4F24\uFF0C\n\u90A3\u53EF\u4E0D\u662F\u7537\u5B50\u6C49\u8BE5\u4F5C\u7684\u4E8B\u60C5\u3002"
      - "....\u524D\u8F88\u7684\u4E00\u756A\u597D\u610F\uFF0C\n\u665A\u8F88\u5FC3\u9886\u4E86\u3002\n\u53EA\u662F\u665A\u8F88\u5DF2\u7ECF\u5FC3\u6B7B\u65AD\u5FF5\uFF0C\n\u4ECA\u5F8C\u53EA\u60F3\u5728\u6B64\u5893\u4E4B\u524D\n\u5EA6\u8FC7\u4F59\u751F.....\n\u8FD8\u662F\u8BF7\u524D\u8F88\u53E6\u627E\u9AD8\u660E\u5427\uFF01"
      - "\u6BB7\u516C\u5B50\uFF0C\n\u4F60\u4E0D\u80FD\u5C31\u8FD9\u6837\u6D88\u6C88\u4E0B\u53BB...."
      - "\u6211\u65E9\u5C31\u6599\u5230\u4F60\u4F1A\u8FD9\u9EBD\u56DE\u7B54....\n\u6BB7\u5C11\u4FA0\uFF0C\u4E8B\u5B9E\u4E0A\n\u6211\u8FD8\u5E26\u4E86\u53E6\u4E00\u4E2A\u4EBA\u6765\u770B\u4F60\u3002"
      - "\u5E94\u59D1\u5A18\uFF0C\u4F60\u53EF\u4EE5\u51FA\u6765\u4E86\u3002"
      - "\u662F\u3002"
      - "....\u5C0F\u5E08\u59B9\uFF1F\uFF01\n\u4F60\u600E\u9EBD\u6765\u4E86\uFF1F\n\u4E3A\u4F55\u4E00\u8EAB\u7F1F\u7D20\uFF1F\n\u96BE\u9053\u5E08\u7236\u4ED6...."
      - "\u7239\u81EA\u90A3\u6B21\u4ECE\u78D0\u5929\u5CAD\u56DE\u6765\u5F8C\n\u5C31\u4E00\u75C5\u4E0D\u8D77\uFF0C\u836F\u77F3\u7F54\u6548\uFF0C\n\u534A\u4E2A\u6708\u4E4B\u524D\u5C31\u53BB\u4E16\u4E86\u3002\n\u4ED6\u5728\u75C5\u4E2D\u4E00\u76F4\u5FF5\u7740\u5927\u5E08\u5144\uFF0C\n\u8BF4\u4ED6\u4E0D\u4F46\u5F53\u5E74\u5BF9\u4E0D\u8D77\u4F60\u7239\uFF0C\n\u4E5F\u5BF9\u4E0D\u8D77\u4E00\u76F4\u606D\u8C28\u5949\u5E08\u7684\u4F60\u3002\n\u7239\u5F88\u5F8C\u6094\u5F53\u521D\n\u5C06\u5927\u5E08\u5144\u9010\u51FA\u5E08\u95E8\u4E00\u4E8B\uFF0C\n\u5728\u4E34\u7EC8\u4E4B\u524D\u4E00\u518D\u4EA4\u4EE3\u6211\uFF0C\n\u4E00\u5B9A\u8981\u628A\u5927\u5E08\u5144\u627E\u56DE\u6765\n\u7EE7\u4EFB\u638C\u95E8\u4E4B\u4F4D\uFF0C\n\u4E0D\u7136\u4ED6\u5728\u5730\u4E0B\u4E5F\u4E0D\u4F1A\u5B89\u5FC3...."
      - "\u5E08\u7236....\u5E08\u7236\u7EC8\u7A76\u662F\u613F\u610F\n\u63A5\u7EB3\u6211\u56DE\u672C\u95E8\u4E86\u3002\n\u53EA\u53EF\u60DC\u6211\u6CA1\u80FD\u6765\u5F97\u53CA\n\u89C1\u4ED6\u8001\u4EBA\u5BB6\u6700\u5F8C\u4E00\u9762\uFF0C\n\u8FD9\u4E5F\u662F\u547D\u5427...."
      - "\u5927\u5E08\u5144\uFF0C\u5C01\u59D1\u5A18\u7684\u4E8B\u60C5\n\u6211\u542C\u4E24\u4F4D\u524D\u8F88\u8BF4\u8FC7\u4E86\u3002\n\u6211\u77E5\u9053\u4F60\u5F88\u96BE\u8FC7\uFF0C\n\u77E5\u9053\u4F60\u4E0D\u613F\u79BB\u5F00\u5C01\u59D1\u5A18\uFF0C\n\u53EF\u662F..\u6211\u8FD8\u662F\u6C42\u4F60\u548C\u6211\u56DE\u53BB\uFF0C\n\u7EE7\u4EFB\u5929\u7384\u95E8\u638C\u95E8\u4E00\u804C\uFF0C\n\u4E0D\u53EA\u662F\u6211\uFF0C\u4E8C\u5E08\u5144\u3001\u4E09\u5E08\u5144\n\u548C\u5E08\u5F1F\u4EEC\u4E5F\u603B\u662F\u90FD\u5FF5\u7740\u4F60\uFF0C\n\u5E0C\u671B\u4F60\u80FD\u65E9\u70B9\u89C1\u5230\u4F60....\n\u5927\u5E08\u5144\uFF0C\u548C\u6211\u4E00\u8D77\u56DE\u5FD8\u5251\u5CF0\u5427\uFF1F"
      - "\u5927\u5E08\u5144\uFF0C\u5982\u679C\u4F60\u4E0D\u80AF\u548C\u6211\u56DE\u53BB\uFF0C\n\u6211\u5C31\u5728\u8FD9\u91CC\u966A\u4F60\u3002\n\u8BB0\u5F97\u5C0F\u65F6\u5019\u54B1\u4EEC\u5728\u5F8C\u5C71\u7EC3\u5251\uFF0C\n\u6709\u65F6\u4F60\u7EC3\u53D1\u4E86\u6027\u5B50\uFF0C\n\u76F4\u5230\u5929\u9ED1\u8FD8\u4E0D\u60F3\u56DE\u53BB\uFF0C\n\u90A3\u65F6\u6211\u603B\u662F\u5728\u5C0F\u4E18\u90A3\u91CC\u7B49\u4F60\u3002\n\u6211\u77E5\u9053\u5C31\u7B97\u7B49\u5230\u6708\u4EAE\u5347\u4E0A\u5929\u8FB9\uFF0C\n\u5C31\u7B97\u7B49\u5230\u591C\u67AD\u5F00\u59CB\u5728\u679D\u5934\u53F7\u557C\uFF0C\n\u53EA\u8981\u6211\u4E00\u76F4\u7B49\u4E0B\u53BB\uFF0C\n\u603B\u662F\u4F1A\u7B49\u5230\u4F60\u5026\u6781\u5F52\u6765....\n\u5BF9\u4E0D\u5BF9\uFF1F"
      - "....\u6CA1\u5173\u7CFB\uFF0C\u6211\u613F\u610F\u6162\u6162\u7B49\u3002\n\u7B49\u5230\u6709\u4E00\u5929\u5927\u5E08\u5144\u56DE\u5FC3\u8F6C\u610F\uFF0C\n\u6211\u4EEC\u518D\u50CF\u4EE5\u524D\u4E00\u6837\uFF0C\n\u9AD8\u9AD8\u5174\u5174\u7684\u4E00\u8D77\u56DE\u5FD8\u5251\u5CF0\n....\u8FD9\u6837\u597D\u9EBD\uFF1F"
      - "....\u6211\u660E\u767D\u4E86\u3002\n\u5C0F\u5E08\u59B9\uFF0C\u6211\u548C\u4F60\u56DE\u53BB\u3002"
      - "\u771F..\u771F\u7684\uFF1F\uFF01\n\u5927\u5E08\u5144\uFF0C\u60A8\u7B54\u5E94\u4E86\uFF1F"
      - "\u5C0F\u5E08\u59B9\uFF0C\u6211\u4ECE\u5C0F\u5C31\u627F\u4F60\u7167\u987E\uFF0C\n\u4F60\u4E0D\u4F46\u51E1\u4E8B\u90FD\u4E3A\u6211\u5954\u6CE2\u5F20\u7F57\uFF0C\n\u4E5F\u5E38\u4E3A\u6211\u7684\u83BD\u649E\u65E0\u8C0B\u64CD\u5FC3\uFF0C\n\u95EF\u7978\u65F6\u4E5F\u90FD\u9760\u4F60\n\u5728\u5E08\u7236\u9762\u524D\u8BF4\u60C5\u3002\n\u5BF9\u6211\u6765\u8BF4\uFF0C\n\u4F60\u5C31\u50CF\u6211\u7684\u5C0F\u59B9\u5B50\u4E00\u822C\uFF0C\n\u548C\u771F\u6B63\u7684\u4EB2\u4EBA\u6CA1\u4EC0\u9EBD\u4E24\u6837...."
      - "\u5E08\u5144\uFF0C\n\u4F60\u8FD8\u8BB0\u5F97\u8FD9\u4E9B\u4E8B\u60C5...."
      - "\u5982\u679C\u5E08\u7236\u8FD8\u5065\u5728\u7684\u8BDD\u5C31\u7F62\u4E86\uFF0C\n\u4F46\u5982\u4ECA\u5E08\u7236\u5DF2\u7ECF\u53BB\u4E16\uFF0C\n\u518D\u600E\u9EBD\u6837\u6211\u4E5F\u4E0D\u80FD\u8BA9\u4F60\n\u4E00\u4E2A\u4EBA\u5B64\u82E6\u4F36\u4EC3\u7684\u8FC7\u6D3B\u3002\n\u4EE5\u5F8C\u5C31\u7531\u6211\u6765\u7167\u987E\u4F60\u5427\uFF0C\n\u800C\u5E08\u7236\u8981\u6211\u63A5\u4EFB\u638C\u95E8\u7684\u9057\u547D\uFF0C\n\u6211\u4E5F\u5C31\u606D\u656C\u4E0D\u5982\u4ECE\u547D\u4E86\u3002"
      - "\u5927\u5E08\u5144\uFF0C\u8C22\u8C22\u4F60...."
      - "\u55EF\uFF0C\u771F\u662F\u592A\u597D\u4E86\u3002"
      - "\u6BB7\u5C11\u4FA0\uFF0C\u5F85\u4F60\u5FD9\u5B8C\u4E86\n\u63A5\u4EFB\u638C\u95E8\u7684\u4E8B\u60C5\uFF0C\n\u6211\u518D\u53BB\u6CF0\u5C71\u4F20\u6388\u4F60\u5251\u672F\u5FC3\u6CD5\uFF0C\n\u5230\u65F6\u5019\u53EF\u4E0D\u7531\u5F97\u4F60\u63A8\u8F9E\u4E86\u3002"
      - "\u524D\u8F88\u8FD9\u756A\u597D\u610F\uFF0C\n\u665A\u8F88\u4E5F\u53EA\u6709\u606D\u7136\u9886\u53D7\u4E86\u3002\n..\u7D2B\u67AB\u59D1\u5A18\uFF0C\u665A\u8F88\u5F97\u80FD\u6709\u7A7A\uFF0C\n\u5FC5\u5B9A\u518D\u524D\u53BB\u7AF9\u6797\u6E05\u5C45\u62DC\u8BBF\u3002"
      - "\u6BB7\u516C\u5B50\uFF0C\u9057\u61BE\u7684\u5F88\uFF0C\n\u54B1\u4EEC\u5927\u6982....\n\u4E0D\u4F1A\u518D\u6709\u673A\u4F1A\u89C1\u9762\u4E86\u3002"
      - "\u4E3A....\u4E3A\u4EC0\u9EBD\uFF1F\n\u4F60\u8981\u51FA\u5916\u8FDC\u884C\u9EBD\uFF1F"
      - "\u8FD9\u610F\u601D\u4E5F\u5DEE\u4E0D\u591A\u3002\u6BB7\u5C11\u4FA0\uFF0C\n\u6211\u5C31\u8001\u5B9E\u544A\u8BC9\u4F60\u597D\u4E86\uFF0C\n\u7D2B\u67AB\u539F\u662F\n\u897F\u738B\u6BCD\u5EA7\u4E0B\u7684\u4F8D\u5973\u4E4B\u4E00\uFF0C\n\u56E0\u4E3A\u60F9\u6012\u4E86\u738B\u6BCD\u5A18\u5A18\n\u800C\u53D7\u8D2C\u4E0B\u51E1\u95F4\u4E4B\u7F5A\u3002\n\u7136\u800C\u5386\u7ECF\u8FD9\u4E9B\u6CE2\u6298\u4E4B\u5F8C\uFF0C\n\u738B\u6BCD\u5A18\u5A18\u53C8\u601D\u5FF5\u8D77\u5979\u6765\uFF0C\n\u6240\u4EE5\u53C8\u4E0B\u8BCF\u514D\u53BB\u5979\u7684\u7F6A\u8D23\u3002\n\u8FD9\u56DE\u662F\u5979\u56DE\u5929\u754C\u4E4B\u524D\n\u6700\u5F8C\u4E00\u6B21\u6765\u770B\u4F60\uFF0C\n\u4ECA\u5F8C\u5929\u5730\u4E24\u9694\uFF0C\n\u4F60\u4EEC\u6015\u662F\u6CA1\u6709\u673A\u4F1A\u518D\u89C1\u9762\u4E86\u3002"
      - "\u554A\uFF01\u539F..\u539F\u6765\u5982\u6B64\uFF01\n\u602A\u4E0D\u5F97\u665A\u8F88\u4E00\u76F4\u89C9\u5F97...."
      - "\u6BB7\u516C\u5B50\uFF0C\u5BF9\u4E0D\u8D77\u3002\n\u8FD9\u4E9B\u4E8B\u6211\u4E00\u76F4\u7792\u7740\u4F60\u6CA1\u8BF4\uFF0C\n\u671B\u4F60\u52FF\u602A\u3002"
      - "\u90A3\u91CC\uFF0C\u8FD9\u4E00\u8DEF\u4E0A\u53EF\u662F\n\u5168\u8D56\u4F60\u7684\u777F\u667A\u535A\u8BC6\u6307\u5F15\uFF0C\n\u54B1\u4EEC\u624D\u80FD\u987A\u5229\u5B8C\u6210\u6B64\u884C\u3002\n\u53EA\u662F\u6709\u65F6\u6211\u4E5F\u89C9\u5F97\u4E0D\u53EF\u601D\u8BAE\uFF0C\n\u4E3A\u4F55\u4F60\u77E5\u9053\n\u8FD9\u9EBD\u591A\u5929\u4E0A\u5730\u4E0B\u7684\u4E8B\u60C5\uFF0C\n\u539F\u6765\u8FD9\u4E43\u662F\u5929\u4EBA\u4E4B\u8BC6\uFF0C\n\u6211\u65E9\u8BE5\u60F3\u5230\u7684\u3002\n\u4E0D\u8FC7\u8FD9\u9EBD\u8BF4\u6765\uFF0C\n\u83AB\u975E\u524D\u8F88\u60A8\u4E5F\u662F...."
      - "\u55EF\uFF0C\u5F53\u521D\u5979\u5C31\u662F\u56E0\u4E3A\n\u5728\u738B\u6BCD\u5A18\u5A18\u9762\u524D\u66FF\u6211\u8FA9\u62A4\uFF0C\n\u624D\u4E00\u8D77\u88AB\u8D2C\u4E0B\u51E1\u5C18\uFF0C\n\u7B97\u662F\u53D7\u4E86\u6211\u7684\u65E0\u7AEF\u7275\u7D2F\u3002\n\u5982\u4ECA\u5979\u5F97\u80FD\u56DE\u8FD4\u5929\u5BAB\uFF0C\n\u6211\u7B97\u662F\u4E86\u4E86\u4E00\u6869\u5FC3\u4E8B\uFF0C\n\u5C11\u4E86\u4E00\u6869\u7F6A\u4E1A\uFF0C\n\u4E5F\u4E0D\u6789\u8FD9\u4E9B\u65E5\u5B50\n\u8F9B\u8F9B\u82E6\u82E6\u66FF\u4F60\u4EEC\u5230\u5904\u8DD1\u817F\u4E86\u3002"
      - "\u5982\u4ECA\u8BF8\u4E8B\u5DF2\u4E86\uFF0C\n\u6211\u4E5F\u5F97\u5949\u65E8\u56DE\u5BAB\u4E86\u3002\n\u6BB7\u516C\u5B50\uFF0C\u4E00\u8D77\u5386\u9669\u7684\u65E5\u5B50\uFF0C\n\u6211\u4F1A\u6C38\u8FDC\u8BB0\u5728\u5FC3\u91CC\u3002\n\u5373\u4F7F\u4ECA\u5F8C\u54B1\u4EEC\n\u5206\u5904\u5929\u4E0A\u4EBA\u95F4\uFF0C\n\u7EB5\u7136\u4E0D\u80FD\u771F\u6B63\u805A\u9996\uFF0C\n\u4F46\u65F6\u800C\u7FD8\u9996\u9065\u671B\u3001\n\u5728\u5FC3\u4E2D\u4F20\u601D\u5BC4\u5FF5\uFF0C\n\u6216\u53EF\u7075\u611F\u76F8\u901A\u4E5F\u8BF4\u4E0D\u5B9A\u3002"

    - MsgT:
      - "\u5C31\u9019\u4E9B\u9B54\u7269\u5C31\u60F3\u963B\u6B62\u6211\u5011\uFF0C\n\u528D\u90AA\u90A3\u8001\u9B3C\u672A\u514D\u4E5F\u592A\u5C0F\u770B\u4EBA\u4E86\uFF01"
      - "\u5F9E\u90A3\u528D\u9663\u4E4B\u4E2D\u50B3\u4F86\u5F37\u70C8\u7684\u5996\u6C23\u770B\u4F86\uFF0C\n\u4E8B\u60C5\u4E0D\u6703\u9019\u9EBC\u7C21\u55AE\u5C31\u5B8C\u4E86\u7684\uFF0C\n\u6211\u5011\u9084\u662F\u76E1\u901F\u96E2\u958B\u6BD4\u8F03\u597D\u3002"
      - "\u597D\uFF0C\u77E5\u9053\u4E86\u3002"
      MsgS:
      - "\u5C31\u8FD9\u4E9B\u9B54\u7269\u5C31\u60F3\u963B\u6B62\u6211\u4EEC\uFF0C\n\u5251\u90AA\u90A3\u8001\u9B3C\u672A\u514D\u4E5F\u592A\u5C0F\u770B\u4EBA\u4E86\uFF01"
      - "\u4ECE\u90A3\u5251\u9635\u4E4B\u4E2D\u4F20\u6765\u5F3A\u70C8\u7684\u5996\u6C14\u770B\u6765\uFF0C\n\u4E8B\u60C5\u4E0D\u4F1A\u8FD9\u9EBD\u7B80\u5355\u5C31\u5B8C\u4E86\u7684\uFF0C\n\u6211\u4EEC\u8FD8\u662F\u5C3D\u901F\u79BB\u5F00\u6BD4\u8F83\u597D\u3002"
      - "\u597D\uFF0C\u77E5\u9053\u4E86\u3002"

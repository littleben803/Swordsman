    - MsgT:
      - "\u300C\u5509\uFF0C\u6628\u591C\u53C8\u8CED\u9AB0\u5B50\u628A\u8EAB\u4E0A\u50C5\u5269\u7684\u4E94\u9322\u9280\u5B50\u7D66\u8F38\u5149\u4E86\uFF0C\u9019\u5E7E\u5929\u8981\u600E\u9EBC\u904E\u554A\uFF5E\uFF5E\u300D"
      MsgS:
      - "\u300C\u5509\uFF0C\u6628\u591C\u53C8\u8D4C\u9AB0\u5B50\u628A\u8EAB\u4E0A\u4EC5\u5269\u7684\u4E94\u94B1\u94F6\u5B50\u7ED9\u8F93\u5149\u4E86\uFF0C\u8FD9\u51E0\u5929\u8981\u600E\u9EBD\u8FC7\u554A\uFF5E\uFF5E\u300D"
    - MsgT:
      - "\u300C\u6211\u4E8C\u5F1F\u559D\u9152\u5230\u8208\u982D\u4E0A\uFF0C\u53C8\u958B\u59CB\u5728\u767C\u9152\u760B\u4E86\uFF0C\u5F85\u6703\u4E0D\u8981\u53C8\u7838\u684C\u6454\u7897\u5C31\u597D....\u300D"
      MsgS:
      - "\u300C\u6211\u4E8C\u5F1F\u559D\u9152\u5230\u5174\u5934\u4E0A\uFF0C\u53C8\u5F00\u59CB\u5728\u53D1\u9152\u75AF\u4E86\uFF0C\u5F85\u4F1A\u4E0D\u8981\u53C8\u7838\u684C\u6454\u7897\u5C31\u597D....\u300D"
    - MsgT:
      - "\u300C\u563F\u563F\uFF0C\u9152\u8DB3\u98EF\u98FD\uFF0C\u4FBF\u5FCD\u4E0D\u4F4F\u60F3\u624B\u821E\u8DB3\u8E48\u4E00\u756A....\u300D"
      MsgS:
      - "\u300C\u563F\u563F\uFF0C\u9152\u8DB3\u996D\u9971\uFF0C\u4FBF\u5FCD\u4E0D\u4F4F\u60F3\u624B\u821E\u8DB3\u8E48\u4E00\u756A....\u300D"

      - "\u300C\u6C92\u807D\u904E\u6C88\u5BB6\u5EE2\u5C4B\uFF1F\u90A3\u4F60\u4E00\u5B9A\u662F\u5916\u5730\u4F86\u7684\u4E86\u3002\u6C88\u5BB6\u5EE2\u5C4B\u5C31\u4F4D\u5728\u5BA2\u68E7\u6771\u5317\u65B9\u7684\u5C0F\u5DF7\u9053\u5E95\uFF0C\u623F\u5B50\u65E9\u5DF2\u7834\u5EE2\u8A31\u4E45\uFF0C\u53EA\u56E0\u70BA\u7576\u5E74\u4E00\u6A01\u61F8\u6848\u672A\u7834\uFF0C\u5B98\u5E9C\u9072\u9072\u4E0D\u80AF\u5C07\u4E4B\u62C6\u9664\uFF0C\u8B93\u5927\u5BB6\u5FC3\u88E1\u8001\u662F\u4E0D\u5F88\u5B89\u5BE7\u3002\u300D"
      MsgS:
      - "\u300C\u6CA1\u542C\u8FC7\u6C88\u5BB6\u5E9F\u5C4B\uFF1F\u90A3\u4F60\u4E00\u5B9A\u662F\u5916\u5730\u6765\u7684\u4E86\u3002\u6C88\u5BB6\u5E9F\u5C4B\u5C31\u4F4D\u5728\u5BA2\u6808\u4E1C\u5317\u65B9\u7684\u5C0F\u5DF7\u9053\u5E95\uFF0C\u623F\u5B50\u65E9\u5DF2\u7834\u5E9F\u8BB8\u4E45\uFF0C\u53EA\u56E0\u4E3A\u5F53\u5E74\u4E00\u6869\u60AC\u6848\u672A\u7834\uFF0C\u5B98\u5E9C\u8FDF\u8FDF\u4E0D\u80AF\u5C06\u4E4B\u62C6\u9664\uFF0C\u8BA9\u5927\u5BB6\u5FC3\u91CC\u8001\u662F\u4E0D\u5F88\u5B89\u5B81\u3002\u300D"
    - MsgT:
      - "\u300C\u9019\u4E9B\u6C34\u679C\u770B\u4F86\u6EFF\u4E0D\u932F\u7684\uFF0C\u5C31\u591A\u8CB7\u4E00\u4E9B\u597D\u4E86\u3002\u300D"

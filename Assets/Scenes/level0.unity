    - MsgT:
      - "\u9019\u5C31\u662F\u64CA\u5012\u9132\u9670\u7684\u5BE6\u529B\u55CE\uFF1F\n\u771F\u662F\u9818\u6559\u4E86\uFF0C\n\u54C8\uFF01\u54C8\uFF01\u54C8\uFF01"
      - "\u4F60\u9019\u662F\u4EC0\u9EBC\u610F\u601D\uFF1F"
      - "\u54FC\uFF0C\u5C31\u4F60\u5011\u9019\u4E9B\u672C\u4E8B\uFF0C\n\u9084\u4E0D\u914D\u8B93\u6211\u89AA\u81EA\u51FA\u624B\u3002\n\u51FA\u4F86\u5427\uFF0C\u6211\u7684\u50D5\u4EBA\u5011\uFF01"
      - "\u5C31\u8B93\u9019\u4E9B\u4F86\u966A\u4F60\u5011\u73A9\u73A9\u5427\uFF0C\n\u544A\u8FAD\u4E86\uFF01"
      - "\u771F\u6C23\u4EBA\uFF0C\u5982\u6B64\u7684\u5C0F\u770B\u6211\u5011\uFF01"
      - "\u6C92\u8FA6\u6CD5\uFF0C\u5148\u89E3\u6C7A\u773C\u524D\u7684\n\u6575\u4EBA\u518D\u8AAA\u5427\uFF01"
      MsgS:
      - "\u8FD9\u5C31\u662F\u51FB\u5012\u90F8\u9634\u7684\u5B9E\u529B\u5417\uFF1F\n\u771F\u662F\u9886\u6559\u4E86\uFF0C\n\u54C8\uFF01\u54C8\uFF01\u54C8\uFF01"
      - "\u4F60\u8FD9\u662F\u4EC0\u9EBD\u610F\u601D\uFF1F"
      - "\u54FC\uFF0C\u5C31\u4F60\u4EEC\u8FD9\u4E9B\u672C\u4E8B\uFF0C\n\u8FD8\u4E0D\u914D\u8BA9\u6211\u4EB2\u81EA\u51FA\u624B\u3002\n\u51FA\u6765\u5427\uFF0C\u6211\u7684\u4EC6\u4EBA\u4EEC\uFF01"
      - "\u5C31\u8BA9\u8FD9\u4E9B\u6765\u966A\u4F60\u4EEC\u73A9\u73A9\u5427\uFF0C\n\u544A\u8F9E\u4E86\uFF01"
      - "\u771F\u6C14\u4EBA\uFF0C\u5982\u6B64\u7684\u5C0F\u770B\u6211\u4EEC\uFF01"
      - "\u6CA1\u529E\u6CD5\uFF0C\u5148\u89E3\u51B3\u773C\u524D\u7684\n\u654C\u4EBA\u518D\u8BF4\u5427\uFF01"

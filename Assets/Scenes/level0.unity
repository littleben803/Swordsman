    - MsgT:
      - "....\u600E\u3001\u600E\u9EBC\u4E86\uFF1F"
      - "\u5C0F\u5FC3\uFF0C\n\u9019\u9707\u52D5\u597D\u50CF\u662F\u50B3\u81EA\u9580\u90A3\u88E1\uFF01"
      - "....\u96E3\u9053\u9580\u8981\u958B\u555F\u4E86\uFF1F\uFF01\n\u8A72\u4E0D\u6703...."
      - "\u5E73\u5152\uFF0C\u4F60\u80FD\u5920\u627E\u5230\u9019\u88E1\uFF0C\n\u9084\u628A\u9AD8\u621A\u548C\u6731\u614E\u4E00\u4F75\u6253\u6557\uFF0C\n\u679C\u7136\u4E0D\u6127\u662F\u672C\u5EA7\u4E4B\u5B50\u3002\n\u563F\u563F\uFF0C\u7B49\u86A9\u5C24\u5FA9\u751F\u4E4B\u5F8C...."
      - "\u7239\uFF01\u5B69\u5152....\n\u5B69\u5152\u6700\u5F8C\u4E00\u6B21\u6C42\u60A8\u7F77\u624B\uFF01\n\u5982\u4ECA\u4E00\u5207\u90FD\u9084\u4E0D\u7B97\u592A\u665A...."
      - "\u5929\u6642\u5C07\u81F3\uFF0C\u89D2\u9B42\u9F4A\u5099\uFF0C\n\u672C\u5EA7\u8A08\u756B\u591A\u5E74\u7684\n\u86A9\u5C24\u5FA9\u751F\u5927\u8A08\u6307\u65E5\u53EF\u6210\uFF0C\n\u7109\u6709\u767D\u767D\u653E\u68C4\u4E4B\u7406\uFF1F\n\u5E73\u5152\uFF0C\u96D6\u7136\u7239\u52F8\u670D\u4E0D\u4E86\u4F60\uFF0C\n\u4F46\u7B49\u4F60\u6B7B\u5728\u672C\u5EA7\u528D\u4E0B\u4E4B\u5F8C\uFF0C\n\u672C\u5EA7\u6703\u7ACB\u523B\u8B93\u4F60\u8F49\u751F\u70BA\u9B54\u4EBA\uFF0C\n\u4EE5\u4F60\u7684\u82F1\u8CC7\u624D\u80FD\u7576\u53EF\u6210\u70BA\n\u672C\u5EA7\u7684\u5DE6\u53F3\u624B\uFF0C\u5171\u540C\u6CBB\u7406\n\u86A9\u5C24\u5FA9\u751F\u5F8C\u7684\u5143\u59CB\u65B0\u7D00\uFF0C\n\u5230\u6642\u5019\u54B1\u5011\u4E00\u5BB6\u4E09\u53E3\u548C\u6A02\u878D\u878D\uFF0C\n\u672C\u5EA7\u66F4\u7121\u6240\u6C42...."
      - "....\u4E00\u5BB6\u4E09\u53E3\uFF1F\n\u7239\uFF0C\u83AB\u975E\u60A8\u7684\u610F\u601D\u662F\uFF0C\n\u5F85\u86A9\u5C24\u5FA9\u751F\u4E4B\u5F8C\uFF0C\n\u5A18\u9084\u6703\u518D\u751F\u9084\u904E\u4F86\uFF1F"
      - "\u9019\u500B\u7B49\u4F60\u5011\u5230\u4E86\n\u300E\u9748\u95D5\u6C60\u300F\u4E4B\u5F8C\u518D\u8AAA\u5427\u3002\n\u5728\u9019\u4E4B\u524D\uFF0C\n\u5C31\u5148\u8B93\u9019\u500B\u966A\u4F60\u5011\u73A9\u73A9...."
      - "\u9019\u662F...."
      - "\u672C\u5EA7\u518D\u7D66\u9019\u5169\u500B\n\u4E0D\u4E2D\u7528\u7684\u50A2\u4F19\u4E00\u6B21\u6A5F\u6703\u3002\n\u5E73\u5152\uFF0C\u5982\u679C\u4F60\u5011\u80FD\n\u9806\u5229\u904E\u4E86\u9019\u95DC\uFF0C\u672C\u5EA7\u5728\n\u9580\u5F8C\u7684\u300E\u9748\u95D5\u6C60\u300F\u7B49\u4F60...."
      - "\u7239\uFF01\u7B49\u7B49\uFF01...."
      - "\u6BB7\u5927\u54E5\uFF0C\u591A\u8AAA\u7121\u7528\uFF0C\n\u5148\u89E3\u6C7A\u4E86\u773C\u524D\u9019\u602A\u7269\u518D\u8AAA\uFF01"
      - "....\u55EF\uFF01"
      - "\u53EF\u6068....\n\u5DF2\u7D93\u904E\u4E86\u6578\u767E\u5E74\u6BBA\u622E\u751F\u6DAF\u7684\u4FFA\uFF0C\n\u7ADF\u7136\u6703\u9019\u6A23\u8F38\u5728\u4F60\u5011\u7684\u624B\u88E1.."
      - "\u5514\uFF01\uFF01\u6211....\u6211\u9084\u4E0D\u60F3\u6B7B....\n\u76DF\u4E3B....\u6551\u6551\u6211\u554A......"
      MsgS:
      - "....\u600E\u3001\u600E\u9EBD\u4E86\uFF1F"
      - "\u5C0F\u5FC3\uFF0C\n\u8FD9\u9707\u52A8\u597D\u50CF\u662F\u4F20\u81EA\u95E8\u90A3\u91CC\uFF01"
      - "....\u96BE\u9053\u95E8\u8981\u5F00\u542F\u4E86\uFF1F\uFF01\n\u8BE5\u4E0D\u4F1A...."
      - "\u5E73\u513F\uFF0C\u4F60\u80FD\u591F\u627E\u5230\u8FD9\u91CC\uFF0C\n\u8FD8\u628A\u9AD8\u621A\u548C\u6731\u614E\u4E00\u5E76\u6253\u8D25\uFF0C\n\u679C\u7136\u4E0D\u6127\u662F\u672C\u5EA7\u4E4B\u5B50\u3002\n\u563F\u563F\uFF0C\u7B49\u86A9\u5C24\u590D\u751F\u4E4B\u5F8C...."
      - "\u7239\uFF01\u5B69\u513F....\n\u5B69\u513F\u6700\u5F8C\u4E00\u6B21\u6C42\u60A8\u7F62\u624B\uFF01\n\u5982\u4ECA\u4E00\u5207\u90FD\u8FD8\u4E0D\u7B97\u592A\u665A...."
      - "\u5929\u65F6\u5C06\u81F3\uFF0C\u89D2\u9B42\u9F50\u5907\uFF0C\n\u672C\u5EA7\u8BA1\u753B\u591A\u5E74\u7684\n\u86A9\u5C24\u590D\u751F\u5927\u8BA1\u6307\u65E5\u53EF\u6210\uFF0C\n\u7109\u6709\u767D\u767D\u653E\u5F03\u4E4B\u7406\uFF1F\n\u5E73\u513F\uFF0C\u867D\u7136\u7239\u529D\u670D\u4E0D\u4E86\u4F60\uFF0C\n\u4F46\u7B49\u4F60\u6B7B\u5728\u672C\u5EA7\u5251\u4E0B\u4E4B\u5F8C\uFF0C\n\u672C\u5EA7\u4F1A\u7ACB\u523B\u8BA9\u4F60\u8F6C\u751F\u4E3A\u9B54\u4EBA\uFF0C\n\u4EE5\u4F60\u7684\u82F1\u8D44\u624D\u80FD\u5F53\u53EF\u6210\u4E3A\n\u672C\u5EA7\u7684\u5DE6\u53F3\u624B\uFF0C\u5171\u540C\u6CBB\u7406\n\u86A9\u5C24\u590D\u751F\u5F8C\u7684\u5143\u59CB\u65B0\u7EAA\uFF0C\n\u5230\u65F6\u5019\u54B1\u4EEC\u4E00\u5BB6\u4E09\u53E3\u548C\u4E50\u878D\u878D\uFF0C\n\u672C\u5EA7\u66F4\u65E0\u6240\u6C42...."
      - "....\u4E00\u5BB6\u4E09\u53E3\uFF1F\n\u7239\uFF0C\u83AB\u975E\u60A8\u7684\u610F\u601D\u662F\uFF0C\n\u5F85\u86A9\u5C24\u590D\u751F\u4E4B\u5F8C\uFF0C\n\u5A18\u8FD8\u4F1A\u518D\u751F\u8FD8\u8FC7\u6765\uFF1F"
      - "\u8FD9\u4E2A\u7B49\u4F60\u4EEC\u5230\u4E86\n\u300E\u7075\u9619\u6C60\u300F\u4E4B\u5F8C\u518D\u8BF4\u5427\u3002\n\u5728\u8FD9\u4E4B\u524D\uFF0C\n\u5C31\u5148\u8BA9\u8FD9\u4E2A\u966A\u4F60\u4EEC\u73A9\u73A9...."

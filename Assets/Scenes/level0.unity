      - ......
      - "....\u5E08\u7236\uFF0C\u5F1F\u5B50....\u5F1F\u5B50\u8FD8\u662F\u4E0B\u4E0D\u4E86\u624B\u3002"
      - "\u4E0B\u4E0D\u4E86\u624B\uFF1F\n\u4F60\u8EAB\u4E3A\u6211\u5EA7\u4E0B\u7684\u5927\u5F1F\u5B50\uFF0C\n\u5C06\u6765\u8981\u7EE7\u4EFB\u5929\u7384\u95E8\u638C\u95E8\u4E4B\u4F4D\uFF0C\n\u600E\u53EF\u5982\u6B64\u5584\u6076\u4E0D\u5206\uFF1F\n\u83AB\u5FD8\u6211\u5929\u7384\u95E8\u5411\u4EE5\u9664\u5996\u4F0F\u9B54\u4E3A\u5DF1\u4EFB\n\u4F60\u82E5\u4E0D\u6562\u5BF9\u5996\u9B54\u4E0B\u624B\uFF0C\n\u4FBF\u6CA1\u6709\u8D44\u683C\u5F85\u5728\u6211\u95E8\u4E0B\uFF01\uFF01"
      - "\u5E08\u7236\uFF0C\u5F1F\u5B50\u660E\u767D\u5996\u9B54\u53EF\u6068\u53EF\u618E\uFF0C\n\u7136\u800C\u7260\u4EEC\u51FA\u5916\u4F24\u4EBA\uFF0C\n\u53EA\u662F\u4E3A\u4E86\u586B\u9971\u809A\u5B50\u3001\u7E41\u884D\u5F8C\u4EE3\uFF0C\n\u548C\u6211\u4EEC\u5E76\u65E0\u4E8C\u81F4\u3002\n\u6211\u4EEC\u82E5\u4E0D\u601D\u4E0E\u5996\u9B54\u548C\u5E73\u76F8\u5904\u4E4B\u9053\uFF0C\n\u5149\u662F\u4E00\u6627\u6EE5\u6740\u5996\u9B54\uFF0C\n\u8FD9\u4EC7\u6068\u53EA\u4F1A\u8D8A\u7ED3\u8D8A\u6DF1\uFF0C\n\u6C38\u8FDC\u4E5F\u5316\u89E3\u4E0D\u5F00\u3002"
      - "\u54FC\uFF0C\u4F60\u5012\u6559\u8BAD\u8D77\u6211\u6765\u4E86\uFF01"
      - "\u5F1F\u5B50\u4E0D\u6562\u3002\n\u53EA\u662F....\u81EA\u4ECE\u51FA\u8FD9\u8D9F\u95E8\u4EE5\u6765\uFF0C\n\u5F1F\u5B50\u4FBF\u4E00\u76F4\u5728\u601D\u8003\u8FD9\u4EF6\u4E8B\u60C5\uFF0C\n\u671F\u80FD\u60F3\u51FA\u4E24\u5168\u5176\u7F8E\u4E4B\u89E3\u51B3\u65B9\u6CD5..."
      - "\u54FC\uFF01\n\u4EBA\u9B54\u76F8\u4E89\uFF0C\u59CB\u65BC\u592A\u53E4\uFF0C\n\u81F3\u4ECA\u4ECD\u4E89\u6597\u672A\u606F\u3002\n\u5343\u5E74\u6765\uFF0C\n\u591A\u5C11\u524D\u5723\u5148\u8D24\u89E3\u51B3\u4E0D\u4E86\u7684\u95EE\u9898\uFF0C\n\u51ED\u4F60\u5C31\u60F3\u5F97\u51FA\u6765\uFF1F"
      - "....\u5F1F\u5B50\u611A\u6627\u65E0\u77E5\uFF0C\u5984\u81EA\u4E3B\u5F20\uFF0C\n\u8FD8\u671B\u5E08\u7236\u606F\u6012\u3002"
      - "....\u5E08\u7236\uFF01"
      - "\u7F62\u4E86\uFF01\n\u6211\u5929\u7384\u95E8\u4E4B\u4E2D\u6CA1\u6709\u540C\u60C5\u5996\u9B54\u4E4B\u4EBA\uFF0C\n\u8BA9\u4F60\u8FD9\u79CD\u4EBA\u5F85\u5728\u672C\u95E8\uFF0C\n\u53EA\u4F1A\u8BA9\u540C\u9053\u95E8\u8D3B\u7B11\u5927\u65B9\u3002\n\u4F60\u5DF2\u4E0D\u662F\u5929\u7384\u95E8\u7684\u4EBA\u4E86\uFF0C\n\u8FD9\u4E8C\u5341\u5E74\u6765\u517B\u80B2\u4E0E\u6559\u5BFC\u7684\u529F\u592B\uFF0C\n\u5C31\u5F53\u4F5C\u662F\u6211\u778E\u4E86\u773C\u7F62\uFF01"
      - "\u5E08..\u5E08\u7236\uFF0C\u60A8\u6B64\u8A00...."
      - "\u56DE\u5230\u5929\u8FDC\u5CF0\u4E4B\u5F8C\uFF0C\n\u4F60\u5C31\u6536\u62FE\u81EA\u5DF1\u7684\u4E1C\u897F\u4E0B\u5C71\u5427\uFF01\n\u6211\u8BDD\u8BF4\u4E86\u5C31\u7B97\uFF0C\n\u4F60\u4E0D\u5FC5\u518D\u6765\u591A\u8BF4\u6C42\u60C5\u3002"
      - "\u5E08\u7236\uFF01\u5F1F\u5B50......"
      - "\u4F60\u5DF2\u4E0D\u662F\u5929\u7384\u95E8\u7684\u5F1F\u5B50\u4E86\uFF0C\n\u4ECA\u5F8C\u8981\u4E0D\u8981\u5E87\u62A4\u5996\u9B54\u662F\u4F60\u7684\u4E8B\u60C5\uFF0C\n\u4F46\u6559\u649E\u5728\u6211\u624B\u91CC\uFF0C\n\u521A\u624D\u8FD9\u4E9B\u5B7D\u79CD\u5C31\u662F\u4F60\u7684\u699C\u6837\uFF01"
      - "\u5E08\u7236\uFF01......\u5509\uFF01"
      - "\u8FD9\u8FD8\u7528\u5F97\u7740\u591A\u8D39\u5FC3\u795E\u9EBD\uFF01\n\u77A7\u8FD9\u6D1E\u7A9F\u904D\u5730\u6B8B\u9AA8\uFF0C\n\u5206\u660E\u662F\u906D\u5996\u9B54\u6BD2\u624B\u7684\u767E\u59D3\u9057\u9AB8\u3002\n\u6B64\u7B49\u6BEB\u65E0\u4EBA\u6027\u7684\u5165\u9B54\u5996\u7269\uFF0C\n\u884C\u4E8B\u5C82\u6709\u4E00\u822C\u5FAA\u89C4\u9053\u7406\u53EF\u8A00\uFF1F\n\u4E0D\u8FC7\u7ECF\u4F60\u8FD9\u9EBD\u4E00\u8BF4\uFF0C\n\u6211\u5012\u5F97\u77A7\u77A7\u5230\u5E95\u6709\u4E9B\u4EC0\u9EBD\u53E4\u602A\uFF01\n\u5E73\u513F\uFF0C\u5FEB\u968F\u6211\u8FDB\u6D1E\u53BB\uFF01"
      - "\u662F\uFF01"
      - "\u5C0F\u5E08\u59B9\uFF0C\u9001\u5230\u8FD9\u91CC\u5C31\u884C\u4E86\u3002\n\u8981\u662F\u5E08\u7236\u77E5\u9053\u4E86\u8FD9\u4EF6\u4E8B\uFF0C\n\u56DE\u5934\u5B9A\u4F1A\u628A\u4F60\u75DB\u9A82\u4E00\u987F\u3002"
      - "\u4EBA\u5BB6\u624D\u4E0D\u5728\u4E4E\u5462\uFF01\n\u90FD\u662F\u7239\u81EA\u5DF1\u83AB\u540D\u5176\u5999\uFF0C\n\u4E0D\u5206\u7531\u8BF4\u7684\u5C31\u8981\u628A\u5927\u5E08\u5144\u8D76\u51FA\u95E8\uFF0C\n\u4E5F\u4E0D\u542C\u4EBA\u529D\u3002\n\u7239\u4E5F\u4E0D\u60F3\u60F3\uFF0C\n\u9664\u4E86\u5927\u5E08\u5144\u4F60\u8FD9\u4E2A\u9AD8\u5F92\u4EE5\u5916\uFF0C\n\u6211\u4EEC\u5929\u7384\u95E8\u8FD8\u6709\u4EC0\u9EBD\u6210\u6750\u7684\u5F1F\u5B50\uFF0C\n\u8FD9\u56DE\u51FA\u95E8\u5E08\u5F1F\u4EEC\u4F55\u4EE5\u4F24\u4EA1\u60E8\u91CD\uFF0C\n\u4ED6\u5E94\u8BE5\u5FC3\u77E5\u809A\u660E\u624D\u662F\u3002"
      - "\u5C0F\u5E08\u59B9\uFF0C\u5E08\u7236\u884C\u4E8B\u81EA\u6709\u4ED6\u7684\u8003\u91CF\uFF0C\n\u90FD\u602A\u6211\u5E73\u65E5\u559C\u6B22\u5984\u53D1\u8A00\u8BED\uFF0C\n\u624D\u4F1A\u8FD9\u822C\u81EA\u4F5C\u81EA\u53D7....."
      - ".....\u522B\u8BF4\u4E86\uFF0C\u5927\u5E08\u5144\u3002\n\u4F60\u5C31\u5F53\u8FD9\u56DE\u662F\u51FA\u8D9F\u8FDC\u95E8\u6E38\u5C71\u73A9\u6C34\uFF0C\n\u6211\u4E00\u5B9A\u60F3\u529E\u6CD5\u529D\u7239\u6536\u56DE\u6210\u547D\u3002"
      - "\u5C0F\u5E08\u59B9\uFF0C\u591A\u8C22\u4F60\u4E86\u3002\n\u5927\u5E08\u5144\u4EE5\u5F8C\u6CA1\u529E\u6CD5\u7167\u987E\u4F60\u65F6\uFF0C\n\u95E8\u5185\u8BF8\u591A\u4E8B\u52A1\uFF0C\n\u4F60\u53EF\u5F97\u5E2E\u5E08\u7236\u6253\u70B9\u6253\u70B9\u3002"
      - "\u597D\u7684\uFF0C\u5927\u5E08\u5144\u3002\n\u4F60\u5728\u5916\u6E38\u5386\u53EF\u4E5F\u4E0D\u8981\u8DD1\u5F97\u592A\u8FDC\uFF0C\n\u4E00\u6709\u597D\u6D88\u606F\u6211\u5C31\u4F1A\u9063\u5E08\u5F1F\u4EEC\u53BB\u901A\u77E5\u4F60\u3002\n\u53EF\u522B\u73A9\u660F\u5934\u4E86\u54E6\uFF01"
      - "\u55EF\uFF0C\u6211\u77E5\u9053\u3002"
      - "\u5929\u8272\u4E5F\u4E0D\u65E9\u4E86\uFF0C\n\u5927\u5E08\u5144\u4F60\u5C31\u8D76\u5FEB\u4E0B\u5C71\u5427\u3002\n\u6211\u4E0D\u56DE\u53BB\u7684\u8BDD\uFF0C\n\u53EA\u6015\u7239\u4E5F\u8981\u8D77\u7591\u5FC3\u4E86\u3002"
      - "\u90A3\u54B1\u4EEC\u5C31\u5728\u8FD9\u91CC\u522B\u8FC7\u5566\uFF01\n\u5C0F\u5E08\u59B9\uFF0C\u4F60\u591A\u4FDD\u91CD\u3002"
      - "\u5927\u5E08\u5144\uFF0C\u4F60\u4E5F\u591A\u4FDD\u91CD\u3002\n"
      - "\u81EA\u5E7C\u5728\u5929\u8FDC\u5CF0\u957F\u5927\uFF0C\n\u5374\u5FFD\u7136\u95F4\u88AB\u9010\u51FA\u95E8\u5899\uFF0C\n\u53EB\u6211\u4E00\u65F6\u4E4B\u95F4\uFF0C\u4F55\u53BB\u4F55\u4ECE...."
      - "\u5929\u4E0B\u4E4B\u5927\uFF0C\n\u4F55\u5904\u662F\u6211\u5BB9\u8EAB\u4E4B\u5904\uFF1F......"
      - "\u90A3....\u90A3\u6211\u8D70\u4E86......"

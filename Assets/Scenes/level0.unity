    - MsgT:
      - "\u78BA\u5B9A\u8981\u5C31\u6B64\u96E2\u57CE\u51FA\u767C\u55CE\uFF1F"
      - "\u662F\u7684\uFF0C\u5C31\u6B64\u96E2\u57CE\u51FA\u767C\u3002"
      - "\u4E0D\uFF0C\u518D\u505C\u7559\u4E00\u6703\u5152\u597D\u4E86\u3002"
      - "\u597D\uFF0C\u90A3\u5C31\u51FA\u767C\u5427\uFF01"
      - "\u65E2\u662F\u5982\u6B64\uFF0C\u5C31\u591A\u5F85\u4E00\u6703\u5152\u597D\u4E86\u3002"
      MsgS:
      - "\u786E\u5B9A\u8981\u5C31\u6B64\u79BB\u57CE\u51FA\u53D1\u5417\uFF1F"
      - "\u662F\u7684\uFF0C\u5C31\u6B64\u79BB\u57CE\u51FA\u53D1\u3002"
      - "\u4E0D\uFF0C\u518D\u505C\u7559\u4E00\u4F1A\u513F\u597D\u4E86\u3002"
      - "\u597D\uFF0C\u90A3\u5C31\u51FA\u53D1\u5427\uFF01"
      - "\u65E2\u662F\u5982\u6B64\uFF0C\u5C31\u591A\u5F85\u4E00\u4F1A\u513F\u597D\u4E86\u3002"

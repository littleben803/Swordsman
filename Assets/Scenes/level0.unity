      - "\u4F60\u4F5C\u5F97\u5F88\u597D\uFF0C\n\u4E0D\u6127\u662F\u795E\u528D\u547D\u5B9A\u7684\u7E7C\u627F\u8005\u3002\n\u5728\u528D\u90AA\u4F0F\u8A85\u4E4B\u5F8C\uFF0C\n\u4E0A\u9762\u90A3\u908A\u7D93\u6211\u5831\u8A0A\u65A1\u65CB\uFF0C\n\u5DF2\u7D93\u628A\u5341\u842C\u5929\u5175\u64A4\u56DE\u8FCE\u5929\u9580\uFF0C\n\u4ECA\u5F8C\u4EBA\u9593\u7576\u53EF\u518D\u4FDD\u9577\u5E74\u592A\u5E73\uFF0C\n\u9019\u5168\u591A\u8667\u4F60\u4E86\u3002"
      - "....\u524D\u8F29\u904E\u734E\u4E86\uFF0C\n\u9019\u7D55\u975E\u665A\u8F29\u4E00\u4EBA\u4E4B\u529F\u3002\n\u665A\u8F29..\u665A\u8F29\u4EC0\u9EBC\u4E5F\u6C92\u4F5C\uFF0C\n\u4EC0\u9EBC\u4E5F\u4F5C\u4E0D\u4E86\u3002\n\u665A\u8F29\u8A3B\u5B9A\u8207\u795E\u528D\u7121\u7DE3\uFF0C\n\u6240\u8B02\u795E\u528D\u7E7C\u627F\u8005\u4E91\u4E91\uFF0C\n\u8ACB\u524D\u8F29\u4ECA\u5F8C\u518D\u4E5F\u4F11\u63D0...."
      - "\u53EA\u8981\u5FC3\u4E2D\u6709\u5FF5\uFF0C\u4F55\u61FC\u624B\u4E2D\u7121\u528D\uFF1F\n\u4ECA\u5F8C\u6211\u5C07\u7834\u9B54\u8207\u5FA1\u528D\u5FC3\u6CD5\u50B3\u4F60\uFF0C\n\u518D\u7531\u4F60\u6D41\u50B3\u65BC\u4EBA\u9593\u8AF8\u6CD5\u528D\u6D3E\uFF0C\n\u5982\u6B64\u9060\u52DD\u55AE\u7368\u4E00\u67C4\u795E\u528D\u4E4B\u5A01\u3002\n\u6253\u8D77\u7CBE\u795E\u4F86\uFF0C\n\u4ECA\u5F8C\u9084\u6709\u8A31\u591A\u4E8B\u8981\u9760\u4F60\u4F86\u505A\uFF0C\n\u5149\u662F\u5728\u6B64\u4F0F\u5893\u795E\u50B7\uFF0C\n\u90A3\u53EF\u4E0D\u662F\u7537\u5B50\u6F22\u8A72\u4F5C\u7684\u4E8B\u60C5\u3002"
      - "....\u524D\u8F29\u7684\u4E00\u756A\u597D\u610F\uFF0C\n\u665A\u8F29\u5FC3\u9818\u4E86\u3002\n\u53EA\u662F\u665A\u8F29\u5DF2\u7D93\u5FC3\u6B7B\u65B7\u5FF5\uFF0C\n\u4ECA\u5F8C\u53EA\u60F3\u5728\u6B64\u5893\u4E4B\u524D\n\u5EA6\u904E\u9918\u751F.....\n\u9084\u662F\u8ACB\u524D\u8F29\u53E6\u627E\u9AD8\u660E\u5427\uFF01"
      - "\u6BB7\u516C\u5B50\uFF0C\n\u4F60\u4E0D\u80FD\u5C31\u9019\u6A23\u6D88\u6C88\u4E0B\u53BB...."
      - "\u6211\u65E9\u5C31\u6599\u5230\u4F60\u6703\u9019\u9EBC\u56DE\u7B54....\n\u6BB7\u5C11\u4FE0\uFF0C\u4E8B\u5BE6\u4E0A\n\u6211\u9084\u5E36\u4E86\u53E6\u4E00\u500B\u4EBA\u4F86\u770B\u4F60\u3002"
      - "\u61C9\u59D1\u5A18\uFF0C\u59B3\u53EF\u4EE5\u51FA\u4F86\u4E86\u3002"
      - "\u662F\u3002"
      - "....\u5C0F\u5E2B\u59B9\uFF1F\uFF01\n\u59B3\u600E\u9EBC\u4F86\u4E86\uFF1F\n\u70BA\u4F55\u4E00\u8EAB\u7E1E\u7D20\uFF1F\n\u96E3\u9053\u5E2B\u7236\u4ED6...."
      - "\u7239\u81EA\u90A3\u6B21\u5F9E\u78D0\u5929\u5DBA\u56DE\u4F86\u5F8C\n\u5C31\u4E00\u75C5\u4E0D\u8D77\uFF0C\u85E5\u77F3\u7F54\u6548\uFF0C\n\u534A\u500B\u6708\u4E4B\u524D\u5C31\u53BB\u4E16\u4E86\u3002\n\u4ED6\u5728\u75C5\u4E2D\u4E00\u76F4\u5FF5\u8457\u5927\u5E2B\u5144\uFF0C\n\u8AAA\u4ED6\u4E0D\u4F46\u7576\u5E74\u5C0D\u4E0D\u8D77\u4F60\u7239\uFF0C\n\u4E5F\u5C0D\u4E0D\u8D77\u4E00\u76F4\u606D\u8B39\u5949\u5E2B\u7684\u4F60\u3002\n\u7239\u5F88\u5F8C\u6094\u7576\u521D\n\u5C07\u5927\u5E2B\u5144\u9010\u51FA\u5E2B\u9580\u4E00\u4E8B\uFF0C\n\u5728\u81E8\u7D42\u4E4B\u524D\u4E00\u518D\u4EA4\u4EE3\u6211\uFF0C\n\u4E00\u5B9A\u8981\u628A\u5927\u5E2B\u5144\u627E\u56DE\u4F86\n\u7E7C\u4EFB\u638C\u9580\u4E4B\u4F4D\uFF0C\n\u4E0D\u7136\u4ED6\u5728\u5730\u4E0B\u4E5F\u4E0D\u6703\u5B89\u5FC3...."
      - "\u5E2B\u7236....\u5E2B\u7236\u7D42\u7A76\u662F\u9858\u610F\n\u63A5\u7D0D\u6211\u56DE\u672C\u9580\u4E86\u3002\n\u53EA\u53EF\u60DC\u6211\u6C92\u80FD\u4F86\u5F97\u53CA\n\u898B\u4ED6\u8001\u4EBA\u5BB6\u6700\u5F8C\u4E00\u9762\uFF0C\n\u9019\u4E5F\u662F\u547D\u5427...."
      - "\u5927\u5E2B\u5144\uFF0C\u5C01\u59D1\u5A18\u7684\u4E8B\u60C5\n\u6211\u807D\u5169\u4F4D\u524D\u8F29\u8AAA\u904E\u4E86\u3002\n\u6211\u77E5\u9053\u4F60\u5F88\u96E3\u904E\uFF0C\n\u77E5\u9053\u4F60\u4E0D\u9858\u96E2\u958B\u5C01\u59D1\u5A18\uFF0C\n\u53EF\u662F..\u6211\u9084\u662F\u6C42\u4F60\u548C\u6211\u56DE\u53BB\uFF0C\n\u7E7C\u4EFB\u5929\u7384\u9580\u638C\u9580\u4E00\u8077\uFF0C\n\u4E0D\u53EA\u662F\u6211\uFF0C\u4E8C\u5E2B\u5144\u3001\u4E09\u5E2B\u5144\n\u548C\u5E2B\u5F1F\u5011\u4E5F\u7E3D\u662F\u90FD\u5FF5\u8457\u4F60\uFF0C\n\u5E0C\u671B\u4F60\u80FD\u65E9\u9EDE\u898B\u5230\u4F60....\n\u5927\u5E2B\u5144\uFF0C\u548C\u6211\u4E00\u8D77\u56DE\u5FD8\u528D\u5CF0\u5427\uFF1F"
      - "\u5927\u5E2B\u5144\uFF0C\u5982\u679C\u4F60\u4E0D\u80AF\u548C\u6211\u56DE\u53BB\uFF0C\n\u6211\u5C31\u5728\u9019\u88E1\u966A\u4F60\u3002\n\u8A18\u5F97\u5C0F\u6642\u5019\u54B1\u5011\u5728\u5F8C\u5C71\u7DF4\u528D\uFF0C\n\u6709\u6642\u4F60\u7DF4\u767C\u4E86\u6027\u5B50\uFF0C\n\u76F4\u5230\u5929\u9ED1\u9084\u4E0D\u60F3\u56DE\u53BB\uFF0C\n\u90A3\u6642\u6211\u7E3D\u662F\u5728\u5C0F\u4E18\u90A3\u88E1\u7B49\u4F60\u3002\n\u6211\u77E5\u9053\u5C31\u7B97\u7B49\u5230\u6708\u4EAE\u5347\u4E0A\u5929\u908A\uFF0C\n\u5C31\u7B97\u7B49\u5230\u591C\u689F\u958B\u59CB\u5728\u679D\u982D\u865F\u557C\uFF0C\n\u53EA\u8981\u6211\u4E00\u76F4\u7B49\u4E0B\u53BB\uFF0C\n\u7E3D\u662F\u6703\u7B49\u5230\u4F60\u5026\u6975\u6B78\u4F86....\n\u5C0D\u4E0D\u5C0D\uFF1F"
      - "....\u6C92\u95DC\u4FC2\uFF0C\u6211\u9858\u610F\u6162\u6162\u7B49\u3002\n\u7B49\u5230\u6709\u4E00\u5929\u5927\u5E2B\u5144\u56DE\u5FC3\u8F49\u610F\uFF0C\n\u6211\u5011\u518D\u50CF\u4EE5\u524D\u4E00\u6A23\uFF0C\n\u9AD8\u9AD8\u8208\u8208\u7684\u4E00\u8D77\u56DE\u5FD8\u528D\u5CF0\n....\u9019\u6A23\u597D\u9EBC\uFF1F"
      - "....\u6211\u660E\u767D\u4E86\u3002\n\u5C0F\u5E2B\u59B9\uFF0C\u6211\u548C\u59B3\u56DE\u53BB\u3002"
      - "\u771F..\u771F\u7684\uFF1F\uFF01\n\u5927\u5E2B\u5144\uFF0C\u60A8\u7B54\u61C9\u4E86\uFF1F"
      - "\u5C0F\u5E2B\u59B9\uFF0C\u6211\u5F9E\u5C0F\u5C31\u627F\u59B3\u7167\u9867\uFF0C\n\u59B3\u4E0D\u4F46\u51E1\u4E8B\u90FD\u70BA\u6211\u5954\u6CE2\u5F35\u7F85\uFF0C\n\u4E5F\u5E38\u70BA\u6211\u7684\u83BD\u649E\u7121\u8B00\u64CD\u5FC3\uFF0C\n\u95D6\u798D\u6642\u4E5F\u90FD\u9760\u59B3\n\u5728\u5E2B\u7236\u9762\u524D\u8AAA\u60C5\u3002\n\u5C0D\u6211\u4F86\u8AAA\uFF0C\n\u59B3\u5C31\u50CF\u6211\u7684\u5C0F\u59B9\u5B50\u4E00\u822C\uFF0C\n\u548C\u771F\u6B63\u7684\u89AA\u4EBA\u6C92\u4EC0\u9EBC\u5169\u6A23...."
      - "\u5E2B\u5144\uFF0C\n\u4F60\u9084\u8A18\u5F97\u9019\u4E9B\u4E8B\u60C5...."
      - "\u5982\u679C\u5E2B\u7236\u9084\u5065\u5728\u7684\u8A71\u5C31\u7F77\u4E86\uFF0C\n\u4F46\u5982\u4ECA\u5E2B\u7236\u5DF2\u7D93\u53BB\u4E16\uFF0C\n\u518D\u600E\u9EBC\u6A23\u6211\u4E5F\u4E0D\u80FD\u8B93\u59B3\n\u4E00\u500B\u4EBA\u5B64\u82E6\u4F36\u4EC3\u7684\u904E\u6D3B\u3002\n\u4EE5\u5F8C\u5C31\u7531\u6211\u4F86\u7167\u9867\u59B3\u5427\uFF0C\n\u800C\u5E2B\u7236\u8981\u6211\u63A5\u4EFB\u638C\u9580\u7684\u907A\u547D\uFF0C\n\u6211\u4E5F\u5C31\u606D\u656C\u4E0D\u5982\u5F9E\u547D\u4E86\u3002"
      - "\u5927\u5E2B\u5144\uFF0C\u8B1D\u8B1D\u4F60...."
      - "\u55EF\uFF0C\u771F\u662F\u592A\u597D\u4E86\u3002"
      - "\u6BB7\u5C11\u4FE0\uFF0C\u5F85\u4F60\u5FD9\u5B8C\u4E86\n\u63A5\u4EFB\u638C\u9580\u7684\u4E8B\u60C5\uFF0C\n\u6211\u518D\u53BB\u6CF0\u5C71\u50B3\u6388\u4F60\u528D\u8853\u5FC3\u6CD5\uFF0C\n\u5230\u6642\u5019\u53EF\u4E0D\u7531\u5F97\u4F60\u63A8\u8FAD\u4E86\u3002"
      - "\u524D\u8F29\u9019\u756A\u597D\u610F\uFF0C\n\u665A\u8F29\u4E5F\u53EA\u6709\u606D\u7136\u9818\u53D7\u4E86\u3002\n..\u7D2B\u6953\u59D1\u5A18\uFF0C\u665A\u8F29\u5F97\u80FD\u6709\u7A7A\uFF0C\n\u5FC5\u5B9A\u518D\u524D\u53BB\u7AF9\u6797\u6E05\u5C45\u62DC\u8A2A\u3002"
      - "\u6BB7\u516C\u5B50\uFF0C\u907A\u61BE\u7684\u5F88\uFF0C\n\u54B1\u5011\u5927\u6982....\n\u4E0D\u6703\u518D\u6709\u6A5F\u6703\u898B\u9762\u4E86\u3002"
      - "\u70BA....\u70BA\u4EC0\u9EBC\uFF1F\n\u59B3\u8981\u51FA\u5916\u9060\u884C\u9EBC\uFF1F"
      - "\u9019\u610F\u601D\u4E5F\u5DEE\u4E0D\u591A\u3002\u6BB7\u5C11\u4FE0\uFF0C\n\u6211\u5C31\u8001\u5BE6\u544A\u8A34\u4F60\u597D\u4E86\uFF0C\n\u7D2B\u6953\u539F\u662F\n\u897F\u738B\u6BCD\u5EA7\u4E0B\u7684\u4F8D\u5973\u4E4B\u4E00\uFF0C\n\u56E0\u70BA\u60F9\u6012\u4E86\u738B\u6BCD\u5A18\u5A18\n\u800C\u53D7\u8CB6\u4E0B\u51E1\u9593\u4E4B\u7F70\u3002\n\u7136\u800C\u6B77\u7D93\u9019\u4E9B\u6CE2\u6298\u4E4B\u5F8C\uFF0C\n\u738B\u6BCD\u5A18\u5A18\u53C8\u601D\u5FF5\u8D77\u5979\u4F86\uFF0C\n\u6240\u4EE5\u53C8\u4E0B\u8A54\u514D\u53BB\u5979\u7684\u7F6A\u8CAC\u3002\n\u9019\u56DE\u662F\u5979\u56DE\u5929\u754C\u4E4B\u524D\n\u6700\u5F8C\u4E00\u6B21\u4F86\u770B\u59B3\uFF0C\n\u4ECA\u5F8C\u5929\u5730\u5169\u9694\uFF0C\n\u4F60\u5011\u6015\u662F\u6C92\u6709\u6A5F\u6703\u518D\u898B\u9762\u4E86\u3002"
      - "\u554A\uFF01\u539F..\u539F\u4F86\u5982\u6B64\uFF01\n\u602A\u4E0D\u5F97\u665A\u8F29\u4E00\u76F4\u89BA\u5F97...."
      - "\u6BB7\u516C\u5B50\uFF0C\u5C0D\u4E0D\u8D77\u3002\n\u9019\u4E9B\u4E8B\u6211\u4E00\u76F4\u779E\u8457\u4F60\u6C92\u8AAA\uFF0C\n\u671B\u4F60\u52FF\u602A\u3002"
      - "\u90A3\u88E1\uFF0C\u9019\u4E00\u8DEF\u4E0A\u53EF\u662F\n\u5168\u8CF4\u59B3\u7684\u777F\u667A\u535A\u8B58\u6307\u5F15\uFF0C\n\u54B1\u5011\u624D\u80FD\u9806\u5229\u5B8C\u6210\u6B64\u884C\u3002\n\u53EA\u662F\u6709\u6642\u6211\u4E5F\u89BA\u5F97\u4E0D\u53EF\u601D\u8B70\uFF0C\n\u70BA\u4F55\u59B3\u77E5\u9053\n\u9019\u9EBC\u591A\u5929\u4E0A\u5730\u4E0B\u7684\u4E8B\u60C5\uFF0C\n\u539F\u4F86\u9019\u4E43\u662F\u5929\u4EBA\u4E4B\u8B58\uFF0C\n\u6211\u65E9\u8A72\u60F3\u5230\u7684\u3002\n\u4E0D\u904E\u9019\u9EBC\u8AAA\u4F86\uFF0C\n\u83AB\u975E\u524D\u8F29\u60A8\u4E5F\u662F...."
      - "\u55EF\uFF0C\u7576\u521D\u5979\u5C31\u662F\u56E0\u70BA\n\u5728\u738B\u6BCD\u5A18\u5A18\u9762\u524D\u66FF\u6211\u8FAF\u8B77\uFF0C\n\u624D\u4E00\u8D77\u88AB\u8CB6\u4E0B\u51E1\u5875\uFF0C\n\u7B97\u662F\u53D7\u4E86\u6211\u7684\u7121\u7AEF\u727D\u7D2F\u3002\n\u5982\u4ECA\u5979\u5F97\u80FD\u56DE\u8FD4\u5929\u5BAE\uFF0C\n\u6211\u7B97\u662F\u4E86\u4E86\u4E00\u6A01\u5FC3\u4E8B\uFF0C\n\u5C11\u4E86\u4E00\u6A01\u7F6A\u696D\uFF0C\n\u4E5F\u4E0D\u6789\u9019\u4E9B\u65E5\u5B50\n\u8F9B\u8F9B\u82E6\u82E6\u66FF\u4F60\u5011\u5230\u8655\u8DD1\u817F\u4E86\u3002"
      - "\u5982\u4ECA\u8AF8\u4E8B\u5DF2\u4E86\uFF0C\n\u6211\u4E5F\u5F97\u5949\u65E8\u56DE\u5BAE\u4E86\u3002\n\u6BB7\u516C\u5B50\uFF0C\u4E00\u8D77\u6B77\u96AA\u7684\u65E5\u5B50\uFF0C\n\u6211\u6703\u6C38\u9060\u8A18\u5728\u5FC3\u88CF\u3002\n\u5373\u4F7F\u4ECA\u5F8C\u54B1\u5011\n\u5206\u8655\u5929\u4E0A\u4EBA\u9593\uFF0C\n\u7E31\u7136\u4E0D\u80FD\u771F\u6B63\u805A\u9996\uFF0C\n\u4F46\u6642\u800C\u7FF9\u9996\u9059\u671B\u3001\n\u5728\u5FC3\u4E2D\u50B3\u601D\u5BC4\u5FF5\uFF0C\n\u6216\u53EF\u9748\u611F\u76F8\u901A\u4E5F\u8AAA\u4E0D\u5B9A\u3002"
      - "\u55EF\u3002\u524D\u8F29\uFF0C\u97D3\u59D1\u5A18\uFF0C\n\u90A3\u9EBC\u54B1\u5011\u9019\u5C31...\u5F8C\u6703\u6709\u671F\u4E86\u3002\n\u4ECA\u5F8C\u82E5\u6709\u9592\u6687\u4E4B\u6642\uFF0C\n\u9084\u8ACB\u5404\u4F4D\u4E0D\u5FD8\u5230\u5FD8\u528D\u5CF0\u4E00\u805A\u3002"
      - "\u55EF\uFF0C\u6B64\u4E8B\u6211\u6703\u8CA0\u8CAC\n\u8F49\u9054\u7D66\u5927\u5BB6\u7684\u3002\n\u6BB7\u5927\u54E5\uFF0C\u61C9\u59D1\u5A18\uFF0C\n\u54B1\u5011\u4E0B\u56DE\u898B\u3002"
      - "\u6BB7\u516C\u5B50\uFF0C\u8ACB\u591A\u4FDD\u91CD\u3002\n\u6211\u5011\u4E5F\u5C31\u6B64\u544A\u8FAD\u4E86\u3002"

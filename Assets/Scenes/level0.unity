      - "....\u76DF\u4E3B\uFF01\n\u60A8....\u60A8\u600E\u9EBD\u6765\u4E86\uFF1F"
      - "\u554A\uFF1F\uFF01\u97E9\u65E0\u7802\u4F60....\n\u4F60\u6CA1\u6B7B\uFF1F"
      - "\u54FC\uFF01\u8981\u771F\u662F\u8FD9\u6837\u8F7B\u6613\u5C31\u88AB\u51FB\u6BD9\uFF0C\n\u5982\u6B64\u5E9F\u7269\u8FD8\u914D\u5728\u6211\u624B\u4E0B\u505A\u4E8B\u9EBD\uFF1F\n\u4E0D\u8FC7\u4F60\u8FDE\u8FD9\u7B49\u5C0F\u4E8B\u90FD\u529E\u4E0D\u59A5\uFF0C\n\u672C\u5EA7\u8FD8\u7528\u5F97\u7740\u4F60\u5417\uFF1F"
      - "\u554A....\u76DF\u4E3B\uFF0C\u8D31\u59BE\u77E5\u9519\u3002\n\u8BF7\u76DF\u4E3B....\n\u9976\u4E86\u8D31\u59BE\u4E00\u547D......"
      - "\u54FC\uFF01\n\u4E0D\u8FC7\u96BE\u5F97\u4E09\u6D3E\u7684\u5154\u5D3D\u5B50\u7FA4\u96C6\u4E00\u5904\uFF0C\n\u6B63\u597D\u4E00\u7F51\u6253\u5C3D\uFF0C\n\u7701\u5F97\u672C\u5EA7\u56DB\u5904\u5954\u6CE2\uFF0C\n\u80FD\u6709\u8FD9\u7B49\u5343\u8F7D\u96BE\u9022\u7684\u826F\u673A\uFF0C\n\u7B97\u662F\u8BA9\u4F60\u5C06\u529F\u6298\u7F6A\u3002"
      - "\u8FD9\u5996\u4EBA....\u662F\u8FD9\u5996\u4EBA\u6740\u4E86\u5E08\u7236\n\u548C\u7D2B\u4E91\u6D3E\u5468\u5E08\u4F2F\uFF01\n\u54B1\u4EEC\u4E00\u8D77\u8054\u624B\uFF0C\u6740\u4E86\u4ED6\n\u4E3A\u5E08\u7236\u548C\u5468\u5E08\u4F2F\u62A5\u4EC7\uFF01\uFF01....."
      - "\u4F60\u4EEC\u7684\u5E08\u7236\u8EAB\u4E3A\u4E00\u6D3E\u4E4B\u638C\uFF0C\n\u5C1A\u4E14\u88AB\u4ED6\u4E00\u5251\u65A9\u6B7B\uFF0C\n\u4E24\u4EBA\u4FEE\u4E3A\u76F8\u6BD4\u6709\u5982\u4E91\u6CE5\u4E4B\u5DEE\u3002\n\u5E08\u7236\u90FD\u8FD9\u4E2A\u6837\u5B50\u4E86\uFF0C\n\u4F60\u4EEC\u8FD9\u4E9B\u5F92\u5B50\u5F92\u5B59\u6709\u4E2A\u5C41\u7528\uFF1F\n\u4E0D\u60F3\u6B7B\u7684\u8BDD\u5C31\u4E56\u4E56\u5F85\u5728\u539F\u5730\u7F62\u3002"
      - "\u53EF..\u53EF\u6076...."
      - "\u5728\u7AF9\u6797\u4E4B\u4E2D\uFF0C\n\u627F\u8499\u9601\u4E0B\u5251\u4E0B\u7559\u4EBA\uFF0C\n\u4E0D\u610F\u4ECA\u65E5\u53C8\u5728\u6B64\u5730\u76F8\u89C1\u3002\n\u9601\u4E0B\u8FD9\u56DE\u5149\u4E34\uFF0C\u4E0D\u77E5\u6709\u4F55\u6307\u6559\uFF1F"
      - "\u563F\u563F\uFF0C\u672C\u5EA7\u4ECA\u5929\n\u867D\u7136\u53EA\u662F\u6765\u6740\u8FD9\u4E9B\u5154\u5D3D\u5B50\uFF0C\n\u4E0D\u8FC7\u4EE4\u672C\u5EA7\u610F\u6599\u4E0D\u5230\u7684\u662F\uFF0C\n\u4ECA\u513F\u5374\u542C\u5230\u4E86\u4E00\u4EF6\n\u4E0E\u672C\u5EA7\u5927\u6709\u5173\u7CFB\u4E4B\u4E8B\uFF0C\n\u53EF\u5F97\u95EE\u4E2A\u6E05\u695A\u4E0D\u53EF\u3002\n\u5E08\u5144\uFF0C\u4F60\u8BF4\u662F\u4E0D\u662F\u554A\uFF1F"
      - "....\u606D\u79A7\u4F60\u7EC3\u6210\u4E86\n\u65E0\u4E0A\u98DE\u5251\u4E4B\u6CD5\u554A\uFF0C\n\u5E08\u5F1F\u3002"
      - "\u55C4\uFF01\uFF1F\n\u4F60....\u4F60\u662F\u5E94\u638C\u95E8\u7684\u5E08\u5F1F\uFF1F"
      - "\u5E08\u5144\uFF0C\u542C\u5468\u6D69\u548C\u6731\u5D07\n\u90A3\u4E24\u4E2A\u5E9F\u7269\u4E4B\u8A00\uFF0C\n\u773C\u524D\u8FD9\u5C11\u5E74\u662F\u672C\u5EA7\u7684\u513F\u5B50\uFF0C\n\u662F\u9EBD\uFF1F"
      - "........\u54FC\uFF0C\n\u5F53\u65E5\u4E00\u5FF5\u4E4B\u4EC1\uFF0C\n\u7559\u4E0B\u4E86\u8FD9\u4E2A\u7978\u6839...."
      - "\u54C8\u54C8\u54C8\uFF0C\u5E08\u5144\u4E0D\u7528\u5F3A\u4F5C\u6B64\u8A00\uFF0C\n\u4F60\u7684\u5FC3\u601D\u6211\u6E05\u695A\u5F97\u5F88\u3002\n\u5F53\u65E5\u4F60\u8054\u540C\u5916\u4EBA\u56F4\u6740\u6211\u592B\u5987\u4FE9\uFF0C\n\u60F3\u5FC5\u4E8B\u5F8C\u5FC3\u4E2D\u4E5F\u662F\u5341\u5206\u5185\u759A\uFF0C\n\u624D\u4F1A\u7559\u4E0B\u6211\u513F\u5B50\u4E00\u547D\u3002\n\u53EA\u53EF\u60DC\u5F53\u65E5\u6211\u91CD\u4F24\u5F8C\n\u5728\u5730\u754C\u9759\u517B\u4E86\u4E03\u5E74\uFF0C\n\u4E4B\u5F8C\u53C8\u5FD9\u65BC\u4E00\u7EDF\u5929\u5730\u4F17\u9B54\uFF0C\n\u65E0\u6687\u53BB\u7BA1\u5929\u7384\u95E8\u5185\u52A8\u9759\uFF0C\n\u4E0D\u7136\u6211\u7236\u5B50\u4FE9\n\u4E5F\u4E0D\u7528\u7B49\u5230\u4ECA\u65E5\u65B9\u624D\u89C1\u9762\u3002"
      - "\u5E08\u7236\uFF01\n\u4ED6..\u4ED6\u8BF4\u7684\u8FD9\u4E9B....\n\u90FD\u662F\u771F\u7684\uFF1F"
      - ..........

    EMSG:
    - MsgT:
      - "\u597D..\u597D\u5F37\uFF01\u6C92\u60F3\u5230\u5929\u5730\u9593\n\u9084\u6709\u9019\u9EBC\u5F37\u7684\u5996\u9B54...."
      - "\u563F\u563F\u563F\uFF0C\u7E3D\u7B97\u6253\u6557\u4F60\u5011\u5566\u3002\n\u4F9D\u7167\u5148\u524D\u7684\u7D04\u5B9A\uFF0C\u6211\u5011\u7D42\u65BC\n\u53EF\u4EE5\u5347\u683C\u70BA\u6B63\u5F0F\u4E3B\u89D2\uFF0C\n\u6F14\u54E1\u8CBB\u4E5F\u6703\u8DDF\u8457\u6C34\u6F32\u8239\u9AD8\uFF0C\n\u4E0D\u518D\u53EA\u662F\u62FF\u5169\u4F70\u584A\u4E86\u3002"
      - "\u53EF\u662F\u7DE8\u5C0E\u90A3\u908A\u597D\u50CF....\n\u9084\u6C92\u6709\u914D\u7D66\u6211\u5011\u7684CASE\u8036\u3002"
      - "\u90A3\u6709\u4EC0\u9EBC\u95DC\u4FC2\uFF1F\n\u6211\u5011\u5C31\u5BEB\u500B\u8173\u672C\u81EA\u7DE8\u81EA\u6F14\uFF0C\n\u4F8B\u5982\u300E\u5929\u5730\u52AB\u524D\u50B3\uFF1A\u5169\u4F70\u5927\u53CD\u64CA\u300F\n\u4E4B\u985E\u7684\u4E0D\u5C31\u597D\u4E86\uFF1F"
      - "\u9019\u7A2E\u984C\u6750\u6050\u6015\u6C92\u5E02\u5834\u5427...."
      - "\u4ECA\u5F8C\u662F\u6211\u5011\u5169\u4F70\u584A\u7684\u6642\u4EE3\uFF0C\n\u7531\u4E0D\u5F97\u4ED6\u5011\u4E0D\u770B\uFF01"
      - "\u554A\uFF0C\u9084\u662F\u807D\u4E0D\u61C2\n\u4ED6\u5011\u5728\u8AAA\u4EC0\u9EBC...."
      - 
      - 
      - 
      MsgS:
      - "\u597D..\u597D\u5F3A\uFF01\u6CA1\u60F3\u5230\u5929\u5730\u95F4\n\u8FD8\u6709\u8FD9\u9EBD\u5F3A\u7684\u5996\u9B54...."
      - "\u563F\u563F\u563F\uFF0C\u603B\u7B97\u6253\u8D25\u4F60\u4EEC\u5566\u3002\n\u4F9D\u7167\u5148\u524D\u7684\u7EA6\u5B9A\uFF0C\u6211\u4EEC\u7EC8\u65BC\n\u53EF\u4EE5\u5347\u683C\u4E3A\u6B63\u5F0F\u4E3B\u89D2\uFF0C\n\u6F14\u5458\u8D39\u4E5F\u4F1A\u8DDF\u7740\u6C34\u6DA8\u8239\u9AD8\uFF0C\n\u4E0D\u518D\u53EA\u662F\u62FF\u4E24\u4F70\u5757\u4E86\u3002"
      - "\u53EF\u662F\u7F16\u5BFC\u90A3\u8FB9\u597D\u50CF....\n\u8FD8\u6CA1\u6709\u914D\u7ED9\u6211\u4EEC\u7684CASE\u8036\u3002"
      - "\u90A3\u6709\u4EC0\u9EBD\u5173\u7CFB\uFF1F\n\u6211\u4EEC\u5C31\u5199\u4E2A\u811A\u672C\u81EA\u7F16\u81EA\u6F14\uFF0C\n\u4F8B\u5982\u300E\u5929\u5730\u52AB\u524D\u4F20\uFF1A\u4E24\u4F70\u5927\u53CD\u51FB\u300F\n\u4E4B\u7C7B\u7684\u4E0D\u5C31\u597D\u4E86\uFF1F"
      - "\u8FD9\u79CD\u9898\u6750\u6050\u6015\u6CA1\u5E02\u573A\u5427...."
      - "\u4ECA\u5F8C\u662F\u6211\u4EEC\u4E24\u4F70\u5757\u7684\u65F6\u4EE3\uFF0C\n\u7531\u4E0D\u5F97\u4ED6\u4EEC\u4E0D\u770B\uFF01"
      - "\u554A\uFF0C\u8FD8\u662F\u542C\u4E0D\u61C2\n\u4ED6\u4EEC\u5728\u8BF4\u4EC0\u9EBD...."
      - 
      - 
      - 
    - MsgT:
      - "\u563F\u563F\u563F\uFF0C\u9084\u6C92\u7D50\u675F\u5462\uFF0C"
      - "\u54A6\uFF0C\u54B1\u5011\u600E\u9EBC\u53C8\u4F86\u5230\u6230\u5834\u4E0A\u4E86\uFF1F\n\u9019\u500B\u904A\u6232\u61C9\u8A72\u5DF2\u7D93\u7D50\u675F\u4E86\u554A\uFF01"
      - "\u563F\u563F\u563F\uFF0C\u9084\u6C92\u7D50\u675F\u5462\uFF0C\n\u6B61\u8FCE\u4F60\u5011\u4F86\u5230\u5169\u4F70\u584A\u5E1D\u570B\u3002"
      - "\u54C7\u52D2....\n\u9019\u662F\u65B0\u7684\u5996\u9B54\u7A2E\u985E\u55CE\uFF1F"
      - "\u563F\u563F\u563F\uFF0C\u6211\u5011\u96D6\u7136\u4E0D\u662F\u5996\u9B54\uFF0C\n\u4F46\u6211\u5011\u7684\u6028\u5FF5\u6BD4\u5996\u9B54\u66F4\u53EF\u6015\uFF01\n\u4F60\u5011\u53EF\u77E5\u9053\u6211\u5011\u662F\u8AB0\u55CE\uFF1F"
      - "\u5728\u4E0B\u898B\u8B58\u6DFA\u8584\uFF0C\n\u9084\u671B\u95A3\u4E0B\u898B\u6559\u3002"
      - "\u6211\u5011\u5C31\u662F\u5728\u300E\u5929\u5730\u52AB\u300F\u4E2D\n\u5F9E\u982D\u5230\u5C3E\u64D4\u7DB1\u6F14\u51FA\u7684\u5169\u4F70\u584A\u7FA4\uFF01\n\u6211\u5011\u6D41\u8840\u6D41\u6DDA\uFF0C\u626E\u6F14\u5404\u7A2E\u602A\u7269\n\u88AB\u4F60\u5011\u780D\u3001\u6328\u4F60\u5011\u70B8\uFF0C\n\u6F14\u51FA\u5DE5\u8CC7\u537B\u53EA\u6709\u81E8\u6642\u6F14\u54E1\u7684\u5169\u4F70\u584A\uFF01"
      - "\uFF1F\uFF1F\uFF1F...."
      - "\u7136\u800C\uFF0C\u6211\u5011\u7FFB\u8EAB\u7684\u6A5F\u6703\u5230\u4E86\uFF01\n\u8001\u5C0E\u548C\u6211\u5011\u7D04\u5B9A\uFF0C\n\u53EA\u8981\u6211\u5011\u80FD\u6253\u5012\u4F60\u5011\uFF0C\n\u6211\u5011\u5C31\u6709\u6A5F\u6703\u5347\u683C\n\u626E\u6F14\u4F60\u5011\u9019\u985E\u7684\u4E3B\u89D2\u4EBA\u7269\uFF0C\n\u4E0D\u7528\u518D\u7A7F\u5E03\u5076\u626E\u591C\u9B51\u548C\u7F85\u9B3C\u4E86\uFF01\n\u6240\u4EE5\u6211\u5011\u6311\u9019\u500B\u5169\u4F70\u584A\u7684\u8056\u5730\uFF0C\n\u548C\u4F60\u5011\u4F86\u500B\u4E00\u6C7A\u6B7B\u6230\uFF0C\n\u770B\u5230\u5E95\u662F\u8AB0\u6BD4\u8F03\u53B2\u5BB3\uFF01"
      - "WHAT?....\n\u641E\u4E0D\u61C2\u9019\u4E9B\u50A2\u4F19\u5728\u8AAA\u4EC0\u9EBC\uFF1F"
      - "\u7BA1\u4ED6\u7684\uFF0C\u53CD\u6B63\u9019\u4E9B\u602A\u50A2\u4F19\n\u64FA\u660E\u4E86\u662F\u5728\u53EB\u9663\uFF0C\n\u65E2\u7136\u4ED6\u5011\u8981\u6253\uFF0C\n\u54B1\u5011\u5949\u966A\u5C31\u662F\u3002"
      - "\u9019\u8A71\u8AAA\u7684\u5F88\u5C0D\uFF01\n\u600E\u6A23\uFF0C\u54B1\u5011\u4F86\u6C7A\u4E00\u6B7B\u6230\u5427\uFF01"
      - "\u6575\u65B9\u96D6\u7136\u8C8C\u4E0D\u9A5A\u4EBA\uFF0C\n\u4F46\u5982\u6B64\u6709\u6043\u7121\u6050\uFF0C\n\u986F\u662F\u6709\u9A5A\u4EBA\u85DD\u696D\uFF0C\n\u5927\u5BB6\u5C0F\u5FC3\u61C9\u6230"
      MsgS:
      - "\u563F\u563F\u563F\uFF0C\u8FD8\u6CA1\u7ED3\u675F\u5462\uFF0C"
      - "\u54A6\uFF0C\u54B1\u4EEC\u600E\u9EBD\u53C8\u6765\u5230\u6218\u573A\u4E0A\u4E86\uFF1F\n\u8FD9\u4E2A\u6E38\u620F\u5E94\u8BE5\u5DF2\u7ECF\u7ED3\u675F\u4E86\u554A\uFF01"
      - "\u563F\u563F\u563F\uFF0C\u8FD8\u6CA1\u7ED3\u675F\u5462\uFF0C\n\u6B22\u8FCE\u4F60\u4EEC\u6765\u5230\u4E24\u4F70\u5757\u5E1D\u56FD\u3002"
      - "\u54C7\u52D2....\n\u8FD9\u662F\u65B0\u7684\u5996\u9B54\u79CD\u7C7B\u5417\uFF1F"
      - "\u563F\u563F\u563F\uFF0C\u6211\u4EEC\u867D\u7136\u4E0D\u662F\u5996\u9B54\uFF0C\n\u4F46\u6211\u4EEC\u7684\u6028\u5FF5\u6BD4\u5996\u9B54\u66F4\u53EF\u6015\uFF01\n\u4F60\u4EEC\u53EF\u77E5\u9053\u6211\u4EEC\u662F\u8C01\u5417\uFF1F"
      - "\u5728\u4E0B\u89C1\u8BC6\u6D45\u8584\uFF0C\n\u8FD8\u671B\u9601\u4E0B\u89C1\u6559\u3002"
      - "\u6211\u4EEC\u5C31\u662F\u5728\u300E\u5929\u5730\u52AB\u300F\u4E2D\n\u4ECE\u5934\u5230\u5C3E\u62C5\u7EB2\u6F14\u51FA\u7684\u4E24\u4F70\u5757\u7FA4\uFF01\n\u6211\u4EEC\u6D41\u8840\u6D41\u6CEA\uFF0C\u626E\u6F14\u5404\u79CD\u602A\u7269\n\u88AB\u4F60\u4EEC\u780D\u3001\u6328\u4F60\u4EEC\u70B8\uFF0C\n\u6F14\u51FA\u5DE5\u8D44\u5374\u53EA\u6709\u4E34\u65F6\u6F14\u5458\u7684\u4E24\u4F70\u5757\uFF01"
      - "\uFF1F\uFF1F\uFF1F...."
      - "\u7136\u800C\uFF0C\u6211\u4EEC\u7FFB\u8EAB\u7684\u673A\u4F1A\u5230\u4E86\uFF01\n\u8001\u5BFC\u548C\u6211\u4EEC\u7EA6\u5B9A\uFF0C\n\u53EA\u8981\u6211\u4EEC\u80FD\u6253\u5012\u4F60\u4EEC\uFF0C\n\u6211\u4EEC\u5C31\u6709\u673A\u4F1A\u5347\u683C\n\u626E\u6F14\u4F60\u4EEC\u8FD9\u7C7B\u7684\u4E3B\u89D2\u4EBA\u7269\uFF0C\n\u4E0D\u7528\u518D\u7A7F\u5E03\u5076\u626E\u591C\u9B51\u548C\u7F57\u9B3C\u4E86\uFF01\n\u6240\u4EE5\u6211\u4EEC\u6311\u8FD9\u4E2A\u4E24\u4F70\u5757\u7684\u5723\u5730\uFF0C\n\u548C\u4F60\u4EEC\u6765\u4E2A\u4E00\u51B3\u6B7B\u6218\uFF0C\n\u770B\u5230\u5E95\u662F\u8C01\u6BD4\u8F83\u5389\u5BB3\uFF01"
      - "WHAT?....\n\u641E\u4E0D\u61C2\u8FD9\u4E9B\u5BB6\u4F19\u5728\u8BF4\u4EC0\u9EBD\uFF1F"
      - "\u7BA1\u4ED6\u7684\uFF0C\u53CD\u6B63\u8FD9\u4E9B\u602A\u5BB6\u4F19\n\u6446\u660E\u4E86\u662F\u5728\u53EB\u9635\uFF0C\n\u65E2\u7136\u4ED6\u4EEC\u8981\u6253\uFF0C\n\u54B1\u4EEC\u5949\u966A\u5C31\u662F\u3002"
      - "\u8FD9\u8BDD\u8BF4\u7684\u5F88\u5BF9\uFF01\n\u600E\u6837\uFF0C\u54B1\u4EEC\u6765\u51B3\u4E00\u6B7B\u6218\u5427\uFF01"
      - "\u654C\u65B9\u867D\u7136\u8C8C\u4E0D\u60CA\u4EBA\uFF0C\n\u4F46\u5982\u6B64\u6709\u6043\u65E0\u6050\uFF0C\n\u663E\u662F\u6709\u60CA\u4EBA\u827A\u4E1A\uFF0C\n\u5927\u5BB6\u5C0F\u5FC3\u5E94\u6218"
    - MsgT:
      - "\u554A\uFF0C\u4E0D\u6127....\n\u4E0D\u6127\u662F\u4E3B\u89D2\u7D1A\u7684\u4EBA\u7269\uFF0C\n\u6211\u5011\u679C\u7136\u662F\u53EA\u6709\n\u5169\u4F70\u584A\u5DE5\u9322\u7684\u547D...."
      - "\u4E0D\u904E\u6211\u5011\u6703\u518D\u56DE\u4F86\u7684\uFF0C\n\u53EA\u8981\u9019\u7A2E\u904A\u6232\u5B58\u5728\u7684\u4E00\u5929....\n\u6211\u5011\u7684\u6028\u6068\u662F\u4E0D\u6703\u6D88\u89E3\u7684....\n\u597D\u597D\u8A18\u4F4F\u5427...."
      - "\u96D6\u7136\u9084\u662F\u641E\u4E0D\u61C2\n\u9019\u662F\u600E\u9EBC\u4E00\u56DE\u4E8B\uFF0C\n\u4F46\u6211\u5011\u597D\u50CF\u53C8\u8D0F\u4E86\u3002"
      - "\u597D\u5947\u602A\uFF0C\u6211\u89BA\u5F97\u9019\u4E00\u6230\n\u5012\u50CF\u662F\u5728\u8003\u9A57\u6211\u5011\u7684\u6230\u529B\u4E00\u822C\u3002"
      - "\u55EF\uFF0C\u8AAA\u4E0D\u5B9A\u662F\u90A3\u500B\u7DE8\u5C0E\n\u51FA\u7684\u993F\u4E3B\u610F\uFF0C\n\u96E3\u602A\u6211\u6536\u5230\u4E00\u7B46\u4E0D\u660E\u7684\u6F14\u51FA\u8CBB...\n\u56DE\u982D\u518D\u627E\u4ED6\u7B97\u5E33\u4FBF\u662F\u3002"
      - "\u55C4\uFF1F\u4EC0\u9EBC\u7DE8\u5C0E\uFF1F\u6F14\u51FA\u8CBB\uFF1F"
      - "\u554A\uFF0C\u6C92..\u6C92\u4EC0\u9EBC\u3002\n\u7E3D\u800C\u8A00\u4E4B\uFF0C\u5927\u5BB6\u8F9B\u82E6\u4E86\uFF0C\n\u5F85\u6703\u6211\u8ACB\u5927\u5BB6\u53BB\n\u590F\u4FAF\u5144\u6253\u5DE5\u7684\u5564\u9152\u5C4B\u559D\u500B\u75DB\u5FEB\uFF0C\n\u807D\u8AAA\u590F\u4FAF\u5144\u53EF\u662F\u90A3\u5152\u7684\u7D05\u724C\uFF0C\n\u5927\u5BB6\u6392\u968A\u9810\u7D04\u7684\u5537\uFF01\n\u5230\u6642\u8981\u5403\u4EC0\u9EBC\u5927\u5BB6\u76E1\u91CF\u9EDE.....\n\u590F\u4FAF\u5144\u6703\u6253\u500B\u6298\u5427\uFF1F"
      - "\u90A3\u9084\u6709\u4EC0\u9EBC\u554F\u984C\uFF0C\n\u53EA\u662F\u6211\u5230\u6642\u53EF\u6C92\u7A7A\u966A\u4F60\u5011......"
      - "\u559D\u9152\uFF1F\u554A\u54C8\uFF0C\n\u6C92\u554F\u984C\uFF0C\u6C92\u554F\u984C\uFF01\n\u6211\u53EF\u7D55\u5C0D\u8981\u5805\u6301\u301D\u5C1A\u9752\u301E\u7684\u5537\uFF01"
      - "\u7D2B\u6953\u59D0\u771F\u7684\u8981\u8ACB\u5BA2\uFF1F\n\u90A3\u6211\u8981\u5927\u584A\u6C99\u6717\u54E6\uFF01"
      - "\u5509\uFF0C\u4EBA\u5BB6\u9084\u5728\u6E1B\u80A5....\n\u6700\u8FD1\u771F\u662F\u6C92\u6709\u53E3\u798F...."
      - "....\uFF1F\uFF1F\uFF1F\uFF1F\uFF1F"
      - "\u6BB7\u5927\u54E5\uFF0C\u4F60\u6775\u5728\u90A3\u5152\u5E79\u561B\uFF1F\n\u8D70\u4E86\u5566\uFF01\u767C\u4EC0\u9EBC\u5446\u5440\uFF01"
      MsgS:
      - "\u554A\uFF0C\u4E0D\u6127....\n\u4E0D\u6127\u662F\u4E3B\u89D2\u7EA7\u7684\u4EBA\u7269\uFF0C\n\u6211\u4EEC\u679C\u7136\u662F\u53EA\u6709\n\u4E24\u4F70\u5757\u5DE5\u94B1\u7684\u547D...."
      - "\u4E0D\u8FC7\u6211\u4EEC\u4F1A\u518D\u56DE\u6765\u7684\uFF0C\n\u53EA\u8981\u8FD9\u79CD\u6E38\u620F\u5B58\u5728\u7684\u4E00\u5929....\n\u6211\u4EEC\u7684\u6028\u6068\u662F\u4E0D\u4F1A\u6D88\u89E3\u7684....\n\u597D\u597D\u8BB0\u4F4F\u5427...."
      - "\u867D\u7136\u8FD8\u662F\u641E\u4E0D\u61C2\n\u8FD9\u662F\u600E\u9EBD\u4E00\u56DE\u4E8B\uFF0C\n\u4F46\u6211\u4EEC\u597D\u50CF\u53C8\u8D62\u4E86\u3002"
      - "\u597D\u5947\u602A\uFF0C\u6211\u89C9\u5F97\u8FD9\u4E00\u6218\n\u5012\u50CF\u662F\u5728\u8003\u9A8C\u6211\u4EEC\u7684\u6218\u529B\u4E00\u822C\u3002"
      - "\u55EF\uFF0C\u8BF4\u4E0D\u5B9A\u662F\u90A3\u4E2A\u7F16\u5BFC\n\u51FA\u7684\u998A\u4E3B\u610F\uFF0C\n\u96BE\u602A\u6211\u6536\u5230\u4E00\u7B14\u4E0D\u660E\u7684\u6F14\u51FA\u8D39...\n\u56DE\u5934\u518D\u627E\u4ED6\u7B97\u5E10\u4FBF\u662F\u3002"
      - "\u55C4\uFF1F\u4EC0\u9EBD\u7F16\u5BFC\uFF1F\u6F14\u51FA\u8D39\uFF1F"
      - "\u554A\uFF0C\u6CA1..\u6CA1\u4EC0\u9EBD\u3002\n\u603B\u800C\u8A00\u4E4B\uFF0C\u5927\u5BB6\u8F9B\u82E6\u4E86\uFF0C\n\u5F85\u4F1A\u6211\u8BF7\u5927\u5BB6\u53BB\n\u590F\u4FAF\u5144\u6253\u5DE5\u7684\u5564\u9152\u5C4B\u559D\u4E2A\u75DB\u5FEB\uFF0C\n\u542C\u8BF4\u590F\u4FAF\u5144\u53EF\u662F\u90A3\u513F\u7684\u7EA2\u724C\uFF0C\n\u5927\u5BB6\u6392\u961F\u9884\u7EA6\u7684\u5537\uFF01\n\u5230\u65F6\u8981\u5403\u4EC0\u9EBD\u5927\u5BB6\u5C3D\u91CF\u70B9.....\n\u590F\u4FAF\u5144\u4F1A\u6253\u4E2A\u6298\u5427\uFF1F"
      - "\u90A3\u8FD8\u6709\u4EC0\u9EBD\u95EE\u9898\uFF0C\n\u53EA\u662F\u6211\u5230\u65F6\u53EF\u6CA1\u7A7A\u966A\u4F60\u4EEC......"
      - "\u559D\u9152\uFF1F\u554A\u54C8\uFF0C\n\u6CA1\u95EE\u9898\uFF0C\u6CA1\u95EE\u9898\uFF01\n\u6211\u53EF\u7EDD\u5BF9\u8981\u575A\u6301\u301D\u5C1A\u9752\u301E\u7684\u5537\uFF01"
      - "\u7D2B\u67AB\u59D0\u771F\u7684\u8981\u8BF7\u5BA2\uFF1F\n\u90A3\u6211\u8981\u5927\u5757\u6C99\u6717\u54E6\uFF01"
      - "\u5509\uFF0C\u4EBA\u5BB6\u8FD8\u5728\u51CF\u80A5....\n\u6700\u8FD1\u771F\u662F\u6CA1\u6709\u53E3\u798F...."
      - "....\uFF1F\uFF1F\uFF1F\uFF1F\uFF1F"
      - "\u6BB7\u5927\u54E5\uFF0C\u4F60\u6775\u5728\u90A3\u513F\u5E72\u561B\uFF1F\n\u8D70\u4E86\u5566\uFF01\u53D1\u4EC0\u9EBD\u5446\u5440\uFF01"
    - MsgT:
      - "\u563F\u563F\u563F\uFF0C\u4E0D\u6127\u662F\u4E3B\u89D2\u7D1A\u7684\u4EBA\u7269\uFF0C\n\u4E0D\u904E\u5225\u9AD8\u8208\u5F97\u592A\u65E9\uFF0C\n\u4E8B\u60C5\u53EF\u9084\u6C92\u6709\u7D50\u675F....\u51FA\u4F86\u5427\uFF01\n\u6211\u5011\u5169\u4F70\u4E00\u65CF\u5149\u69AE\u7684\u5148\u7956\uFF01\uFF01\uFF01\n....\u5B8C\u6210\u6211\u5011\u7684\u907A\u5FD7\u54C0\u9858\u5427\uFF01"
      - "\u54A6\uFF1F\u9023\u6211\u5011\u9019\u4E9B\u5F92\u5B50\u5F92\u5B6B\n\u90FD\u5C0D\u4ED8\u4E0D\u4E86\u7684\uFF0C\n\u5C31\u662F\u4F60\u5011\u55CE\uFF1F"
      - "\u5225\u5C0F\u770B\u4ED6\u5011\uFF0C\u9019\u4E9B\u50A2\u4F19\n\u662F\u300E\u5929\u5730\u52AB\u300F\u7684\u4E3B\u89D2\u4EBA\u7269\uFF0C\n\u800C\u4E14\u9084\u662F\u5B8C\u6210\u4E86\u771F\u6B63\u7D50\u5C40\u7684\uFF0C\n\u4E5F\u96E3\u602A\u4ED6\u5011\u9019\u9EBC\u96E3\u5C0D\u4ED8\u3002"
      - "\u554A\uFF0C\u662F\u300E\u5929\u5730\u52AB\u300F\u7684\uFF1F\n\u6211\u9084\u4EE5\u70BA\u662F\u300E\u75BE\u98A8\u5C11\u5E74\u968A\u300F\u7684....\n\u6700\u8FD1\u8981\u81E8\u6642\u6F14\u54E1\u7684CASE\u5F88\u591A\uFF0C\n\u6211\u90FD\u641E\u6DF7\u4E86\u3002\n\u554A\uFF0C\u7BA1\u4ED6\u7684\uFF0C\u53CD\u6B63\u6253\u4E86\u5C31\u662F\u3002"
      - "\u8AAA\u7684\u4E5F\u662F\uFF0C\u5148\u6253\u4E86\u518D\u8AAA\u3002\n\u54B1\u5011\u4E0A\uFF01"
      - 
      - 
      - 
      - 
      - 
      MsgS:
      - "\u563F\u563F\u563F\uFF0C\u4E0D\u6127\u662F\u4E3B\u89D2\u7EA7\u7684\u4EBA\u7269\uFF0C\n\u4E0D\u8FC7\u522B\u9AD8\u5174\u5F97\u592A\u65E9\uFF0C\n\u4E8B\u60C5\u53EF\u8FD8\u6CA1\u6709\u7ED3\u675F....\u51FA\u6765\u5427\uFF01\n\u6211\u4EEC\u4E24\u4F70\u4E00\u65CF\u5149\u8363\u7684\u5148\u7956\uFF01\uFF01\uFF01\n....\u5B8C\u6210\u6211\u4EEC\u7684\u9057\u5FD7\u54C0\u613F\u5427\uFF01"
      - "\u54A6\uFF1F\u8FDE\u6211\u4EEC\u8FD9\u4E9B\u5F92\u5B50\u5F92\u5B59\n\u90FD\u5BF9\u4ED8\u4E0D\u4E86\u7684\uFF0C\n\u5C31\u662F\u4F60\u4EEC\u5417\uFF1F"
      - "\u522B\u5C0F\u770B\u4ED6\u4EEC\uFF0C\u8FD9\u4E9B\u5BB6\u4F19\n\u662F\u300E\u5929\u5730\u52AB\u300F\u7684\u4E3B\u89D2\u4EBA\u7269\uFF0C\n\u800C\u4E14\u8FD8\u662F\u5B8C\u6210\u4E86\u771F\u6B63\u7ED3\u5C40\u7684\uFF0C\n\u4E5F\u96BE\u602A\u4ED6\u4EEC\u8FD9\u9EBD\u96BE\u5BF9\u4ED8\u3002"
      - "\u554A\uFF0C\u662F\u300E\u5929\u5730\u52AB\u300F\u7684\uFF1F\n\u6211\u8FD8\u4EE5\u4E3A\u662F\u300E\u75BE\u98CE\u5C11\u5E74\u961F\u300F\u7684....\n\u6700\u8FD1\u8981\u4E34\u65F6\u6F14\u5458\u7684CASE\u5F88\u591A\uFF0C\n\u6211\u90FD\u641E\u6DF7\u4E86\u3002\n\u554A\uFF0C\u7BA1\u4ED6\u7684\uFF0C\u53CD\u6B63\u6253\u4E86\u5C31\u662F\u3002"
      - "\u8BF4\u7684\u4E5F\u662F\uFF0C\u5148\u6253\u4E86\u518D\u8BF4\u3002\n\u54B1\u4EEC\u4E0A\uFF01"

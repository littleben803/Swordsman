    - MsgT:
      - "\u6211\u7684\u540C\u4F34\u5DF2\u7D93\u53BB\u8ACB\u6C42\u652F\u63F4\u4E86\uFF0C\n\u5949\u52F8\u4F60\u5011\u5FEB\u6295\u964D\u5427\uFF0C\n\u5426\u5247\u5C07\u6703\u5C4D\u9AA8\u7121\u5B58\u7684\uFF01"
      - "\u65BD\u4E3B\u6B64\u8A00\u672A\u514D\u592A\u904E\u679C\u65B7\u4E86\uFF1F"
      - "\u5C0D\u554A\uFF01\n\u5973\u5A03\u5152\u4E0D\u77E5\u9053\u4FFA\u7684\u5229\u5BB3\n\u624D\u6562\u9019\u6A23\u8B1B\u7684\uFF01"
      - ' . . . . . . .'
      MsgS:
      - "\u6211\u7684\u540C\u4F34\u5DF2\u7ECF\u53BB\u8BF7\u6C42\u652F\u63F4\u4E86\uFF0C\n\u5949\u529D\u4F60\u4EEC\u5FEB\u6295\u964D\u5427\uFF0C\n\u5426\u5219\u5C06\u4F1A\u5C4D\u9AA8\u65E0\u5B58\u7684\uFF01"
      - "\u65BD\u4E3B\u6B64\u8A00\u672A\u514D\u592A\u8FC7\u679C\u65AD\u4E86\uFF1F"
      - "\u5BF9\u554A\uFF01\n\u5973\u5A03\u513F\u4E0D\u77E5\u9053\u4FFA\u7684\u5229\u5BB3\n\u624D\u6562\u8FD9\u6837\u8BB2\u7684\uFF01"
      - ' . . . . . . .'
    - MsgT:
      - "\u5949\u9580\u4E3B\u4E4B\u4EE4\uFF0C\n\u524D\u4F86\u6349\u62FF\u53DB\u5F92\u5C01\u5BD2\u6708\uFF01"
      - "\u6211 . . .\u6211\u6C92\u6709 . . ."
      - "\u5C01\u59D1\u5A18, \u5225\u96E3\u904E . . .\n\u4E00\u5207\u7B49\u6211\u5011\u4E0A\u5C71\u898B\u904E\u9580\u4E3B\n\u9748\u5C71\u8001\u4EBA\u524D\u8F29\u518D\u8AAA
        . . ."
      - ". . . \u55EF. . ."
      - "\u54FC\uFF0C\u4F60\u5011\u9084\u60F3\u5E73\u5B89\u7684\u4E0A\u5C71\u55CE\uFF1F"
      - "\u54C8\uFF01\u54C8\uFF01\u54C8\uFF01\n\u5973\u5A03\u5152\u5225\u901E\u53E3\u820C\u4E4B\u5229\uFF0C\n\u80FD\u4E0D\u80FD\u4E0A\u5C71\u6211\u5011\u624B\u4E0A\u898B\u771F\u7AE0\u3002"
      - ' . . . . . . .'
      MsgS:
      - "\u5949\u95E8\u4E3B\u4E4B\u4EE4\uFF0C\n\u524D\u6765\u6349\u62FF\u53DB\u5F92\u5C01\u5BD2\u6708\uFF01"
      - "\u6211 . . .\u6211\u6CA1\u6709 . . ."
      - "\u5C01\u59D1\u5A18, \u522B\u96BE\u8FC7 . . .\n\u4E00\u5207\u7B49\u6211\u4EEC\u4E0A\u5C71\u89C1\u8FC7\u95E8\u4E3B\n\u7075\u5C71\u8001\u4EBA\u524D\u8F88\u518D\u8BF4
        . . ."
      - ". . . \u55EF. . ."
      - "\u54FC\uFF0C\u4F60\u4EEC\u8FD8\u60F3\u5E73\u5B89\u7684\u4E0A\u5C71\u5417\uFF1F"
      - "\u54C8\uFF01\u54C8\uFF01\u54C8\uFF01\n\u5973\u5A03\u513F\u522B\u901E\u53E3\u820C\u4E4B\u5229\uFF0C\n\u80FD\u4E0D\u80FD\u4E0A\u5C71\u6211\u4EEC\u624B\u4E0A\u89C1\u771F\u7AE0\u3002"
      - ' . . . . . . .'
    - MsgT:
      - "\u54E5\uFF0C\u5C0D\u4E0D\u8D77\uFF0C\u59B9\u5B50....\n\u6C92\u8FA6\u6CD5\u5E6B\u4F60\u4E86....\n\u60F3\u4E0D\u5230\u6211\u7ADF\u7136\u8F38\u4E86.
